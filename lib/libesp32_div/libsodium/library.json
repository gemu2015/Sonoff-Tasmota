{
  "name":"ESP32-libsodium",
  "version": "1.0.0",
  "description":"sodium ESP32 - minimal build for HomeKit",
  "keywords":"sodium",
  "repository": {
    "type": "git",
    "url": ""
  },
  "frameworks": "arduino",
  "platforms": "espressif32",
  "build": {
    "flags": [
      "-I$PROJECT_DIR/lib/libesp32_div/libsodium/src/libsodium/include/sodium"
    ],
    "srcDir": "src/libsodium",
    "srcFilter": [
      "-<*>",
      "+<crypto_sign/ed25519/ref10/>",
      "+<crypto_hash/sha512/>",
      "+<crypto_scalarmult/curve25519/scalarmult_curve25519.c>",
      "+<crypto_scalarmult/curve25519/ref10/>",
      "+<crypto_aead/chacha20poly1305/>",
      "+<crypto_stream/chacha20/stream_chacha20.c>",
      "+<crypto_stream/chacha20/ref/>",
      "+<crypto_onetimeauth/poly1305/onetimeauth_poly1305.c>",
      "+<crypto_onetimeauth/poly1305/donna/>",
      "+<crypto_core/ed25519/ref10/>",
      "+<crypto_verify/>",
      "+<randombytes/randombytes.c>",
      "+<randombytes/sysrandom/>",
      "+<sodium/utils.c>",
      "+<sodium/runtime.c>",
      "+<sodium/core.c>"
    ]
  }
}
