>w1 Verlauf letzte Woche
%=#caltab
$<body style="background-color:black;">
$<br><center><input type= 'button' onclick='javascript:history.back();return false;' value='Hauptmenü'><br><br>
$<div id='chart1'%hs8%
$gc(ct wt_hv wt_wb wt_sin1 wt_sin2 wt_sin3 wt_sin4 wt_wp "Tag" "Netz" "Wallbox" "Garage" "G-Haus" "Garten" "Dach" "WP" "&So|Mo|Di|Mi|Do|Fr|Sa" "")
$var options={
$vAxis:{title:'kWh',viewWindow:{min:0,max:35}},
$hAxis:{title:'Woche'},
$title:'Energiebilanz über letze 7 Tage',
%hs6%
%hs7%
$gc(e)

$<div id='chart2'%hs8%
$gc(lt w_pwl w_swa w_at w_sk "wr" "Powerwall" "Solarspeicher"  "Außentemperatur" "Kollektortemperatur" "&wdh:So|Mo|Di|Mi|Do|Fr|Sa" "" 100 60)
$var options={
$series: {0:{targetAxisIndex:0},1:{targetAxisIndex:1},2:{targetAxisIndex:1},3:{targetAxisIndex:1}},
$vAxes: {0:{title:'Ladung %%',viewWindow:{min:0,max:100}},1:{title:'Grad ℃',viewWindow:{min:0,max:60}}} ,
$hAxis: {title:'Woche'},
$title:'Powerwall, Solarwärme - über letze 7 Tage',
%hs6%
%hs7%
$gc(e)

$<div id='chart3'%hs8%
$gc(lt w_hv w_sin w_wr1 w_wr2 w_wr3 w_wr4 "wr" "Netz" "Solar Input" "Garage" "GHaus" "Garten" "Dach" "&wdh:So|Mo|Di|Mi|Do|Fr|Sa" "" 100 60)
$var options={
;$series: {0:{targetAxisIndex:0},1:{targetAxisIndex:1}},
$vAxis:{title:'W',viewWindow:{min:0,max:8000}},
;$vAxes: {0:{title:'Ladung %%',viewWindow:{min:0,max:5000}},1:{title:'Grad C',viewWindow:{min:0,max:5000}}} ,
$hAxis: {title:'Woche'},
$title:'Netzverbrauch, Solarertrag - über letze 7 Tage',
%hs6%
%hs7%
$gc(e)

$<div id='chart4'%hs8%
$gc(lt w_gas w_wa "wr" "Gas" "Wasser" "&wdh:So|Mo|Di|Mi|Do|Fr|Sa" "" 100 60)
$var options={
$vAxis:{title:'㎥',viewWindow:{min:0,max:0.3}},
$hAxis: {title:'Woche'},
$title:'Gas, Wasser - über letze 7 Tage',
%hs6%
%hs7%
$gc(e)

$<div id='chart5'%hs8%
$gc(t wt_hv wt_wb wt_sin1 wt_sin2 wt_sin3 wt_sin4 wt_gas wt_pgas wt_wa wt_wp "Tag"  "Haus" "Wallbox" "Garage" gh "Garten" "Dach" "Gas" "Gas €" "Wasser" "WP" "&So|Mo|Di|Mi|Do|Fr|Sa" eb)

