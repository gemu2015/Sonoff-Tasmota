>D 100
IP=192.168.188.141

rxpin=0
txpin=3
p:rxind=2
p:txind=4
p:sel=0

>B
rxpin=rxind-1
txpin=txind-1
->sensor53 r

>S
if year<2025 {
	break
}

if chg[rxind]>0 {
	rxpin=rxind-1
	=>sensor53 r
	svars
}
if chg[txind]>0 {
	txpin=txind-1
	=>sensor53 r
	svars
} 

>C
if eres==1 {
	=>sensor53 r
	svars
	eres=0
}

>WS
time{m}%upsecs%
selected{m}%sel%

>WM
so(17)
smlpd("https://raw.githubusercontent.com/ottelo9/tasmota-sml-script/main/smartmeter_test" "select a meter" sel)
pd(rxind "RX Pin: " 50 "#0-30")
pd(txind "TX Pin: " 50 "#0-30")
; im descriptor pin substuieren
; %0rxpin% bzw %0txpin%
