// cfg.tc - read and validate key=value configuration files (.cfg / .secret), pure TinyC, no firmware change.
//
// Why (mi-hol, discussion #139): every program that reads a settings file (FTP login, host, folder, ...) parses it by hand
// and gets the corner cases wrong. This is the one parser, with the checks done by the program, not by the file.
//
// File format (e.g. /ftp.cfg, passwords in /ftp.secret - see "Protected Files" in the reference):
//     // a comment line (// at the very start)
//     HOST[IP4]=192.168.178.1          key, optional [TYPE] label right after it, '=', value
//     USER=logger
//     DIR="/my folder/backup"          a value with blanks is in double quotes; "" inside quotes is one quote
// - The key starts in column 0 (a line that starts with a blank and has more text is an error; blank-only lines are ok).
// - Keys are compared without case for ASCII letters ("Host" = "HOST"); other UTF-8 letters are compared byte by byte.
// - The file may be of any size (read in blocks). One line is at most 255 characters. Every line must be valid UTF-8.
// - The WHOLE file is checked on every call: a broken line anywhere is an error, even if it is not the key you asked for.
// - If a key is there twice, the first one counts.
//
// Use:
//   #include "cfg.tc"
//   char host[32];
//   int r = cfgGetT("/ftp.cfg", "HOST", "IP4", host, 32);     // the PROGRAM says what HOST has to be
//   if (r != 0) { char m[64]; cfgErrText(r, m); addLog(m); }  // r < 0: see CFG_E_*, cfgErrLine() = line of the error
//   cfgGet("/ftp.cfg", "NOTE", note, 64);                      // no type check
//
// About the [TYPE] label in the file: the type the PROGRAM names is what counts (so a file cannot switch the check off by
// leaving the label out). A label that differs from the program's type is an error (CFG_E_LABEL). If the program names no
// type, the label is used (a file can make the check stricter, never weaker). Types so far: IP4, FTP-DIR.

#define CFG_OK        0
#define CFG_E_NOFILE  -1   // the file cannot be opened
#define CFG_E_LONG    -2   // a line is longer than 255 characters
#define CFG_E_QUOTE   -3   // opening quote without a closing one, text after the closing quote, quote inside an unquoted value
#define CFG_E_NOKEY   -4   // the key is not in the file
#define CFG_E_TYPE    -5   // the value does not fit the type
#define CFG_E_LABEL   -6   // the [TYPE] label in the file differs from the type the program asked for
#define CFG_E_SYNTAX  -7   // no '=', empty or too long key, blank at the start of a text line, blank inside an unquoted value
#define CFG_E_BUF     -8   // the value does not fit the destination array
#define CFG_E_UNKNOWN -9   // unknown type name
#define CFG_E_UTF8    -10  // a line is not valid UTF-8
#define CFG_LINE      255  // longest line

int  cfg_errline = 0;      // line number (1 = first) of the last error, 0 = the error belongs to no line
int  cfg_found   = 0;
char cfg_line[256];        // the line being parsed
char cfg_k[64];            // its key, lower case
char cfg_lab[16];          // its [TYPE] label, upper case, "" = none
char cfg_v[256];           // its value, quotes removed
char cfg_wk[64];           // wanted key, lower case
char cfg_wt[16];           // wanted type, upper case

int cfgErrLine() { return cfg_errline; }

void cfgErrText(int code, char out[]) {
    if (code == CFG_OK)             { strcpy(out, "ok"); }
    else if (code == CFG_E_NOFILE)  { strcpy(out, "file not found"); }
    else if (code == CFG_E_LONG)    { strcpy(out, "line longer than 255 characters"); }
    else if (code == CFG_E_QUOTE)   { strcpy(out, "quote error"); }
    else if (code == CFG_E_NOKEY)   { strcpy(out, "key not found"); }
    else if (code == CFG_E_TYPE)    { strcpy(out, "value does not fit the type"); }
    else if (code == CFG_E_LABEL)   { strcpy(out, "type label differs from the program"); }
    else if (code == CFG_E_SYNTAX)  { strcpy(out, "syntax error"); }
    else if (code == CFG_E_BUF)     { strcpy(out, "value too long for the buffer"); }
    else if (code == CFG_E_UNKNOWN) { strcpy(out, "unknown type"); }
    else if (code == CFG_E_UTF8)    { strcpy(out, "not valid UTF-8"); }
    else                            { strcpy(out, "error"); }
    if (cfg_errline > 0) { sprintfAppend(out, " (line %d)", cfg_errline); }
}

// 1 = valid UTF-8 (RFC 3629: no overlong forms, no surrogates, nothing above U+10FFFF)
int cfg_utf8(char s[]) {
    int n = strlen(s);
    int i = 0;
    int c = 0;
    int need = 0;
    int lo = 0;
    int hi = 0;
    int j = 0;
    int d = 0;
    while (i < n) {
        c = s[i] & 255;
        if (c < 128) {
            i = i + 1;
        } else {
            need = 0;
            lo = 128;
            hi = 191;
            if (c >= 194 && c <= 223) {
                need = 1;
            } else if (c >= 224 && c <= 239) {
                need = 2;
                if (c == 224) { lo = 160; }
                if (c == 237) { hi = 159; }
            } else if (c >= 240 && c <= 244) {
                need = 3;
                if (c == 240) { lo = 144; }
                if (c == 244) { hi = 143; }
            } else {
                return 0;
            }
            if (i + need > n - 1) { return 0; }
            d = s[i + 1] & 255;
            if (d < lo || d > hi) { return 0; }
            j = 2;
            while (j <= need) {
                d = s[i + j] & 255;
                if (d < 128 || d > 191) { return 0; }
                j = j + 1;
            }
            i = i + need + 1;
        }
    }
    return 1;
}

// IPv4: exactly 4 numbers 0..255 separated by 3 dots, digits and dots only, no leading zeros, 7..15 characters
int cfg_ip4(char v[]) {
    int n = strlen(v);
    int dots = 0;
    int digits = 0;
    int val = 0;
    int first = 0;
    int i = 0;
    int c = 0;
    if (n < 7 || n > 15) { return 0; }
    while (i < n) {
        c = v[i] & 255;
        if (c == '.') {
            if (digits == 0) { return 0; }
            dots = dots + 1;
            if (dots > 3) { return 0; }
            digits = 0;
            val = 0;
        } else if (c >= '0' && c <= '9') {
            if (digits == 0) {
                first = c;
            } else if (first == '0') {
                return 0;
            }
            digits = digits + 1;
            val = val * 10 + (c - '0');
            if (digits > 3 || val > 255) { return 0; }
        } else {
            return 0;
        }
        i = i + 1;
    }
    if (dots != 3 || digits == 0) { return 0; }
    return 1;
}

// FTP directory (RFC 2640, section 3): valid UTF-8, no control characters, 1..200 bytes
int cfg_ftpdir(char v[]) {
    int n = strlen(v);
    int i = 0;
    int c = 0;
    if (n < 1 || n > 200) { return 0; }
    while (i < n) {
        c = v[i] & 255;
        if (c < 32 || c == 127) { return 0; }
        i = i + 1;
    }
    return cfg_utf8(v);
}

// 1 = value fits the type, 0 = it does not, -1 = unknown type (t is upper case)
int cfg_check(char t[], char v[]) {
    if (strcmp(t, "IP4") == 0)     { return cfg_ip4(v); }
    if (strcmp(t, "FTP-DIR") == 0) { return cfg_ftpdir(v); }
    return -1;
}

// Parse cfg_line into cfg_k / cfg_lab / cfg_v. 0 = nothing (empty or comment), 1 = key=value, < 0 = error
int cfg_parse() {
    int n = strlen(cfg_line);
    int i = 0;
    int k = 0;
    int l = 0;
    int v = 0;
    int c = 0;
    int e = 0;
    int closed = 0;
    cfg_lab[0] = 0;
    if (n == 0) { return 0; }
    while (i < n && (cfg_line[i] == ' ' || cfg_line[i] == '\t')) { i = i + 1; }
    if (i == n) { return 0; }                          // blanks only = empty line
    if (i > 0) { return CFG_E_SYNTAX; }                // the key starts in column 0
    if (cfg_line[0] == '/' && cfg_line[1] == '/') { return 0; }
    // key
    while (i < n) {
        c = cfg_line[i] & 255;
        if (c == '=' || c == '[') { break; }
        if (c <= 32 || c == 127 || c == '"' || c == ']') { return CFG_E_SYNTAX; }
        if (k >= 63) { return CFG_E_SYNTAX; }
        cfg_k[k] = c;
        k = k + 1;
        i = i + 1;
    }
    cfg_k[k] = 0;
    if (k == 0 || i >= n) { return CFG_E_SYNTAX; }     // empty key, or no '='
    strToLower(cfg_k);
    // optional [TYPE] directly after the key
    if (cfg_line[i] == '[') {
        i = i + 1;
        while (i < n && cfg_line[i] != ']') {
            c = cfg_line[i] & 255;
            if (!((c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') || (c >= '0' && c <= '9') || c == '-' || c == '_')) { return CFG_E_SYNTAX; }
            if (l >= 15) { return CFG_E_SYNTAX; }
            cfg_lab[l] = c;
            l = l + 1;
            i = i + 1;
        }
        if (i >= n || l == 0) { return CFG_E_SYNTAX; }
        cfg_lab[l] = 0;
        strToUpper(cfg_lab);
        i = i + 1;                                     // after ']'
        if (i >= n || cfg_line[i] != '=') { return CFG_E_SYNTAX; }
    }
    i = i + 1;                                         // after '='
    // value
    if (i < n && cfg_line[i] == '"') {
        i = i + 1;
        while (i < n && closed == 0) {
            c = cfg_line[i] & 255;
            if (c == '"') {
                if (i + 1 < n && cfg_line[i + 1] == '"') {
                    cfg_v[v] = '"';
                    v = v + 1;
                    i = i + 2;
                } else {
                    closed = 1;
                    i = i + 1;
                }
            } else {
                cfg_v[v] = c;
                v = v + 1;
                i = i + 1;
            }
        }
        if (closed == 0) { return CFG_E_QUOTE; }
        while (i < n) {                                // only blanks may follow the closing quote
            if (cfg_line[i] != ' ' && cfg_line[i] != '\t') { return CFG_E_QUOTE; }
            i = i + 1;
        }
    } else {
        e = n;
        while (e > i && (cfg_line[e - 1] == ' ' || cfg_line[e - 1] == '\t')) { e = e - 1; }
        while (i < e) {
            c = cfg_line[i] & 255;
            if (c == '"') { return CFG_E_QUOTE; }
            if (c == ' ' || c == '\t') { return CFG_E_SYNTAX; }
            cfg_v[v] = c;
            v = v + 1;
            i = i + 1;
        }
    }
    cfg_v[v] = 0;
    return 1;
}

// One complete line is in cfg_line. 0 = ok, < 0 = error. Remembers the wanted key's value in val.
int cfg_line_done(char val[], int vmax) {
    char t[16];
    int ok = 0;
    int r = 0;
    if (cfg_utf8(cfg_line) == 0) { return CFG_E_UTF8; }
    r = cfg_parse();
    if (r <= 0) { return r; }                          // 0 = empty / comment, < 0 = error
    if (cfg_found != 0) { return 0; }                  // the first one counted, later ones only had to parse
    if (strcmp(cfg_k, cfg_wk) != 0) { return 0; }
    strcpy(t, cfg_wt);
    if (cfg_wt[0] == 0) {
        strcpy(t, cfg_lab);                            // the program names no type: the label may tighten the check
    } else if (cfg_lab[0] != 0 && strcmp(cfg_lab, cfg_wt) != 0) {
        return CFG_E_LABEL;
    }
    if (t[0] != 0) {
        ok = cfg_check(t, cfg_v);
        if (ok < 0) { return CFG_E_UNKNOWN; }
        if (ok == 0) { return CFG_E_TYPE; }
    }
    if (strlen(cfg_v) >= vmax) { return CFG_E_BUF; }
    strcpy(val, cfg_v);
    cfg_found = 1;
    return 0;
}

int cfg_scan(char path[], char key[], char type[], char val[], int vmax) {
    char blk[128];
    int f = 0;
    int lineno = 1;
    int len = 0;
    int rc = 0;
    int n = 0;
    int i = 0;
    int c = 0;
    cfg_errline = 0;
    cfg_found = 0;
    val[0] = 0;
    if (vmax < 1) { return CFG_E_BUF; }
    f = fileOpen(path, 0);
    if (f < 0) { return CFG_E_NOFILE; }
    strSub(cfg_wk, key, 0, 63);
    strToLower(cfg_wk);
    strSub(cfg_wt, type, 0, 15);
    strToUpper(cfg_wt);
    cfg_line[0] = 0;
    while (rc == 0) {
        n = fileRead(f, blk, 127);
        if (n <= 0) { break; }
        i = 0;
        while (i < n && rc == 0) {
            c = blk[i] & 255;
            i = i + 1;
            if (c == '\n') {
                rc = cfg_line_done(val, vmax);
                if (rc == 0) {
                    lineno = lineno + 1;
                    len = 0;
                    cfg_line[0] = 0;
                }
            } else if (c == 0) {
                rc = CFG_E_SYNTAX;                     // binary file
            } else if (c != '\r') {
                if (len >= CFG_LINE) {
                    rc = CFG_E_LONG;
                } else {
                    cfg_line[len] = c;
                    len = len + 1;
                    cfg_line[len] = 0;
                }
            }
        }
    }
    fileClose(f);
    if (rc == 0 && len > 0) { rc = cfg_line_done(val, vmax); }   // last line without a line break
    if (rc != 0) {
        cfg_errline = lineno;
        val[0] = 0;
        return rc;
    }
    if (cfg_found == 0) { return CFG_E_NOKEY; }
    return CFG_OK;
}

// Value of key in the file, no type check. 0 = ok (val filled), < 0 = CFG_E_*
int cfgGet(char path[], char key[], char val[], int vmax) {
    return cfg_scan(path, key, "", val, vmax);
}

// Same, and the value must fit the type (the program decides, "IP4" / "FTP-DIR"). A label in the file has to agree.
int cfgGetT(char path[], char key[], char type[], char val[], int vmax) {
    return cfg_scan(path, key, type, val, vmax);
}
