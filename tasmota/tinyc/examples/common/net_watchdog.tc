// net_watchdog.tc - restart a device whose network stack hangs, and keep a small "black box" file.
//
// Why: a Matter node on an ESP32-C6 (.122, 05.10.2026) hung for hours in the evening: the script and the display ran
// (the clock was right), but HTTP and Matter were dead until the power was cut. Tasmota's own connection check kept
// saying "fine". An outbound request that must be ANSWERED (a TCP reply from another device) shows what a client sees.
//
// How to use (two calls):
//   void TaskLoop()    { ... wd_probe(); delay(60000) ... }        // once a minute, blocks a few seconds at most
//   void EverySecond() { ... wd_second("lamp=on"); ... }           // text after the fixed fields is up to you
// Optional in main(): wd_limit = 600; wd_min_up = 900; strcpy(wd_url, "http://<ip>/cm?cmnd=Status"); strcpy(wd_url2, ...);
//
// - The watchdog is ARMED by the first successful probe after boot, so a network where nobody answers HTTP cannot cause
//   a restart loop. After that: no answer for wd_limit seconds AND uptime above wd_min_up -> "Restart 1" (deferred).
//   The uptime floor keeps it from restarting more often than once per wd_min_up seconds.
// - Black box: one line a minute into /bb1.txt or /bb2.txt (the two take turns, wd_bb_limit bytes each, so the last
//   the last ~10-20 hours stay readable after a power cut):
//       2026-10-05T17:30:30 up=8708 heap=121 rssi=58 bss=8C:EF lk=2 probe=1/12s ...your text
//   rssi is Tasmota's percentage (Status 11), bss the end of the access point's MAC, lk the Wi-Fi connect counter.
//   Read the files with http://<ip>/ufsd?download=/bb1.txt . A "WATCHDOG" line says the device restarted itself.

int  wd_limit    = 600;                 // seconds without a successful probe before a restart
int  wd_min_up   = 900;                 // never restart before this uptime
int  wd_bb_limit = 60000;               // bytes per black-box file (~600 lines = 10 h each, 20 h in all at one line a minute)
char wd_url[64]  = "http://192.168.188.118/cm?cmnd=Status";     // two always-on Tasmota devices: one answer is enough
char wd_url2[64] = "http://192.168.188.39/cm?cmnd=Status";

int  wd_sec      = 0;                   // seconds since the script started
int  wd_ok_sec   = 0;                   // wd_sec of the last successful probe
int  wd_armed    = 0;                   // 1 after the first success
int  wd_res      = -1;                  // last probe: 1 ok, 0 failed
int  wd_bbsel    = -1;                  // which black-box file is current (0 = bb1, 1 = bb2)
int  wd_boot_done = 0;                  // 1 after the BOOT line of this start has been written

// Once a minute from TaskLoop: ask a device on the LAN, the reply must come back (the FRITZ!Box itself answers
// httpGet with 0, a Tasmota device with a body).
void wd_probe() {
    char b[96];
    b[0] = 0;
    if (httpGet(wd_url, b) > 0) { wd_ok_sec = wd_sec; wd_res = 1; wd_armed = 1; return; }
    b[0] = 0;
    if (httpGet(wd_url2, b) > 0) { wd_ok_sec = wd_sec; wd_res = 1; wd_armed = 1; return; }
    wd_res = 0;
}

// Append one line to the current black-box file; switch (and clear) the other one when it is full.
void wd_bb_write(char line[]) {
    int f; int s1; int s2; int sz;
    if (wd_bbsel < 0) {                                 // first call after boot: continue the file that is not full
        s1 = fileSize("/bb1.txt");
        s2 = fileSize("/bb2.txt");
        if (s1 < 0) { s1 = 0; }
        if (s2 < 0) { s2 = 0; }
        wd_bbsel = 0;
        if (s1 > wd_bb_limit) { wd_bbsel = 1; }
        else { if (s2 > 0 && s2 <= wd_bb_limit && s2 > s1) { wd_bbsel = 1; } }
    }
    if (wd_bbsel == 0) { sz = fileSize("/bb1.txt"); } else { sz = fileSize("/bb2.txt"); }
    if (sz > wd_bb_limit) {                             // full: the other file starts again (the old text stays in this one)
        wd_bbsel = 1 - wd_bbsel;
        if (wd_bbsel == 0) { f = fileOpen("/bb1.txt", 1); } else { f = fileOpen("/bb2.txt", 1); }
    } else {
        if (wd_bbsel == 0) { f = fileOpen("/bb1.txt", 2); } else { f = fileOpen("/bb2.txt", 2); }
        if (f < 0) {                                    // not there yet: create it
            if (wd_bbsel == 0) { f = fileOpen("/bb1.txt", 1); } else { f = fileOpen("/bb2.txt", 1); }
        }
    }
    if (f < 0) { return; }
    fileWrite(f, line, strlen(line));
    fileClose(f);
}

// Once a second from EverySecond. Every 60 s: one black-box line, then the watchdog check.
void wd_second(char extra[]) {
    char ts[24]; char r[512]; char line[260]; char bss[20]; char t[8]; char t2[8]; char c[16]; char why[48];
    int rssi = -1; int lk = -1; int p; int age;
    wd_sec = wd_sec + 1;
    if (wd_sec % 60 != 30) { return; }
    bss[0] = 0;
    timeStamp(ts);
    if (!wd_boot_done) {                                // once per start: WHY did the device start? (watchdog, crash, power)
        wd_boot_done = 1;
        r[0] = 0; why[0] = 0;
        tasmCmd("Status 1", r);
        p = strFind(r, "RestartReason");
        if (p >= 0) {
            strSub(why, r, p + 16, 40);                 // after RestartReason":"
            p = strFind(why, "\"");
            if (p > 0) { why[p] = 0; }
        }
        sprintf(line, "%s BOOT reason=[%s] uptime now %d s\n", ts, why, tasm_uptime);
        wd_bb_write(line);
    }
    r[0] = 0;
    tasmCmd("Status 11", r);
    p = strFind(r, "RSSI");
    if (p >= 0) { strSub(t, r, p + 6, 4); rssi = (int)atof(t); }
    p = strFind(r, "BSSId");
    if (p >= 0) { strSub(bss, r, p + 8 + 12, 5); bss[5] = 0; }      // 50:E6:36:24:8C:EF -> 8C:EF
    p = strFind(r, "LinkCount");
    if (p >= 0) { strSub(t2, r, p + 11, 4); lk = (int)atof(t2); }
    age = wd_sec - wd_ok_sec;
    sprintf(line, "%s up=%d heap=%d rssi=%d bss=%s lk=%d probe=%d/%ds %s\n", ts, tasm_uptime, tasm_heap / 1000, rssi, bss, lk,
            wd_res, age, extra);
    wd_bb_write(line);
    if (wd_armed && age >= wd_limit && tasm_uptime > wd_min_up) {
        sprintf(line, "%s WATCHDOG: no LAN device answering for %d s -> Restart 1\n", ts, age);
        wd_bb_write(line);
        strcpy(c, "Restart 1");
        tasmDefer(c);
    }
}
