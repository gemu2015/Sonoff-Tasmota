// vl53l0x_mux.tc - VL53L0X time-of-flight sensors, up to 4 on the channels of a TCA9548A I2C multiplexer (include library, no main()).
// Derived from examples/vl53l0x.tc (single sensor, Pololu/ST sequence); the function names got a vl_ prefix, state that
// belongs to one sensor (the stop variable) is kept per channel. All sensors keep the address 0x29, the multiplexer (0x70)
// switches one channel at a time, so no XSHUT lines are needed.
//
// Use:  vl_mux_init(bus)            claims the multiplexer and the address 0x29; 0 = multiplexer not found
//       vl_start(ch)                probes and initialises the sensor on channel ch (0..3): 1 = ok
//       vl_poll(ch)                 one single-shot measurement; vl_dist[ch] in mm (65535 = no result), vl_age[ch] = millis()
//       vl_release()                give the addresses back (OnExit / CleanUp)
// Without a multiplexer (vl_mux_ok == 0) a single sensor works on channel 0: vl_start(0) skips the channel switch.
//
// Time: one measurement takes about the timing budget (default 33 ms) plus the I2C transfers; call from TaskLoop().
// NOT tested with real sensors yet (the sequence is the proven one from the single-sensor driver).

#define VL_MUX_ADDR 0x70
#define VL_ADDR   0x29
#define VL_ID     0xEE

// ── Registers ────────────────────────────────────────
#define SYSRANGE_START                  0x00
#define SYSTEM_SEQUENCE_CONFIG          0x01
#define SYSTEM_INTERMEASUREMENT_PERIOD  0x04
#define SYSTEM_INTERRUPT_CONFIG_GPIO    0x0A
#define SYSTEM_INTERRUPT_CLEAR          0x0B
#define RESULT_INTERRUPT_STATUS         0x13
#define RESULT_RANGE_STATUS             0x14
#define MSRC_CONFIG_CONTROL             0x60
#define FINAL_RANGE_CONFIG_MIN_COUNT_RATE 0x44
#define MSRC_CONFIG_TIMEOUT_MACROP      0x46
#define PRE_RANGE_CONFIG_VCSEL_PERIOD   0x50
#define PRE_RANGE_CONFIG_TIMEOUT_HI     0x51
#define FINAL_RANGE_CONFIG_VCSEL_PERIOD 0x70
#define FINAL_RANGE_CONFIG_TIMEOUT_HI   0x71
#define GPIO_HV_MUX_ACTIVE_HIGH        0x84
#define VHV_CONFIG_PAD_SCL_SDA_HV       0x89
#define GLOBAL_CONFIG_SPAD_ENABLES_REF_0 0xB0
#define GLOBAL_CONFIG_REF_EN_START_SEL  0xB6
#define GLOBAL_CONFIG_VCSEL_WIDTH       0x32
#define DYNAMIC_SPAD_NUM_REQ            0x4E
#define DYNAMIC_SPAD_REF_EN_START       0x4F
#define IDENTIFICATION_MODEL_ID         0xC0
#define ALGO_PHASECAL_LIM               0x30

// ── State ────────────────────────────────────────────
int vl_bus;
int vl_stop_var;
int vl_budget_us;
int vl_ok;
int vl_valid;       // 1 = valid reading, 0 = no target
float vl_range;
char vl_buf[12];
int vl_tstart;
int vl_timeout = 500;   // ms a single wait may take (a cliff reader sets it low)

// ── I2C wrappers — match plugin's Wire transactions ──

void vl_wr(int reg, int val) {
  i2cWrite8(VL_ADDR, reg, val, vl_bus);
}

int vl_rd(int reg) {
  // Use buffer read (STOP mode) — matches plugin exactly
  i2cRead(VL_ADDR, reg, vl_buf, 1, vl_bus);
  return vl_buf[0];
}

void vl_wr16(int reg, int val) {
  vl_buf[0] = val / 256;
  vl_buf[1] = val & 255;
  i2cWrite(VL_ADDR, reg, vl_buf, 2, vl_bus);
}

int vl_rd16(int reg) {
  i2cRead(VL_ADDR, reg, vl_buf, 2, vl_bus);
  return vl_buf[0] * 256 + vl_buf[1];
}

void vl_wr32(int reg, int val) {
  vl_buf[0] = (val / 16777216) & 255;
  vl_buf[1] = (val / 65536) & 255;
  vl_buf[2] = (val / 256) & 255;
  vl_buf[3] = val & 255;
  i2cWrite(VL_ADDR, reg, vl_buf, 4, vl_bus);
}

// ── Timeout helpers ──────────────────────────────────

void vl_startTO() { vl_tstart = millis(); }

int vl_timedOut() {
  int e = millis() - vl_tstart;
  if (e < 0) { e = e + 2147483647; }
  return e > vl_timeout;
}

// ── VCSEL period encode/decode ───────────────────────

int vl_decodeVcsel(int rv) { return (rv + 1) * 2; }
int vl_encodeVcsel(int p) { return p / 2 - 1; }

// macro period in nanoseconds, avoids overflow
int vl_macroPeriodNs(int pclks) {
  // (2304 * pclks * 1655 + 500) / 1000
  // max pclks=18: 2304*18=41472, 41472*1655=68636160, +500/1000=68636 — fits
  return (2304 * pclks * 1655 + 500) / 1000;
}

// ── Timeout encode/decode ────────────────────────────

int vl_decodeTimeout(int rv) {
  int lsb = rv & 255;
  int msb = rv / 256;
  int i = 0;
  while (i < msb) { lsb = lsb * 2; i = i + 1; }
  return lsb + 1;
}

int vl_encodeTimeout(int mclks) {
  if (mclks <= 0) { return 0; }
  int ls = mclks - 1;
  int ms = 0;
  while (ls > 255) { ls = ls / 2; ms = ms + 1; }
  return ms * 256 + (ls & 255);
}

// convert mclks to microseconds — overflow-safe
int vl_mclksToUs(int mclks, int pclks) {
  int mns = vl_macroPeriodNs(pclks);
  // (mclks * mns + mns/2) / 1000 — could overflow for large mclks
  // use: mclks * (mns/10) / 100 for safety
  return (mclks * (mns / 10) + 50) / 100;
}

int vl_usToMclks(int us, int pclks) {
  int mns = vl_macroPeriodNs(pclks);
  return (us * 1000 + mns / 2) / mns;
}

// ── Get sequence step enables + timeouts ─────────────
// stored in local vars via pointers not available, use globals

int en_tcc;
int en_dss;
int en_msrc;
int en_pre;
int en_final;
int pre_pclks;
int final_pclks;
int msrc_mclks;
int pre_mclks;
int final_mclks;
int msrc_us;
int pre_us;
int final_us;

void vl_getEnablesAndTimeouts() {
  int sc = vl_rd(SYSTEM_SEQUENCE_CONFIG);
  en_tcc   = (sc / 16) & 1;
  en_dss   = (sc / 8) & 1;
  en_msrc  = (sc / 4) & 1;
  en_pre   = (sc / 64) & 1;
  en_final = (sc / 128) & 1;

  pre_pclks = vl_decodeVcsel(vl_rd(PRE_RANGE_CONFIG_VCSEL_PERIOD));
  msrc_mclks = vl_rd(MSRC_CONFIG_TIMEOUT_MACROP) + 1;
  msrc_us = vl_mclksToUs(msrc_mclks, pre_pclks);
  pre_mclks = vl_decodeTimeout(vl_rd16(PRE_RANGE_CONFIG_TIMEOUT_HI));
  pre_us = vl_mclksToUs(pre_mclks, pre_pclks);

  final_pclks = vl_decodeVcsel(vl_rd(FINAL_RANGE_CONFIG_VCSEL_PERIOD));
  final_mclks = vl_decodeTimeout(vl_rd16(FINAL_RANGE_CONFIG_TIMEOUT_HI));
  if (en_pre) { final_mclks = final_mclks - pre_mclks; }
  final_us = vl_mclksToUs(final_mclks, final_pclks);
}

// ── Get measurement timing budget (microseconds) ────

int vl_getBudget() {
  int b = 1910 + 960;
  vl_getEnablesAndTimeouts();
  if (en_tcc) { b = b + msrc_us + 590; }
  if (en_dss) { b = b + 2 * (msrc_us + 690); }
  else { if (en_msrc) { b = b + msrc_us + 660; } }
  if (en_pre) { b = b + pre_us + 660; }
  if (en_final) { b = b + final_us + 550; }
  return b;
}

// ── Set measurement timing budget ────────────────────

int vl_setBudget(int budget) {
  if (budget < 20000) { return 0; }
  int used = 1320 + 960;
  vl_getEnablesAndTimeouts();
  if (en_tcc) { used = used + msrc_us + 590; }
  if (en_dss) { used = used + 2 * (msrc_us + 690); }
  else { if (en_msrc) { used = used + msrc_us + 660; } }
  if (en_pre) { used = used + pre_us + 660; }
  if (en_final) {
    used = used + 550;
    if (used > budget) { return 0; }
    int fr_us = budget - used;
    int fr_mclks = vl_usToMclks(fr_us, final_pclks);
    if (en_pre) { fr_mclks = fr_mclks + pre_mclks; }
    vl_wr16(FINAL_RANGE_CONFIG_TIMEOUT_HI, vl_encodeTimeout(fr_mclks));
    vl_budget_us = budget;
  }
  return 1;
}

// ── Single reference calibration ─────────────────────

int vl_singleRefCal(int vhv_init) {
  vl_wr(SYSRANGE_START, 1 | vhv_init);
  vl_startTO();
  while ((vl_rd(RESULT_INTERRUPT_STATUS) & 7) == 0) {
    if (vl_timedOut()) {
      addLog("VL53L0X: cal timeout");
      return 0;
    }
  }
  vl_wr(SYSTEM_INTERRUPT_CLEAR, 1);
  vl_wr(SYSRANGE_START, 0);
  return 1;
}

// ── Get SPAD info from NVM ───────────────────────────

int spad_count;
int spad_aperture;

int vl_getSpadInfo() {
  vl_wr(0x80, 0x01);
  vl_wr(0xFF, 0x01);
  vl_wr(0x00, 0x00);
  vl_wr(0xFF, 0x06);
  vl_wr(0x83, vl_rd(0x83) | 0x04);
  vl_wr(0xFF, 0x07);
  vl_wr(0x81, 0x01);
  vl_wr(0x80, 0x01);
  vl_wr(0x94, 0x6B);
  vl_wr(0x83, 0x00);
  vl_startTO();
  while (vl_rd(0x83) == 0) {
    if (vl_timedOut()) { return 0; }
  }
  vl_wr(0x83, 0x01);
  int tmp = vl_rd(0x92);
  spad_count = tmp & 127;
  spad_aperture = tmp / 128;
  vl_wr(0x81, 0x00);
  vl_wr(0xFF, 0x06);
  vl_wr(0x83, vl_rd(0x83) & 251);
  vl_wr(0xFF, 0x01);
  vl_wr(0x00, 0x01);
  vl_wr(0xFF, 0x00);
  vl_wr(0x80, 0x00);
  return 1;
}

// ── Full init — follows plugin VL53L0X_init(true) exactly ──

int vl_init1() {
  // check model ID
  int id = vl_rd(IDENTIFICATION_MODEL_ID);
  if (id != VL_ID) { return 0; }

  // ── DataInit ──
  // 2V8 mode
  vl_wr(VHV_CONFIG_PAD_SCL_SDA_HV, vl_rd(VHV_CONFIG_PAD_SCL_SDA_HV) | 0x01);

  // "Set I2C standard mode"
  vl_wr(0x88, 0x00);

  vl_wr(0x80, 0x01);
  vl_wr(0xFF, 0x01);
  vl_wr(0x00, 0x00);
  vl_stop_var = vl_rd(0x91);
  vl_wr(0x00, 0x01);
  vl_wr(0xFF, 0x00);
  vl_wr(0x80, 0x00);

  // disable SIGNAL_RATE_MSRC and PRE_RANGE limit checks
  vl_wr(MSRC_CONFIG_CONTROL, vl_rd(MSRC_CONFIG_CONTROL) | 0x12);

  // signal rate limit 0.25 MCPS: 0.25 * 128 = 32 in Q9.7
  vl_wr16(FINAL_RANGE_CONFIG_MIN_COUNT_RATE, 32);

  vl_wr(SYSTEM_SEQUENCE_CONFIG, 0xFF);

  // ── StaticInit ──

  // SPAD configuration
  if (!vl_getSpadInfo()) { return 0; }

  // read SPAD map
  char spad[6];
  i2cRead(VL_ADDR, GLOBAL_CONFIG_SPAD_ENABLES_REF_0, spad, 6, vl_bus);

  // set reference SPADs
  vl_wr(0xFF, 0x01);
  vl_wr(DYNAMIC_SPAD_REF_EN_START, 0x00);
  vl_wr(DYNAMIC_SPAD_NUM_REQ, 0x2C);
  vl_wr(0xFF, 0x00);
  vl_wr(GLOBAL_CONFIG_REF_EN_START_SEL, 0xB4);

  int first = 0;
  if (spad_aperture) { first = 12; }
  int enabled = 0;
  int i = 0;
  while (i < 48) {
    int bi = i / 8;
    int bit = i - bi * 8;
    // compute mask = 1 << bit
    int mask = 1;
    int j = 0;
    while (j < bit) { mask = mask * 2; j = j + 1; }
    if (i < first || enabled == spad_count) {
      spad[bi] = spad[bi] & (255 - mask);
    } else {
      if (spad[bi] & mask) { enabled = enabled + 1; }
    }
    i = i + 1;
  }
  i2cWrite(VL_ADDR, GLOBAL_CONFIG_SPAD_ENABLES_REF_0, spad, 6, vl_bus);

  // ── Load tuning settings ──
  vl_wr(0xFF, 0x01); vl_wr(0x00, 0x00);
  vl_wr(0xFF, 0x00); vl_wr(0x09, 0x00); vl_wr(0x10, 0x00); vl_wr(0x11, 0x00);
  vl_wr(0x24, 0x01); vl_wr(0x25, 0xFF); vl_wr(0x75, 0x00);
  vl_wr(0xFF, 0x01); vl_wr(0x4E, 0x2C); vl_wr(0x48, 0x00); vl_wr(0x30, 0x20);
  vl_wr(0xFF, 0x00);
  vl_wr(0x30, 0x09); vl_wr(0x54, 0x00); vl_wr(0x31, 0x04); vl_wr(0x32, 0x03);
  vl_wr(0x40, 0x83); vl_wr(0x46, 0x25); vl_wr(0x60, 0x00); vl_wr(0x27, 0x00);
  vl_wr(0x50, 0x06); vl_wr(0x51, 0x00); vl_wr(0x52, 0x96); vl_wr(0x56, 0x08);
  vl_wr(0x57, 0x30); vl_wr(0x61, 0x00); vl_wr(0x62, 0x00); vl_wr(0x64, 0x00);
  vl_wr(0x65, 0x00); vl_wr(0x66, 0xA0);
  vl_wr(0xFF, 0x01);
  vl_wr(0x22, 0x32); vl_wr(0x47, 0x14); vl_wr(0x49, 0xFF); vl_wr(0x4A, 0x00);
  vl_wr(0xFF, 0x00);
  vl_wr(0x7A, 0x0A); vl_wr(0x7B, 0x00); vl_wr(0x78, 0x21);
  vl_wr(0xFF, 0x01);
  vl_wr(0x23, 0x34); vl_wr(0x42, 0x00); vl_wr(0x44, 0xFF); vl_wr(0x45, 0x26);
  vl_wr(0x46, 0x05); vl_wr(0x40, 0x40); vl_wr(0x0E, 0x06); vl_wr(0x20, 0x1A);
  vl_wr(0x43, 0x40);
  vl_wr(0xFF, 0x00);
  vl_wr(0x34, 0x03); vl_wr(0x35, 0x44);
  vl_wr(0xFF, 0x01);
  vl_wr(0x31, 0x04); vl_wr(0x4B, 0x09); vl_wr(0x4C, 0x05); vl_wr(0x4D, 0x04);
  vl_wr(0xFF, 0x00);
  vl_wr(0x44, 0x00); vl_wr(0x45, 0x20); vl_wr(0x47, 0x08); vl_wr(0x48, 0x28);
  vl_wr(0x67, 0x00); vl_wr(0x70, 0x04); vl_wr(0x71, 0x01); vl_wr(0x72, 0xFE);
  vl_wr(0x76, 0x00); vl_wr(0x77, 0x00);
  vl_wr(0xFF, 0x01); vl_wr(0x0D, 0x01);
  vl_wr(0xFF, 0x00); vl_wr(0x80, 0x01); vl_wr(0x01, 0xF8);
  vl_wr(0xFF, 0x01);
  vl_wr(0x8E, 0x01); vl_wr(0x00, 0x01); vl_wr(0xFF, 0x00); vl_wr(0x80, 0x00);

  // ── GPIO config: new sample ready, active low ──
  vl_wr(SYSTEM_INTERRUPT_CONFIG_GPIO, 0x04);
  vl_wr(GPIO_HV_MUX_ACTIVE_HIGH, vl_rd(GPIO_HV_MUX_ACTIVE_HIGH) & 239);
  vl_wr(SYSTEM_INTERRUPT_CLEAR, 0x01);

  // ── Timing budget: get, change sequence, re-apply ──
  // THIS IS CRITICAL — without it, calibration fails
  vl_budget_us = vl_getBudget();

  // disable MSRC and TCC
  vl_wr(SYSTEM_SEQUENCE_CONFIG, 0xE8);

  // re-apply budget with new sequence config
  vl_setBudget(vl_budget_us);

  // ── VHV calibration ──
  vl_wr(SYSTEM_SEQUENCE_CONFIG, 0x01);
  if (!vl_singleRefCal(0x40)) { return 0; }

  // ── Phase calibration ──
  vl_wr(SYSTEM_SEQUENCE_CONFIG, 0x02);
  if (!vl_singleRefCal(0x00)) { return 0; }

  // restore sequence config
  vl_wr(SYSTEM_SEQUENCE_CONFIG, 0xE8);

  return 1;
}

// ── Read single-shot range (mm) ──────────────────────

int vl_range1() {
  vl_wr(0x80, 0x01);
  vl_wr(0xFF, 0x01);
  vl_wr(0x00, 0x00);
  vl_wr(0x91, vl_stop_var);
  vl_wr(0x00, 0x01);
  vl_wr(0xFF, 0x00);
  vl_wr(0x80, 0x00);

  vl_wr(SYSRANGE_START, 0x01);

  // wait start bit cleared
  vl_startTO();
  while (vl_rd(SYSRANGE_START) & 1) {
    if (vl_timedOut()) { return 65535; }
  }

  // wait measurement complete
  vl_startTO();
  while ((vl_rd(RESULT_INTERRUPT_STATUS) & 7) == 0) {
    if (vl_timedOut()) { return 65535; }
  }

  // range at RESULT_RANGE_STATUS + 10 = 0x1E
  int range = vl_rd16(0x1E);

  vl_wr(SYSTEM_INTERRUPT_CLEAR, 0x01);

  return range;
}


// ---- several sensors behind the multiplexer ----------------------------------------------------------------------

int vl_mux_ok = 0;
int vl_cur    = -1;          // channel the multiplexer currently has selected (-1 = unknown)
int vl_sv[4];                // per sensor: stop variable read during init
int vl_up[4];                // 1 = sensor initialised
int vl_dist[4];              // last distance in mm, 65535 = no result
int vl_age[4];               // millis() of the last measurement (good or not)
int vl_claimed = 0;

// switch the multiplexer to channel ch; 1 = ok (also when no multiplexer is used)
int vl_select(int ch) {
    int m = 0;
    if (vl_mux_ok == 0) { return 1; }
    if (vl_cur == ch) { return 1; }
    m = 1 << ch;
    if (i2cWrite8(VL_MUX_ADDR, m, m, vl_bus) != 1) { vl_cur = -1; return 0; }   // the control byte, sent twice, is harmless
    vl_cur = ch;
    return 1;
}

int vl_mux_init(int bus) {
    int i = 0;
    vl_bus = bus;
    vl_mux_ok = 0;
    vl_cur = -1;
    while (i < 4) { vl_up[i] = 0; vl_dist[i] = 65535; vl_age[i] = 0; i = i + 1; }
    if (i2cSetDevice(VL_MUX_ADDR, bus) == 0) { return 0; }
    i2cSetActiveFound(VL_MUX_ADDR, "TCA9548A", bus);
    vl_mux_ok = 1;
    return 1;
}

int vl_start(int ch) {
    if (ch < 0 || ch > 3) { return 0; }
    vl_up[ch] = 0;
    if (vl_select(ch) == 0) { return 0; }
    if (vl_rd(IDENTIFICATION_MODEL_ID) != VL_ID) { return 0; }
    if (vl_claimed == 0) {
        i2cSetActiveFound(VL_ADDR, "VL53L0X", vl_bus);
        vl_claimed = 1;
    }
    if (vl_init1() == 0) { return 0; }
    vl_sv[ch] = vl_stop_var;
    vl_up[ch] = 1;
    return 1;
}

int vl_poll(int ch) {
    int d = 65535;
    if (ch < 0 || ch > 3) { return 65535; }
    if (vl_up[ch] == 0) { return 65535; }
    if (vl_select(ch) == 0) { vl_dist[ch] = 65535; vl_age[ch] = millis(); return 65535; }
    vl_stop_var = vl_sv[ch];
    d = vl_range1();
    if (d >= 8190) { d = 65535; }
    vl_dist[ch] = d;
    vl_age[ch] = millis();
    return d;
}

void vl_release() {
    if (vl_claimed == 1) { I2cResetActive(VL_ADDR, vl_bus); vl_claimed = 0; }
    if (vl_mux_ok == 1) { I2cResetActive(VL_MUX_ADDR, vl_bus); vl_mux_ok = 0; }
}
