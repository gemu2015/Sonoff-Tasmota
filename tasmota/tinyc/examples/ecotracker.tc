// EcoTracker Emulator for Marstek battery systems (Jupiter, Venus, B2500) and Hoymiles (MS-A2)
// TinyC translation of ottelo's Scripter EcoTrackerEmuSimple
// Emulates Everhome EcoTracker via mDNS + REST API /v1/json
// Requires: USE_SML (or USE_SML_M)
// SML meter descriptor must be loaded separately via IDE SML tab or /sml_meter.def

// ── Persistent variables (saved to /ecotracker.dat) ──
float dval;     // daily counter in (kWh) at midnight
float dval2;    // daily counter out (kWh) at midnight
float mval;     // monthly counter in
float mval2;    // monthly counter out
float yval;     // yearly counter in
float yval2;    // yearly counter out

// ── Runtime variables ──
float cpwr;         // current power (smoothed)
int once;           // mDNS registered flag
int last_hr;        // last seen hour (for midnight detect)
char buf[256];      // general purpose buffer
char line[64];      // line buffer for file I/O

// ── Settings (WebUI widgets) ──
int pwroffset;      // power offset [W] for zero-feed regulation
int do_init;        // button: initialize counters from meter
int do_save;        // button: manually save data

// ── Persistent variable file I/O ──
void saveVars() {
    int f = fileOpen("/ecotracker.dat", 1);  // write mode
    if (f < 0) return;
    sprintfFloat(line, "%.4f\n", dval);
    fileWrite(f, line, strlen(line));
    sprintfFloat(line, "%.4f\n", dval2);
    fileWrite(f, line, strlen(line));
    sprintfFloat(line, "%.4f\n", mval);
    fileWrite(f, line, strlen(line));
    sprintfFloat(line, "%.4f\n", mval2);
    fileWrite(f, line, strlen(line));
    sprintfFloat(line, "%.4f\n", yval);
    fileWrite(f, line, strlen(line));
    sprintfFloat(line, "%.4f\n", yval2);
    fileWrite(f, line, strlen(line));
    sprintfInt(line, "%d\n", pwroffset);
    fileWrite(f, line, strlen(line));
    fileClose(f);
    addLog("EcoTracker: vars saved");
}

void loadVars() {
    if (!fileExists("/ecotracker.dat")) return;
    int f = fileOpen("/ecotracker.dat", 0);  // read mode
    if (f < 0) return;
    char data[256];
    int n = fileRead(f, data, 255);
    fileClose(f);
    if (n <= 0) return;
    data[n] = 0;
    // Parse 6 floats + 1 int, one per line
    char tok[32];
    strToken(tok, data, '\n', 1);  dval  = atof(tok);
    strToken(tok, data, '\n', 2);  dval2 = atof(tok);
    strToken(tok, data, '\n', 3);  mval  = atof(tok);
    strToken(tok, data, '\n', 4);  mval2 = atof(tok);
    strToken(tok, data, '\n', 5);  yval  = atof(tok);
    strToken(tok, data, '\n', 6);  yval2 = atof(tok);
    if (strToken(tok, data, '\n', 7) > 0) {
        pwroffset = atoi(tok);
    }
    addLog("EcoTracker: vars loaded");
}

void initVars() {
    // Initialize counters from current meter readings
    float ein = smlGet(2);   // energy in (kWh)
    float eout = smlGet(3);  // energy out (kWh)
    dval  = ein;  dval2  = eout;
    mval  = ein;  mval2  = eout;
    yval  = ein;  yval2  = eout;
    saveVars();
    addLog("EcoTracker: counters initialized from meter");
}

// ── EcoTracker REST API handler ──
// Marstek polls /v1/json every ~13s
void WebOn() {
    int h = webHandler();
    if (h == 1) {
        float ein  = smlGet(2) * 1000.0;   // kWh -> Wh
        float eout = smlGet(3) * 1000.0;
        // Build JSON: {"power":N,"powerAvg":N,"energyCounterIn":N,"energyCounterOut":N}
        sprintfFloat(buf, "{\"power\":%.0f", cpwr);
        sprintfAppendFloat(buf, ",\"powerAvg\":%.0f", cpwr);
        sprintfAppendFloat(buf, ",\"energyCounterIn\":%.0f", ein);
        sprintfAppendFloat(buf, ",\"energyCounterOut\":%.0f}", eout);
        webSend(buf);
    }
}

// ── Every second: midnight check + power smoothing ──
void EverySecond() {
    // Wait for NTP and meter data
    if (tasm_year < 2020) return;
    float pwr = smlGet(1);
    if (pwr == 0.0) return;  // no meter data yet

    // Register mDNS once
    if (once == 0) {
        mdns("ecotracker-", "-", "everhome");
        once = 1;
        addLog("EcoTracker: mDNS registered");
    }

    // Handle button presses from settings page
    if (do_init) {
        initVars();
        do_init = 0;
    }
    if (do_save) {
        saveVars();
        do_save = 0;
    }

    // Power smoothing — reduce peaks for better battery regulation
    float diff = pwr - cpwr;
    if (diff > 500.0) {
        cpwr = pwr - (diff / 2.0);
    } else {
        cpwr = pwr + (float)pwroffset;
    }

    // Midnight counter update (check every second, act on hour change to 0)
    int hr = tasm_hour;
    if (hr == 0 && last_hr != 0) {
        // Day change
        dval  = smlGet(2);
        dval2 = smlGet(3);
        if (tasm_day == 1) {
            // Month change
            mval  = smlGet(2);
            mval2 = smlGet(3);
        }
        if (tasm_day == 1 && tasm_month == 1) {
            // Year change
            yval  = smlGet(2);
            yval2 = smlGet(3);
        }
        saveVars();
    }
    last_hr = hr;
}

// ── Web display: sensor rows on Tasmota main page ──
void WebCall() {
    sprintfFloat(buf, "{s}Leistung (Marstek){m}%.0f W{e}", cpwr);
    webSend(buf);

    float ein = smlGet(2);
    float eout = smlGet(3);

    sprintfFloat(buf, "{s}Tagesverbrauch{m}%.2f kWh{e}", ein - dval);
    webSend(buf);
    sprintfFloat(buf, "{s}Monatsverbrauch{m}%.2f kWh{e}", ein - mval);
    webSend(buf);
    sprintfFloat(buf, "{s}Jahresverbrauch{m}%.2f kWh{e}", ein - yval);
    webSend(buf);
    sprintfFloat(buf, "{s}Tageseinspeisung{m}%.2f kWh{e}", eout - dval2);
    webSend(buf);
    sprintfFloat(buf, "{s}Monatseinspeisung{m}%.2f kWh{e}", eout - mval2);
    webSend(buf);
    sprintfFloat(buf, "{s}Jahreseinspeisung{m}%.2f kWh{e}", eout - yval2);
    webSend(buf);
    sprintfInt(buf, "{s}Uptime{m}%d min{e}", tasm_uptime / 60);
    webSend(buf);
}

// ── Settings page (WebUI widgets) ──
void WebUI() {
    int page = wPage();
    if (page == 0) {
        // Settings
        wNumber(pwroffset, -100, 100, "Offset [W] Nulleinspeisung");
        wButton(do_init, "Zaehler initialisieren");
        wButton(do_save, "Daten speichern");
    }
}

// ── MQTT telemetry ──
void JsonCall() {
    float ein = smlGet(2);
    float eout = smlGet(3);
    sprintfFloat(buf, ",\"EcoTracker\":{\"Power\":%.0f", cpwr);
    sprintfAppendFloat(buf, ",\"EnergyIn\":%.3f", ein);
    sprintfAppendFloat(buf, ",\"EnergyOut\":%.3f", eout);
    sprintfAppendFloat(buf, ",\"DayIn\":%.3f", ein - dval);
    sprintfAppendFloat(buf, ",\"DayOut\":%.3f}", eout - dval2);
    responseAppend(buf);
}

// ── Main: register endpoint, load saved data ──
int main() {
    once = 0;
    last_hr = -1;
    cpwr = 0.0;
    do_init = 0;
    do_save = 0;
    pwroffset = 0;

    // Register settings page button on Tasmota main page
    wLabel(0, "EcoTracker Einstellungen");

    // Register /v1/json endpoint for Marstek polling
    webOn(1, "/v1/json");

    // Load saved counter values
    loadVars();

    // If no saved data, initialize from meter
    if (dval == 0.0 && smlGet(2) > 0.0) {
        initVars();
    }

    // Set timezone (same as Scripter version)
    tasmCmd("Backlog2 Timezone 99;TimeStd 0,0,10,1,3,60;TimeDst 0,0,3,1,2,120", buf);

    addLog("EcoTracker: started");
    return 0;
}
