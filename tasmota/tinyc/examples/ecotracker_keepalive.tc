// EcoTracker Emulator — Keep-Alive (Jackery Homepower 2000 Ultra)
//
// Variant of ecotracker.tc for devices whose firmware refuses to talk to
// any HTTP server that closes its TCP socket after each request — most
// prominently the Jackery Homepower 2000 Ultra, but the Growatt NOAH 2000
// shows the same symptom. Both expect the EcoTracker's TCP connection to
// stay open across the entire polling lifetime, the way the physical
// device behaves.
//
// What's different from ecotracker.tc:
//   - /v1/json is served by a raw TCP server (tcpServer / tcpAvailable /
//     tcpWrite) instead of Tasmota's WebServer. Tasmota's Arduino-ESP32
//     WebServer auto-closes the socket after every handler (the keep-alive
//     branch in WebServer.cpp:455-460 is commented out citing Chrome
//     issues — see espressif/arduino-esp32#3652). webOn() in the standard
//     example inherits that, and Jackery drops the device within seconds.
//   - The response uses ONLY 3 headers — exactly what the real EcoTracker
//     sends (verified via curl in sdeigm/uni-meter#265): HTTP/1.1 200 OK,
//     Content-Type, Content-Length. No Server, no Date, no Connection.
//     Jackery's parser appears to assume this exact 3-header shape.
//
// REQUIRED setup in user_config_override.h BEFORE flashing:
//     #define WEB_PORT 8080
// This frees TCP port 80 for tcpServer(80); Tasmota's admin UI moves to
// http://<device>:8080. mDNS advertises the EcoTracker on port 80 in either
// case (hardcoded in xdrv_124_tinyc_vm.h:8904).
//
// Marstek / Hoymiles / B2500 users: keep using ecotracker.tc instead.
// That variant is simpler and works fine on those devices, which honour
// the standard close-after-response HTTP/1.0 flow.

// ── Persistent state ──────────────────────────────────────────
persist float dval;     persist float dval2;
persist float mval;     persist float mval2;
persist float yval;     persist float yval2;
persist int   pwroffset;

// ── Runtime state ─────────────────────────────────────────────
float cpwr;           // smoothed power [W]
int   srv_state;      // 0 = not started, 1 = listening
int   last_hr;        // hour of last EverySecond tick (midnight detect)
int   req_count;      // total /v1/json responses sent — diagnostic
int   do_init;        // settings: initialize counters
int   do_save;        // settings: manual save

// Buffers (separate, since rxbuf can be live while we build the reply)
char rxbuf[260];      // tcpRead caps at 254 + NUL
char hdr[200];        // HTTP response header line set
char json[256];       // HTTP body
char scratch[80];     // shared scratch for sprintf inside web rows

// ── Counter initialisation from meter ─────────────────────────
void initVars() {
    float ein  = smlGet(2);
    float eout = smlGet(3);
    dval = ein;  dval2 = eout;
    mval = ein;  mval2 = eout;
    yval = ein;  yval2 = eout;
    saveVars();
    addLog("EcoTracker(KA): counters initialised from meter");
}

// ── /v1/json poll & respond ───────────────────────────────────
// Called every 100 ms. When Jackery has sent bytes on the kept-alive
// socket, drain them, recognise the GET, and emit a response. The
// socket is left open afterwards — Jackery polls roughly every 13 s
// over the same connection.
//
// The substring check is intentionally forgiving: we don't parse HTTP
// properly, we just look for "GET /v1/json" anywhere in the drained
// bytes. Sufficient for Jackery's simple GET requests; nothing else on
// port 80 will be talking to us once mDNS routes traffic to the
// everhome service.
void Every100ms() {
    if (srv_state == 0) return;
    if (tcpAvailable() <= 0) return;

    int seen_get = 0;
    int guard    = 4;      // bounded loop — at most 4 * 254 B per cycle
    while (tcpAvailable() > 0 && guard > 0) {
        int n = tcpRead(rxbuf);
        if (n <= 0) break;
        if (strContains(rxbuf, "GET /v1/json")) seen_get = 1;
        guard = guard - 1;
    }
    if (seen_get == 0) return;

    float ein  = smlGet(2) * 1000.0;   // kWh -> Wh, as Marstek/Jackery expect
    float eout = smlGet(3) * 1000.0;
    sprintf(json,
        "{\"power\":%.0f,\"powerAvg\":%.0f,\"energyCounterIn\":%.0f,\"energyCounterOut\":%.0f}",
        cpwr, cpwr, ein, eout);

    int blen = strlen(json);
    sprintf(hdr,
        "HTTP/1.1 200 OK\r\nContent-Type: application/json\r\nContent-Length: %d\r\n\r\n",
        blen);

    tcpWrite(hdr);
    tcpWrite(json);
    // NO tcpDisconnect — Jackery expects the socket to remain open.
    req_count = req_count + 1;
}

// ── Periodic state: start server, smooth power, midnight rollover ─
void EverySecond() {
    if (tasm_year < 2020) return;     // wait for NTP
    float pwr = smlGet(1);
    if (pwr == 0.0) return;           // wait for meter

    // One-time start. tcpServer must be listening BEFORE we advertise
    // the service over mDNS — otherwise Jackery may connect to a port
    // that isn't accepting yet and back off.
    if (srv_state == 0) {
        int rc = tcpServer(80);
        if (rc < 0) {
            addLog("EcoTracker(KA): tcpServer(80) failed — is WEB_PORT still 80? See header comment.");
            return;
        }
        tcpNoDelay(1);              // disable Nagle, response goes out instantly
        tcpKeepalive(30, 10, 3);    // SO_KEEPALIVE: probe after 30 s idle, 10 s intervals, give up after 3
        mdnsRegister("ecotracker-", "-", "everhome");
        srv_state = 1;
        addLog("EcoTracker(KA): TCP:80 listening, mDNS announced");
    }

    if (do_init) { initVars(); do_init = 0; }
    if (do_save) { saveVars(); do_save = 0; }

    // Power smoothing — halve peaks above 500 W so the battery doesn't
    // chase spikes (same algorithm as ottelo's scripter version).
    float diff = pwr - cpwr;
    if (diff > 500.0) {
        cpwr = pwr - (diff / 2.0);
    } else {
        cpwr = pwr + (float)pwroffset;
    }

    // Midnight: snapshot daily / monthly / yearly counters.
    int hr = tasm_hour;
    if (hr == 0 && last_hr != 0) {
        dval  = smlGet(2);
        dval2 = smlGet(3);
        if (tasm_day == 1) {
            mval  = smlGet(2);
            mval2 = smlGet(3);
        }
        if (tasm_day == 1 && tasm_month == 1) {
            yval  = smlGet(2);
            yval2 = smlGet(3);
        }
        saveVars();
    }
    last_hr = hr;
}

// ── Tasmota main-page sensor rows ─────────────────────────────
void WebCall() {
    sprintf(scratch, "{s}Leistung (Akku){m}%.0f W{e}", cpwr);
    webSend(scratch);
    float ein  = smlGet(2);
    float eout = smlGet(3);
    sprintf(scratch, "{s}Tagesverbrauch{m}%.2f kWh{e}",   ein  - dval);   webSend(scratch);
    sprintf(scratch, "{s}Tageseinspeisung{m}%.2f kWh{e}", eout - dval2);  webSend(scratch);
    sprintf(scratch, "{s}Monatsverbrauch{m}%.2f kWh{e}",  ein  - mval);   webSend(scratch);
    sprintf(scratch, "{s}Jahresverbrauch{m}%.2f kWh{e}",  ein  - yval);   webSend(scratch);

    char state[12];
    if (srv_state) strcpy(state, "online");
    else           strcpy(state, "offline");
    sprintf(scratch, "{s}EcoTracker TCP{m}%s (%d req){e}", state, req_count);
    webSend(scratch);
}

// ── Settings sub-page ─────────────────────────────────────────
void WebUI() {
    int page = webPage();
    if (page == 0) {
        webNumber(pwroffset, -100, 100, "Offset [W] Nulleinspeisung");
        webButton(do_init, "Zaehler initialisieren");
        webButton(do_save, "Daten speichern");
    }
}

// ── MQTT telemetry ────────────────────────────────────────────
void JsonCall() {
    float ein  = smlGet(2);
    float eout = smlGet(3);
    sprintf(scratch,
        ",\"EcoTrackerKA\":{\"Power\":%.0f,\"EnergyIn\":%.3f,\"EnergyOut\":%.3f,\"Requests\":%d}",
        cpwr, ein, eout, req_count);
    responseAppend(scratch);
}

// ── Entry point ───────────────────────────────────────────────
int main() {
    srv_state = 0;
    last_hr   = -1;
    cpwr      = 0.0;
    req_count = 0;
    do_init   = 0;
    do_save   = 0;

    // Settings tab label on the Tasmota main page
    webPageLabel(0, "EcoTracker (Keep-Alive) Einstellungen");

    // First-boot counter init from current meter reading (only if no
    // persisted value exists yet)
    if (dval == 0.0 && smlGet(2) > 0.0) {
        initVars();
    }

    tasmCmd("Backlog2 Timezone 99;TimeStd 0,0,10,1,3,60;TimeDst 0,0,3,1,2,120", scratch);

    addLog("EcoTracker(KA): started — waiting for SML + WiFi");
    return 0;
}
