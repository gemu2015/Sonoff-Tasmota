// @name: Energie-Grafiken (Seiten des Core2, Daten von der SD-Karte)
// ─────────────────────────────────────────────────────────────────────
// energy_charts.tc — die fuenf Webseiten von core2_energy.tc (.76) auf dem P4
// (.118): Tages Verlauf, Letzte Woche, 52 Wochen, Andere Geraete, Heizung
// 31 Tage. Seiten, Auszuege und Diagramme sind wortgleich uebernommen.
//
// Anders ist nur die QUELLE. Der Core2 holt jeden Bereich auf Abruf von .61,
// ueber Port 80 -- genau der Weg, der .61 blockiert. Hier kommt alles von der
// SD-Karte, die energy_backup.tc (Slot 1) jede Nacht um 00:20 fuellt:
//   /energy_m_log.txt   Tagesdatenbank, ganz
//   /e15_JJJJ-MM.txt    15-Minuten-Werte eines Monats, ROH (Ortszeit wie .61,
//                       mit einer Stunde Ueberhang in den Folgemonat)
// Ohne Netz, ohne .61. Fehlt ein Monat (Geschichte noch nicht nachgeholt:
// EBAKALL), sagt die Seite das.
//
// Gleiche Zeilen wie auf dem Core2: .61 liefert einen Bereich OHNE das Ende,
// fileExtract nimmt das Ende MIT. Darum endet jeder Bereich, der auf dem Core2
// "heute 00:00" hiess, hier um 23:59 des Vortags.
//
// Das Live-Diagramm der vier Wechselrichter steht in energy_dashboard.tc
// (Slot 0): die Firmware leitet jeden webOn-Endpunkt an Slot 0 weiter, egal
// wer ihn anmeldet -- /tc_array aus diesem Slot bekam nie eine Antwort.
//
// Nicht uebernommen: Hauptseiten-Tabelle (hat energy_dashboard.tc in Slot 0),
// Core2-Bildschirm, Ton, Daikin-Abfrage.
//
// ⚠️ RINGFORMEL: WebChart liest seit Firmware 24.06.2026 arr[(pos+i) % count].
// Der Core2 legt Tageswerte an [1..count] ab und liest mit pos = count+1 -- das
// letzte Feld [count] ist damit unerreichbar, statt ihm kommt [0]. Darum steht
// nach jedem Auszug der letzte Wert zusaetzlich in [0] (Wochentabelle, Tages-
// bilanz, 52 Wochen, 31 Tage), und die 168-Stunden-Linien lesen ab pos 1.
//
// HEIZUNG: Seit Oktober 2023 heizt die Waermepumpe (HWP), Gas steht auf 0. Die
// Warmwasser macht eine eigene Brauchwasser-WP (BWWP); Gas deckte frueher
// beides. Die Wochenseite zeigt darum neben Gas die SUMME beider als "Waerme"
// (Leistungslinie, Tagesbalken, Tabelle mit "Waerme E" zum Strompreis, das
// Gegenstueck zu "Gas E"). Der HWP-Zaehler meldet im Sommer 0, weil die HWP aus
// ist; sein Stand bleibt erhalten. fileExtract rechnete bei der Rueckkehr den
// ganzen Zaehlerstand als Tagesverbrauch (3498 kWh am 1.10.24). hwpDeltas()
// behandelt 0 als fehlend und rechnet vom letzten gueltigen Stand weiter.
//
// Zwei Fehler des Originals sind behoben: Woche, 52 Wochen und 31 Tage teilen
// sich die w_*-Felder, Tagesbilanz und Woche die wt_*-Felder; wer zuletzt lud,
// stand ungeprueft auf der anderen Seite. Jetzt merkt sich wFor/wtFor, wessen
// Daten gerade darin liegen. Und die Tagesbilanz las /daylog.txt, die es auf
// dem Core2 nie gab.
// ─────────────────────────────────────────────────────────────────────

#define PRICE_GAS_KWH  12     // cents per kWh (gas: cbm * 9.9 = kwh)
#define PRICE_STROM    40     // cents per kWh electricity (wie core2_energy.tc)
#define MLOG  "/energy_m_log.txt"
#define TMP15 "/ch15.txt"

// Schaltuhr Garage + Schlafzimmer G kommen per UDP (Seite "Andere Geraete")
global char tv2_ip[16];
global char sug_ip[16];

// ═══════════════════════════════════════════════════════════════════
// Felder -- wortgleich aus core2_energy.tc
// ═══════════════════════════════════════════════════════════════════
float t_wbx[97];
float t_wr1[97];
float t_wr2[97];
float t_wr3[97];
float t_wr4[97];
float t_hv[97];
float t_atmp[97];
float t_ktmp[97];
float t_ss[97];
float t_pw[97];
float t_hzwp[97];
float t_bwwp[97];
float t_ni[97];
float t_gas[97];
float t_wa[97];
float t_wpx[97];
float t_rain[97];

// ═══════════════════════════════════════════════════════════════════
// TIME-SERIES ARRAYS for weekly charts (168 = hours per week)
// ═══════════════════════════════════════════════════════════════════
float w_atmp[169];
float w_bwp[169];
float w_hwp[169];
float w_gwp[169];
float w_rain[169];
float w_pwl[169];
float w_sin[169];
float w_swa[169];
float w_hv[169];
float w_at[169];
float w_sk[169];
