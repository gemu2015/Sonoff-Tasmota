// =================================================================
// heatpump_test.tc — bare-minimum sniffer for .31 watchdog hunt
//
// Strict subset of heatpump_map_full.tc — strip everything that could
// possibly contribute to the multi-minute hangs we're chasing, leaving
// only:
//
//   • Modbus-RTU passive sniffer on auto-dir RS485 (RX=14, TX=15,
//     19200 8N2). Drains UART in Every50ms, frames on inter-byte
//     silence, parses FC03 REQ + RSP + merged shapes only.
//   • Known-register store (9 named regs) shown on Tasmota's main
//     web page via WebCall.
//   • Loop-task watchdog in TaskLoop: if Every50ms hasn't fired for
//     WDOG_LOOP_REBOOT_MS, log a banner and force `Restart 1`.
//
// Re-added incrementally now that the watchdog hunt is done (.31 stable):
//   • UDP-shared globals (aztemp/wtemp/ktmp/rtemp/hwp from other devices)
//   • UDP-broadcast publishing of HP state (hp_run/hp_in/hp_out/hp_at)
//   • Five neighbour-reading rows on the main page
//   • Embedded-write scanner (FC05/06/15/16 detection in parse_frame +
//     16-slot wlog ring buffer of {addr,val,ms,src} events)
//   • Command(MBUS …) — console control: MBUSON / MBUSOFF / MBUSSET <T> /
//     MBUSWRITES (dump captured writes); uses hp_send_modbus() helper
//   • LATENCY TRIPWIRE: per-callback this-boot peaks (cb_50_max_ms,
//     cb_web_max_ms, mb_max_ms) plus tick_gap_max_ms (gap between
//     consecutive Every50ms invocations) and long_call_warns counter.
//     Visible as the WDT-hunt row at the top of the main page. Tells
//     us *which* callback blocks before any real damage shows up. No
//     persist (this-boot only — keeps the script lean and avoids the
//     persist-hash invalidation pain of the full version).
//
// Still REMOVED from the original full version:
//   • JsonCall (no MQTT telemetry — user uses UDP only, never re-add)
//   • /tc_ui custom WebPage + chart history + diff snapshot
//   • Mailer / SendMail
//   • Pump-stuck heating watchdog (off/on cycling)
//   • persist'd diagnostic ring buffers (HPHIST — full version's wdog_hist[8])
//   • Frame logging
//
// If THIS build still hangs, the cause is in one of:
//   (a) the 50 ms UART drain itself (TasmotaSerial / serialAvailable /
//       serialRead),
//   (b) the FC03 parser,
//   (c) the WebCall row rendering,
//   (d) something in Tasmota outside TinyC entirely.
// And the watchdog catches all of those — Restart 1 within 60 s of
// the loop task going silent. =====================================

// ── UART / framing ─────────────────────────────────────────
int  rx_pin     = 14;
int  tx_pin     = 15;
int  baud       = 19200;
int  cfg        = 7;       // 8N2
int  ser        = -1;

// Frame buffer
char buf[260];
int  buf_len    = 0;

// Per-tick byte cap — at 19200 8N2 max ~95 B can arrive in 50 ms;
// 256 covers a single tick's worth even with PSRAM-driven jitter.
int  E50_MAX_BYTES_PER_TICK = 256;

// ── Register store ────────────────────────────────────────
// 500 covers 0..338 + 432..493 with headroom (matches what the cloud
// poll cycle reads — see heatpump_map_full.tc header for the block list).
int  reg[500];
int  known[500];

// Counters (only the ones rendered on the main page or the watchdog
// banner — skip the `bytes_seen / e50_bytes_max / long_call_warns`
// instrumentation forest from the full version).
int  frames_seen   = 0;
int  rsp_parsed    = 0;
int  rsp_failed    = 0;

// Most recent FC03 REQ kept around to pair with a lone RSP that arrives
// in the next tick's frame (the silence detector occasionally splits
// REQ and RSP across ticks even though they're <1 ms apart on the wire).
int  last_req_addr = -1;
int  last_req_qty  = 0;

// ── Watchdog ──────────────────────────────────────────────
// last_50ms_run_ms is updated at the top of every Every50ms tick.
// TaskLoop runs in tc_vm_task (a separate FreeRTOS task), so even
// if the Tasmota loop task is hung — which is what stopped Every50ms
// firing — TaskLoop keeps running and can act.
//
// 60 s is a long-enough silence to avoid false trips during e.g.
// OTA, but short enough that .31's "stuck for minutes" failure mode
// is recovered automatically rather than waiting for the user to
// notice the device is unreachable.
#define WDOG_LOOP_REBOOT_MS 60000
int  last_50ms_run_ms      = 0;
int  last_task_loop_run_ms = 0;
int  wdog_loop_trips       = 0;
int  wdog_last_silent_ms   = 0;

// ── Latency tripwire ──────────────────────────────────────
// Per-callback this-boot peaks. Updated at the bottom of each
// instrumented callback; never decrement → "max ever seen since
// boot". Rendered on the main page as the first row so it's
// always visible even if a later sprintf throws. Use HPLATRESET
// console subcommand to zero them between experiments without
// rebooting.
//
// tick_gap_max_ms is the OUTSIDE measure: how long between
// consecutive Every50ms invocations. If it spikes while every
// callback's own duration stays small, the blocker is *outside*
// TinyC (Tasmota's own loop task held by lwIP / web / MQTT, OR
// a long syscall holding vm_mutex). That's the signal that
// caught the /tc HTTPS stall on .31 in the original hunt.
int  cb_50_max_ms     = 0;     // Every50ms peak
int  cb_web_max_ms    = 0;     // WebCall peak
int  mb_max_ms        = 0;     // hp_send_modbus peak
int  tick_gap_max_ms  = 0;     // gap between Every50ms ticks
int  long_call_warns  = 0;     // count of CRIT / slow log lines emitted
// cb_active_id is set at callback entry, cleared at exit. Not
// rendered yet — it'll matter once EverySecond / JsonCall / WebUI
// are re-added so a future trip handler can identify which
// callback was holding the mutex when the freeze began.
//   1=Every50ms  2=EverySecond  3=WebCall  4=JsonCall  0=between
int  cb_active_id     = 0;

// Warning thresholds. WARN logs once per occurrence + bumps
// long_call_warns; CRIT does the same with a louder banner.
// 5000 ms is Tasmota's RTC-WDT trip window — we want to see CRIT
// log lines *before* hitting it.
#define LONG_CALL_WARN_MS 1000
#define LONG_CALL_CRIT_MS 3000

// Scratch buffer for the latency log lines. Sized for the longest
// expected message; reusing one global keeps sprintf out of the
// stack at every callback exit.
char g_tmp[120];

// ── Embedded-write capture (FC05/06/15/16) ───────────────────
// When the cloud (or a panel) writes to the heat pump, the register
// address tells us what control we'd target ourselves. Cloud often
// piggybacks an FC06 write within <4 ms of a prior FC03 poll tail —
// our silence-based framer hands those to us as one merged buffer,
// which is why the scan walks the WHOLE buffer in parse_frame, not
// just the prefix.
int  writes_seen     = 0;
int  last_write_addr = -1;
int  last_write_val  = 0;
int  last_write_ms   = 0;

// 16-slot circular log of write events (own + observed). Small
// footprint (16 × 4 ints). 'src' = 'O' (observed off-bus), 'M' (me —
// this script's hp_send_modbus call).
struct WriteEvent {
    int  addr;
    int  val;
    int  ms;
    char src;
}
WriteEvent wlog[16];
int  wlog_pos   = 0;
int  wlog_count = 0;

void wlog_push(int addr, int val, char src) {
    int p = wlog_pos;
    wlog[p].addr = addr;
    wlog[p].val  = val;
    wlog[p].ms   = millis();
    wlog[p].src  = src;
    wlog_pos = (p + 1) % 16;
    if (wlog_count < 16) wlog_count = wlog_count + 1;
}

// ── UDP-shared globals from other Tasmota devices ────────────
// `global float` = auto-syncs via UDP multicast 239.255.255.250:1999.
// Initial values are sane defaults until first packet arrives. Names must
// match exactly what the publishing devices send.
global float aztemp = 20.0;   // Schlafzimmer (sleeping room) °C
global float wtemp  = 20.0;   // Wohnzimmer (living room) °C
global float ktmp   = 14.0;   // Keller (cellar — typically colder) °C
global float rtemp  = 10.0;   // Außentemperatur (Bresser sensor) °C
global float hwp    =  0.0;   // Heat-pump current power consumption (W)

// Heat-pump live state — broadcast when store_reg() lands a value on
// the matching Modbus register. Lets other devices on the LAN
// (energy_dashboard, sub-displays, etc.) show the heat-pump's own
// readings without each having to talk Modbus.
global float hp_run  = 0.0;   // 1.0 = running, 0.0 = off  (from r217 enum)
global float hp_in   = 0.0;   // Water back from heating circuit / Puffer (°C, r188)
global float hp_out  = 0.0;   // Supply water / Ausgangstemp (°C, r191)
global float hp_at   = 0.0;   // Outside-air sensor on the HP itself (°C, r190)

// ── Modbus CRC16 (poly 0xA001) ────────────────────────────
int modbus_crc16(char b[], int len) {
    int crc = 0xFFFF;
    for (int i = 0; i < len; i++) {
        crc = crc ^ (b[i] & 0xFF);
        for (int j = 0; j < 8; j++) {
            if (crc & 1) crc = (crc >> 1) ^ 0xA001;
            else         crc = (crc >> 1);
        }
    }
    return crc & 0xFFFF;
}

// ── Store one register reading ────────────────────────────
void store_reg(int addr, int val) {
    if (addr < 0 || addr >= 500) return;
    known[addr] = 1;
    reg[addr]   = val;

    // Mirror the four headline registers onto UDP-broadcast globals so
    // neighbour scripts (energy_dashboard, sub-displays, etc.) see fresh
    // values without polling Modbus themselves. Sign-extension matches
    // the parsing in WebCall: r188 / r190 / r191 are signed ×10 °C;
    // r217 is an enum (0=boot, 1=running, 6=remote-off).
    if (addr == 188 || addr == 190 || addr == 191) {
        int s = val & 0xFFFF;
        if (s >= 32768) s = s - 65536;
        float t = s / 10.0;
        if      (addr == 188) hp_in  = t;
        else if (addr == 190) hp_at  = t;
        else if (addr == 191) hp_out = t;
    } else if (addr == 217) {
        hp_run = ((val & 0xFFFF) == 1) ? 1.0 : 0.0;
    }
}

// ── Parse one frame (FC03 read + embedded FC05/06/15/16 write scan) ─
//
// Three shapes for slave=1 fc=3 frames:
//   A) Lone 8-byte REQ            → record addr/qty for next RSP
//   B) Lone RSP (5 + 2N bytes)    → pair with last_req_*
//   C) Merged REQ+RSP (8 + 5+2N)  → start with REQ, parse trailing RSP
// Anything else is silently ignored on the FC03 path.
//
// In addition, the WHOLE buffer is scanned for embedded write frames
// (FC05/06/15/16) because cloud writes often piggyback within <4 ms
// of an FC03 poll tail and end up in the same merged buffer. CRC
// validation on the fixed-length FC05/FC06 frames eliminates the
// false positives that random bytes inside FC03 response payload
// would otherwise produce. Variable-length FC15/FC16 frames keep a
// weaker (qty range) sanity check.
//
// Fast-path: if the frame starts with `01 03` AND its size matches
// one of the three valid pure-FC03 patterns exactly, skip the embedded
// write scan — there's nothing piggybacking and the scan would be a
// pointless 200+ iteration walk over response data.
//
// FC03 itself: skip CRC validation — the silence-based delimiter
// already gates noise out. Corruption shows up as `rsp_failed` on
// the main page.
void parse_frame() {
    if (buf_len < 5) return;
    int sl = buf[0] & 0xFF;
    int fc = buf[1] & 0xFF;

    // Fast-path heuristic for the embedded-write scan.
    int skip_write_scan = 0;
    if (sl == 1 && fc == 0x03) {
        if (buf_len == 8) {
            skip_write_scan = 1;            // lone REQ
        } else if (buf_len >= 5) {
            int bc_rsp = buf[2] & 0xFF;
            if (buf_len == 5 + bc_rsp) {
                skip_write_scan = 1;        // lone RSP
            } else if (buf_len >= 16) {
                int req_qty   = ((buf[4] & 0xFF) << 8) | (buf[5] & 0xFF);
                int bc_merged = (buf[10] & 0xFF);
                if (buf_len == 13 + bc_merged && bc_merged == req_qty * 2) {
                    skip_write_scan = 1;    // merged REQ + RSP, exact size
                }
            }
        }
    }

    // ── Embedded-write scan ───────────────────────────────────
    char crc_buf[6];
    for (int i = 0; !skip_write_scan && i + 8 <= buf_len; i++) {
        int s2 = buf[i]   & 0xFF;
        int f2 = buf[i+1] & 0xFF;
        if (s2 != 1) continue;              // only slave 1 commands matter

        // Validate CRC for fixed-length FC05/FC06 frames.
        int crc_ok = 0;
        if (f2 == 0x05 || f2 == 0x06) {
            for (int k = 0; k < 6; k++) crc_buf[k] = buf[i+k] & 0xFF;
            int expected = modbus_crc16(crc_buf, 6);
            int got = ((buf[i+7] & 0xFF) << 8) | (buf[i+6] & 0xFF);
            if (expected == got) crc_ok = 1;
        }

        if (f2 == 0x05 && crc_ok) {
            // FC05: write single coil; val must be 0xFF00 or 0x0000
            int waddr = ((buf[i+2] & 0xFF) << 8) | (buf[i+3] & 0xFF);
            int wval  = ((buf[i+4] & 0xFF) << 8) | (buf[i+5] & 0xFF);
            if (waddr < 1000 && (wval == 0xFF00 || wval == 0x0000)) {
                last_write_addr = waddr;
                last_write_val  = wval;
                last_write_ms   = millis();
                writes_seen     = writes_seen + 1;
                wlog_push(waddr, wval, 'O');
                char w[120];
                char st[8];
                if (wval == 0xFF00) strcpy(st, "ON"); else strcpy(st, "OFF");
                sprintf(w, "*** WRITE FC05 (coil) *** addr=%d (0x%04x) -> %s",
                        waddr, waddr, st);
                addLog(w);
            }
        } else if (f2 == 0x06 && crc_ok) {
            int waddr = ((buf[i+2] & 0xFF) << 8) | (buf[i+3] & 0xFF);
            int wval  = ((buf[i+4] & 0xFF) << 8) | (buf[i+5] & 0xFF);
            if (waddr < 1000) {
                last_write_addr = waddr;
                last_write_val  = wval;
                last_write_ms   = millis();
                writes_seen     = writes_seen + 1;
                wlog_push(waddr, wval, 'O');
                char w[120];
                sprintf(w, "*** WRITE FC06 (reg) *** addr=%d (0x%04x) val=%d (0x%04x)",
                        waddr, waddr, wval, wval);
                addLog(w);
            }
        } else if (f2 == 0x0F && i + 9 <= buf_len) {
            int waddr = ((buf[i+2] & 0xFF) << 8) | (buf[i+3] & 0xFF);
            int wqty  = ((buf[i+4] & 0xFF) << 8) | (buf[i+5] & 0xFF);
            if (waddr < 1000 && wqty > 0 && wqty < 256) {
                last_write_addr = waddr;
                last_write_ms   = millis();
                writes_seen     = writes_seen + 1;
                wlog_push(waddr, wqty, 'O');
                char w[120];
                sprintf(w, "*** WRITE FC15 (coils) *** addr=%d qty=%d", waddr, wqty);
                addLog(w);
            }
        } else if (f2 == 0x10 && i + 9 <= buf_len) {
            int waddr = ((buf[i+2] & 0xFF) << 8) | (buf[i+3] & 0xFF);
            int wqty  = ((buf[i+4] & 0xFF) << 8) | (buf[i+5] & 0xFF);
            if (waddr < 1000 && wqty > 0 && wqty < 32) {
                last_write_addr = waddr;
                last_write_ms   = millis();
                writes_seen     = writes_seen + 1;
                wlog_push(waddr, wqty, 'O');
                char w[120];
                sprintf(w, "*** WRITE FC16 (regs) *** addr=%d qty=%d", waddr, wqty);
                addLog(w);
            }
        }
    }

    if (sl != 1 || fc != 0x03) return;      // only slave 1 FC03 carries our data

    // Case A: lone REQ
    if (buf_len == 8) {
        last_req_addr = ((buf[2] & 0xFF) << 8) | (buf[3] & 0xFF);
        last_req_qty  = ((buf[4] & 0xFF) << 8) | (buf[5] & 0xFF);
        return;
    }

    // Case C: merged REQ + RSP
    if (buf_len >= 15) {
        int req_addr = ((buf[2] & 0xFF) << 8) | (buf[3] & 0xFF);
        int req_qty  = ((buf[4] & 0xFF) << 8) | (buf[5] & 0xFF);
        int rsp_off  = 8;
        if ((buf[rsp_off] & 0xFF) == 1 && (buf[rsp_off+1] & 0xFF) == 0x03) {
            int bc = buf[rsp_off+2] & 0xFF;
            if (bc == req_qty * 2 && buf_len >= rsp_off + 3 + bc) {
                for (int r = 0; r < req_qty; r++) {
                    int hi = buf[rsp_off + 3 + r*2] & 0xFF;
                    int lo = buf[rsp_off + 4 + r*2] & 0xFF;
                    store_reg(req_addr + r, (hi << 8) | lo);
                }
                rsp_parsed = rsp_parsed + 1;
                return;
            }
        }
    }

    // Case B: lone RSP — pair with most recent REQ
    if (last_req_addr >= 0 && buf_len >= 5) {
        int bc = buf[2] & 0xFF;
        if (bc == last_req_qty * 2 && buf_len >= 3 + bc) {
            for (int r = 0; r < last_req_qty; r++) {
                int hi = buf[3 + r*2] & 0xFF;
                int lo = buf[4 + r*2] & 0xFF;
                store_reg(last_req_addr + r, (hi << 8) | lo);
            }
            rsp_parsed    = rsp_parsed + 1;
            last_req_addr = -1;
            return;
        }
    }

    rsp_failed = rsp_failed + 1;
}

// ── Flush completed frame ─────────────────────────────────
void flush_frame() {
    if (buf_len == 0) return;
    frames_seen = frames_seen + 1;
    parse_frame();
    buf_len = 0;
}

// ── Every50ms — UART drain + silence-based framing ────────
void Every50ms() {
    cb_active_id = 1;
    int t_now = millis();

    // Tick-gap tripwire: in steady state Tasmota fires
    // FUNC_EVERY_50_MSECOND every ~50 ms (give or take Wi-Fi
    // jitter). A gap >> 50 ms means the loop task was held by
    // *something* — possibly a syscall in this script holding
    // vm_mutex, possibly a long Tasmota internal call. Captured
    // here at callback entry so the peak survives even if the
    // current tick itself runs fast.
    if (last_50ms_run_ms > 0) {
        int gap = t_now - last_50ms_run_ms;
        if (gap > tick_gap_max_ms) tick_gap_max_ms = gap;
    }
    last_50ms_run_ms = t_now;

    if (ser < 0) { cb_active_id = 0; return; }

    int avail = serialAvailable(ser);
    int got   = 0;
    int b;
    while (avail > 0 && got < E50_MAX_BYTES_PER_TICK) {
        b = serialRead(ser);
        if (b < 0) break;
        if (buf_len < 256) {
            buf[buf_len] = b;
            buf_len = buf_len + 1;
        }
        avail = avail - 1;
        got   = got + 1;
        if (buf_len >= 256) break;
    }
    if (got == 0 && buf_len > 0) {
        // No new bytes this tick + we have data → end of frame
        flush_frame();
    }

    // Per-tick duration peak. parse_frame is the heavyweight here
    // (256-byte embedded-write scan worst case) so a spike here
    // points at a specific frame shape that's slow.
    int dt = millis() - t_now;
    if (dt > cb_50_max_ms) cb_50_max_ms = dt;
    if (dt > LONG_CALL_CRIT_MS) {
        long_call_warns = long_call_warns + 1;
        sprintf(g_tmp, "Every50ms ⚠ CRIT %d ms", dt);
        addLog(g_tmp);
    } else if (dt > LONG_CALL_WARN_MS) {
        long_call_warns = long_call_warns + 1;
        sprintf(g_tmp, "Every50ms ⚠ slow %d ms", dt);
        addLog(g_tmp);
    }
    cb_active_id = 0;
}

// ── TaskLoop — loop-task watchdog ─────────────────────────
//
// Runs in tc_vm_task (own FreeRTOS task). If Tasmota's main loop
// hangs, Every50ms stops firing → last_50ms_run_ms goes stale →
// after WDOG_LOOP_REBOOT_MS (60 s) we force `Restart 1`.
//
// delay() yields the vm_mutex, so other callbacks can interleave
// during the 1 s sleep between checks.
void TaskLoop() {
    last_task_loop_run_ms = millis();

    // Skip the watchdog until Every50ms has fired at least once
    // (avoids tripping during very early boot before Tasmota's
    // FUNC_EVERY_50_MSECOND dispatcher comes online).
    if (last_50ms_run_ms > 0) {
        int silent = millis() - last_50ms_run_ms;
        if (silent > WDOG_LOOP_REBOOT_MS) {
            wdog_loop_trips     = wdog_loop_trips + 1;
            wdog_last_silent_ms = silent;
            char m[120];
            sprintf(m, "WDOG ⚠ loop task silent for %d ms — forcing Restart 1 (trips=%d)",
                    silent, wdog_loop_trips);
            addLog(m);
            // Give the log a beat to reach serial console (web log
            // is RAM-only — won't survive the reboot).
            delay(500);
            char resp[16];
            tasmCmd("Restart 1", resp);
            // Restart 1 is async; sleep so we don't loop on the trip.
            delay(5000);
        }
    }

    // 1 s cadence is plenty — the threshold is 60 s.
    delay(1000);
}

// ── Helper: format signed ×10 register as "%.1f" ──────────
void fmt_signed_x10(int addr, char unit[], char out[]) {
    if (known[addr] == 0) {
        strcpy(out, "—");
        return;
    }
    int s = reg[addr] & 0xFFFF;
    if (s >= 32768) s = s - 65536;
    float v = s / 10.0;
    sprintf(out, "%.1f %s", v, unit);
}

void fmt_unsigned_x10(int addr, char unit[], char out[]) {
    if (known[addr] == 0) {
        strcpy(out, "—");
        return;
    }
    int u = reg[addr] & 0xFFFF;
    float v = u / 10.0;
    sprintf(out, "%.1f %s", v, unit);
}

// ── hp_send_modbus — TX an FC05 / FC06 write frame ────────
//
// Build the 8-byte frame, listen-before-talk for ≥4 ms bus silence
// (Modbus 3.5-char inter-frame gap at 19200 baud + margin), TX, then
// wait ~10 ms for the TX FIFO to drain so the slave recognises the
// frame end. Bus has a 1 Hz cadence (cloud polls one block per second;
// each burst is ~50-100 ms followed by ~900 ms of silence) so the
// quiet-window wait almost always returns within tens of ms.
//
// Return: 1 on success, 0 if serial isn't open. The wait-cap of 1500 ms
// is per-call worst case; while we're inside this function the loop
// task is blocked, so don't call it from a tick. It's only invoked from
// Command (synchronous user-issued console command).
int hp_send_modbus(int fc, int regaddr, int val) {
    if (ser < 0) {
        addLog("hp_send_modbus: serial not open");
        return 0;
    }
    int t_mb = millis();

    char frame[8];
    frame[0] = 1;
    frame[1] = fc & 0xFF;
    frame[2] = (regaddr >> 8) & 0xFF;
    frame[3] = regaddr & 0xFF;
    frame[4] = (val >> 8) & 0xFF;
    frame[5] = val & 0xFF;
    int crc  = modbus_crc16(frame, 6);
    frame[6] = crc & 0xFF;            // Modbus CRC: low byte first on wire
    frame[7] = (crc >> 8) & 0xFF;

    // Listen-before-talk: drain any in-flight bytes into the framing
    // buffer (let Every50ms parse them next tick), reset the silence
    // timer when activity is seen, exit when 4 ms quiet — capped at
    // 1500 ms total.
    int q_start  = millis();
    int wait_cap = millis() + 1500;
    while (millis() < wait_cap) {
        if (serialAvailable(ser) > 0) {
            while (serialAvailable(ser) > 0) {
                int discard = serialRead(ser);
                if (buf_len < 256) { buf[buf_len] = discard; buf_len = buf_len + 1; }
            }
            q_start = millis();
        }
        if (millis() - q_start >= 4) break;
        delay(1);
    }

    for (int i = 0; i < 8; i++) {
        serialWriteByte(ser, frame[i] & 0xFF);
    }
    delay(10);                        // TX FIFO drain + Modbus inter-frame gap

    wlog_push(regaddr, val, 'M');
    char m[120];
    sprintf(m, "hp_send_modbus: fc=%02x reg=%d val=%d (0x%04x)",
            fc, regaddr, val, val);
    addLog(m);

    // Listen-before-talk wait + TX FIFO drain can run up to ~1.5 s on
    // a busy bus. Track the peak so we know whether MBUS commands are
    // a viable WDT-trip suspect.
    int dt_mb = millis() - t_mb;
    if (dt_mb > mb_max_ms) mb_max_ms = dt_mb;
    if (dt_mb > LONG_CALL_CRIT_MS) {
        long_call_warns = long_call_warns + 1;
        sprintf(g_tmp, "hp_send_modbus ⚠ CRIT %d ms", dt_mb);
        addLog(g_tmp);
    } else if (dt_mb > LONG_CALL_WARN_MS) {
        long_call_warns = long_call_warns + 1;
        sprintf(g_tmp, "hp_send_modbus ⚠ slow %d ms", dt_mb);
        addLog(g_tmp);
    }
    return 1;
}

// ── Command(MBUS …) — console control + write log dump ────
//
// Subcommands (all prefixed with "MBUS" by addCommand("MBUS") in main):
//   MBUSON          FC05 coil 40 = 0xFF00   (heat-pump ON)
//   MBUSOFF         FC05 coil 40 = 0x0000   (heat-pump OFF)
//   MBUSSET <T>     FC06 r1 = T*10          (target water temp 10..60 °C)
//   MBUSWRITES      Dump captured FC05/06/15/16 events (own + observed)
//   MBUSLATRESET    Zero the latency tripwire peaks (gap/e50/web/mb/warns).
//                   Use between experiments so a brief earlier spike doesn't
//                   stay pinned to the WDT-hunt row forever.
//
// Every branch (including the "?" fallback) MUST call responseCmnd —
// otherwise Tasmota emits {"Command":"Error",...} regardless of what
// the script actually did. (See TinyC CLAUDE.md anti-pattern #2.)
void Command(char cmd[]) {
    char resp[200];

    if (strFind(cmd, "ON") == 0 && strlen(cmd) == 2) {
        if (hp_send_modbus(0x05, 40, 0xFF00)) {
            responseCmnd("HP ON sent (FC05 coil 40 = 0xFF00)");
        } else {
            responseCmnd("HP ON FAILED");
        }
        return;
    }

    if (strFind(cmd, "OFF") == 0 && strlen(cmd) == 3) {
        if (hp_send_modbus(0x05, 40, 0x0000)) {
            responseCmnd("HP OFF sent (FC05 coil 40 = 0x0000)");
        } else {
            responseCmnd("HP OFF FAILED");
        }
        return;
    }

    if (strFind(cmd, "SET ") == 0) {
        // MBUSSET <T>  — write target water temp to r1, scaled ×10.
        // TinyC atoi() needs a char[] (no pointer arithmetic); copy the
        // digits after "SET " into a small buffer first.
        char arg[16];
        int n = strlen(cmd);
        int j = 0;
        for (int i = 4; i < n; i++) {
            if (j < 15) { arg[j] = cmd[i]; j = j + 1; }
        }
        arg[j] = 0;
        int t10 = atoi(arg) * 10;
        if (t10 < 100 || t10 > 600) {
            sprintf(resp, "MBUSSET: out of range (10..60 C), got %d", t10/10);
            responseCmnd(resp);
        } else if (hp_send_modbus(0x06, 1, t10)) {
            sprintf(resp, "HP target %d.0 C sent (FC06 r1=%d)", t10/10, t10);
            responseCmnd(resp);
        } else {
            responseCmnd("MBUSSET FAILED");
        }
        return;
    }

    if (strFind(cmd, "LATRESET") == 0 && strlen(cmd) == 8) {
        cb_50_max_ms    = 0;
        cb_web_max_ms   = 0;
        mb_max_ms       = 0;
        tick_gap_max_ms = 0;
        long_call_warns = 0;
        responseCmnd("latency peaks reset");
        return;
    }

    if (strFind(cmd, "WRITES") == 0 && strlen(cmd) == 6) {
        // Dump the 16-slot wlog ring, newest first. Output goes BOTH via
        // responseCmnd (for /cm HTTP API consumers, capped to ~700 B for
        // Tasmota's MQTT payload limit even though we don't use MQTT —
        // it's the same response buffer) AND via addLog (full set,
        // visible at /cs).
        char hbuf[720];
        sprintf(hbuf, "writes seen=%d (last 16 events, newest first):\n", writes_seen);
        if (wlog_count == 0) {
            strcat(hbuf, "  (none)");
            responseCmnd(hbuf);
            return;
        }
        int now = millis();
        for (int n = 0; n < wlog_count; n = n + 1) {
            int slot = (wlog_pos - 1 - n) & 15;
            int age = now - wlog[slot].ms;
            char src_str[8];
            if (wlog[slot].src == 'M') strcpy(src_str, "ME"); else strcpy(src_str, "OBS");
            sprintf(resp, "  [%d] %s addr=%d val=%d (0x%04x) age=%dms",
                    n, src_str, wlog[slot].addr, wlog[slot].val, wlog[slot].val, age);
            addLog(resp);
            if (strlen(hbuf) + strlen(resp) + 2 < 700) {
                strcat(hbuf, resp);
                strcat(hbuf, "\n");
            }
        }
        responseCmnd(hbuf);
        return;
    }

    // Unknown subcommand — ALWAYS respond, never silently fall through.
    sprintf(resp, "MBUS: unknown subcmd '%s' (try ON/OFF/SET <T>/WRITES/LATRESET)", cmd);
    responseCmnd(resp);
}

// ── WebCall — render rows on Tasmota's main page ──────────
//
// Tasmota's main-page sensor list. webSend("{s}…{m}…{e}") wraps each
// row in the standard table cells (label / value). One row per
// known register; one diagnostic row at the bottom.
void WebCall() {
    cb_active_id = 3;
    int t_web = millis();
    char val[40];
    char row[160];

    // ── Latency tripwire ROW — first thing rendered so it's always visible.
    //    Maxima persist across page refreshes (this-boot only — no persist).
    //    Use HPLATRESET to zero them. Each value is the peak-ever observed:
    //      gap   = longest interval between consecutive Every50ms ticks
    //      e50   = slowest single Every50ms callback
    //      web   = slowest single WebCall (incl. this row's own renders)
    //      mb    = slowest hp_send_modbus (listen-before-talk + TX drain)
    //      warns = total CRIT/slow log lines emitted since boot
    sprintf(row, "{s}<b style='color:#a85;'>WDT-hunt</b>{m}gap=%d  e50=%d  web=%d  mb=%d  warns=%d{e}",
            tick_gap_max_ms, cb_50_max_ms, cb_web_max_ms, mb_max_ms, long_call_warns);
    webSend(row);

    // State (r217: 0=boot, 1=running, 6=remote-off)
    if (known[217]) {
        int st = reg[217] & 0xFFFF;
        char label[16];
        if      (st == 1) strcpy(label, "running");
        else if (st == 6) strcpy(label, "remote-off");
        else if (st == 0) strcpy(label, "boot");
        else              sprintf(label, "%d", st);
        sprintf(row, "{s}HP State{m}%s{e}", label);
        webSend(row);
    } else {
        webSend("{s}HP State{m}—{e}");
    }

    fmt_signed_x10(1,   "°C",  val); sprintf(row, "{s}Zieltemp{m}%s{e}",      val); webSend(row);
    fmt_signed_x10(188, "°C",  val); sprintf(row, "{s}Puffer{m}%s{e}",        val); webSend(row);
    fmt_signed_x10(190, "°C",  val); sprintf(row, "{s}Aussen{m}%s{e}",        val); webSend(row);
    fmt_signed_x10(191, "°C",  val); sprintf(row, "{s}Ausgang{m}%s{e}",       val); webSend(row);
    fmt_signed_x10(192, "°C",  val); sprintf(row, "{s}Ansauggas{m}%s{e}",     val); webSend(row);
    fmt_signed_x10(206, "°C",  val); sprintf(row, "{s}Verdampfer{m}%s{e}",    val); webSend(row);
    fmt_unsigned_x10(193, "bar", val); sprintf(row, "{s}Saugdruck{m}%s{e}",   val); webSend(row);
    fmt_unsigned_x10(194, "bar", val); sprintf(row, "{s}Auslassdruck{m}%s{e}",val); webSend(row);

    // ── Neighbour-device readings (UDP-shared globals) ───────
    // Refresh from whatever has been received via the UDP multicast
    // bus since boot. Defaults stay until the first packet arrives.
    sprintf(row, "{s}Wohnzimmer{m}%.1f &deg;C{e}",   wtemp);  webSend(row);
    sprintf(row, "{s}Schlafzimmer{m}%.1f &deg;C{e}", aztemp); webSend(row);
    sprintf(row, "{s}Keller{m}%.1f &deg;C{e}",       ktmp);   webSend(row);
    sprintf(row, "{s}Au&szlig;en (Bresser){m}%.1f &deg;C{e}", rtemp); webSend(row);
    sprintf(row, "{s}HP Leistung{m}%.0f W{e}",       hwp);    webSend(row);

    // Diagnostic row — frames seen, RSP parsed, RSP failed, write events
    // seen, watchdog trips, ms since last Every50ms tick. The silent value
    // should always be tiny (<100 ms) when the device is healthy; a number
    // creeping up means the loop task is stalling and we're heading toward
    // a watchdog trip.
    int silent = (last_50ms_run_ms > 0) ? (millis() - last_50ms_run_ms) : -1;
    sprintf(row, "{s}MB diag{m}f=%d ok=%d bad=%d w=%d wdog=%d silent=%d ms{e}",
            frames_seen, rsp_parsed, rsp_failed, writes_seen,
            wdog_loop_trips, silent);
    webSend(row);

    // Per-WebCall duration peak. Tasmota's /tc?m=1 AJAX poll fires
    // this at a few-Hz cadence — if web peak grows over time, it's
    // either heap fragmentation slowing sprintf/webSend or one of
    // the future features (charts, render_named) gone wrong.
    int dt_web = millis() - t_web;
    if (dt_web > cb_web_max_ms) cb_web_max_ms = dt_web;
    if (dt_web > LONG_CALL_CRIT_MS) {
        long_call_warns = long_call_warns + 1;
        sprintf(g_tmp, "WebCall ⚠ CRIT %d ms", dt_web);
        addLog(g_tmp);
    } else if (dt_web > LONG_CALL_WARN_MS) {
        long_call_warns = long_call_warns + 1;
        sprintf(g_tmp, "WebCall ⚠ slow %d ms", dt_web);
        addLog(g_tmp);
    }
    cb_active_id = 0;
}

// ── main — open serial, exit ──────────────────────────────
int main() {
    char m0[80];
    sprintf(m0, "heatpump_test: opening serial at uptime %d s", tasm_uptime);
    addLog(m0);

    ser = serialBegin(rx_pin, tx_pin, baud, cfg, 1024);
    if (ser < 0) {
        addLog("heatpump_test: serialBegin FAILED");
        return 0;
    }
    char m[120];
    sprintf(m, "heatpump_test ready: ser=%d rx=%d tx=%d baud=%d 8N2 watchdog=%d ms",
            ser, rx_pin, tx_pin, baud, WDOG_LOOP_REBOOT_MS);
    addLog(m);

    // Register console-command prefix. With "MBUS" registered, Tasmota
    // routes any command starting with MBUS to our Command(cmd) callback,
    // passing the suffix as `cmd` (e.g. user types "MBUSSET 32" → cmd="SET 32").
    addCommand("MBUS");

    // UDP globals (aztemp/wtemp/...) auto-sync via the multicast bus —
    // no setup call needed. WebCall renders the main page on demand.
    // TaskLoop watches the tick from its own FreeRTOS task.
    return 0;
}
