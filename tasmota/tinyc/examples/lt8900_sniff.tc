// ============================================================================
// lt8900_sniff.tc — GM2.4G-Deckenlampe mit einem nRF24L01 MITHÖREN
// ============================================================================
//
// Zweck: die aus dem SPI-Mitschnitt abgeleiteten Annahmen gegen die echte
// Funkstrecke prüfen, BEVOR wir selbst senden. Die Fernbedienung funktioniert
// ja noch — wir haben also einen unbestechlichen Testfall: Wir wissen bereits,
// was im Paket stehen MUSS (siehe a7105_gm24g.tc):
//
//     07  5A 4B 07 01  CC  VV  SUM      SUM = (0xB4 + CC + VV) & 0xFF
//
// Taucht genau das auf, stimmt alles. Taucht es nicht auf, stimmt etwas nicht —
// und wir sehen an den Rohbits, was.
//
// ── WARUM DAS MIT EINEM nRF24 GEHT ─────────────────────────────────────────
// Der Sender ist ein LT8900 (kein A7105!). Das DIY-Multiprotocol-Projekt zeigt,
// dass sich ein LT8900 mit einem nRF24L01 nachbilden lässt: Beide senden GFSK
// mit 1 Mbit/s; man legt Präambel + Syncword des LT8900 in das ADRESSFELD des
// nRF24, weil der Chip darauf matched, schaltet dessen CRC ab und dreht die
// Bitreihenfolge der Nutzlast um.
//   Quelle: DIY-Multiprotocol-TX-Module/Multiprotocol/NRF24l01_SPI.ino
//
// WICHTIG — Frequenzversatz: nRF24 sendet auf 2400+Kanal, LT8900 auf
// 2402+Kanal. Die Lampenkanäle 4/39/74 sind also nRF24-Kanäle 6/41/76.
//
// ── GEMESSENE PARAMETER (HackRF, 2026-07-28) ──────────────────────────────
// Nicht mehr geraten, sondern aus der Luft gemessen:
//   Frequenz  2441.02 MHz  = LT8900-Kanal 39  -> Abbildung 2402+n BESTAETIGT
//   Datenrate 1 Mbit/s
//   Praeambel 0x55 (mehrfach)
//   SYNCWORD AUF DER LUFT: 8A 85 5A AA
//   Nutzlast bitgedreht (LSB zuerst), danach Laengenbyte + 6 Bytes + Summe
//   Dekodiert: 07 5A 4B 07 00 0E DA 9B  (ID 5A 4B 07 wie im SPI-Dump vom Mai)
//   25 von 28 Bursts mit gueltiger Pruefsumme.
// Der nRF24 bekommt Praeambel+Syncword als ADRESSE, in umgekehrter Bytefolge:
//   auf der Luft   55 8A 85 5A AA
//   ins Register   AA 5A 85 8A 55
//
// ── STRATEGIE: ROHMITSCHNITT STATT RATEN (historisch, siehe SNIFSCAN) ──────
// Unbekannt sind noch die genaue Syncword-Länge und die Präambellänge (Reg 32
// der Lampe ist 0x4800, die Bibliothek nutzt 0x5000 — das Feld unterscheidet
// sich). Statt Kandidaten durchzuprobieren, matchen wir NUR auf die Präambel
// (0x55/0xAA, die kennen wir sicher) und lassen alles danach als Nutzlast
// durchlaufen. Das komplette Syncword steht dann mit im Mitschnitt und wird
// abgelesen statt geraten.
//
// ── VERDRAHTUNG (.177, ESP32-Bridge) ───────────────────────────────────────
//   Tasmota-UI belegt bereits:  9 = MOSI, 10 = SCLK, 11 = MISO
//   Hier gesetzt:               7 = CSN des nRF24L01
//   Hier gesetzt:               8 = CE des nRF24L01
//   (CE dauerhaft high waere zum Mithoeren auch ok, aber mit GPIO flexibler)
//   ⚠️ 10–100 µF Elko direkt am Modul zwischen VCC und GND, sonst bricht die
//      Versorgung ein und das Modul verhält sich sporadisch.
//   ⚠️ Der CC1101 (CS 13) haengt am SELBEN MISO. Sein CS muss aktiv auf HIGH
//      gelegt werden, sonst treibt er die Leitung mit und der Bus liefert nur
//      Muell. "Nicht anfassen" reicht NICHT — ein undefinierter Eingang ist
//      nicht dasselbe wie abgewaehlt. (Genau daran lag es beim ersten Test:
//      alle Register lasen 0xFF.)
//
// ── BEFEHLE ────────────────────────────────────────────────────────────────
//   Tasmota haengt das Unterkommando OHNE Leerzeichen an den Praefix an:
//   SNIFTEST    -> Register zurücklesen (prüft Verdrahtung)
//   SNIFGO      -> mithören, Kanäle 6/41/76 reihum
//   SNIFOFF     -> Stopp, mit Zählerstand
//   SNIFSCAN    -> zwischen gemessenen Parametern und Suchlauf umschalten
//   SNIFRAW     -> auch Pakete ohne Treffer ausgeben
//   SNIFCH n    -> nur ein Kanal
//
//   Diagnose (aus der Fehlersuche vom 2026-07-27, hat sich bewährt):
//   SNIFCC      -> CC1101 am selben Bus auslesen. Antwortet er (VERSION=04),
//                  sind CLK/MOSI/MISO bewiesen in Ordnung und der Fehler sitzt
//                  beim nRF24. Bus gegen BEKANNT GUTE Hardware prüfen spart
//                  enorm viel Raten.
//   SNIFCCHI    -> CC1101 hart abwählen und sofort den nRF24 lesen
//   SNIFDUMP    -> nRF24-Register 0x00..0x09 roh
//   SNIFMAN     -> dasselbe mit CS von Hand statt über spiSetCS
//   SNIFNOP     -> Statusbyte über NOP (lebender Chip != 0xFF)
//   SNIFSLOW    -> Gegenprobe mit 1 MHz SPI-Takt
//   SNIFPINS    -> schalten CSN und CE überhaupt?
//   SNIFCS n    -> CS-Pin zur Laufzeit umstellen (isoliert Pin von Modul)
//   SNIFSQ      -> Rechteck auf CS/CE fürs Oszilloskop (500 / 125 Hz)
//   SNIFBUS     -> Dauer-SPI, damit SCK/MOSI/MISO messbar sind
//   SNIFHOLD    -> CS dauerhaft low ohne Takt (trennt Übersprechen von
//                  wirklich getriebener Leitung)
// ============================================================================

#define CSN_PIN   7
#define CE_PIN    8          // CE verlötet auf GPIO 8 (-1 waere: fest auf 3V3)
#define CC_CS_PIN 13         // CS des CC1101 am SELBEN Bus — muss HIGH = abgewaehlt sein
#define SLOT      1

// nRF24L01 Befehle / Register
#define N_R_REG    0x00
#define N_W_REG    0x20
#define N_R_RX     0x61
#define N_FLUSH_RX 0xE2
#define N_NOP      0xFF
#define N_CONFIG   0x00
#define N_EN_AA    0x01
#define N_EN_RX    0x02
#define N_AW       0x03
#define N_RF_CH    0x05
#define N_RF_SET   0x06
#define N_STATUS   0x07
#define N_RXADDR0  0x0A
#define N_RXPW0    0x11
#define N_FIFO     0x17
#define RF_1MBIT   0x06      // NICHT 0x0E — das waeren 2 Mbit/s

char spi[40];
char line[220];
char hexb[100];
int  ch_list[3];
int  active;
int  cur;
int  show_raw;
int  n_pkt;
int  n_hit;
int  air[14];   // gemessene Bitfolge auf der Luft (Praeambel..Nutzlastbeginn)
int  sweep_k;   // Bit-Versatz der Adresse in dieser Folge
int  sweep_on;  // 1 = Versatz automatisch durchfahren
int  addr_inv;  // Adresse invertiert — Bitpolaritaet der Demodulation war mehrdeutig
int  real_aw;   // Adressbreite im Messmodus: 3..5 Byte
int  real_mode; // 1 = gemessene Parameter statt Suchlauf
int  dr_cur;    // Datenrate: 0x0E=1M, 0x26=250k, 0x0F=2M — muss zum Sender passen
int  aw_cur;    // Adressbreite 3..5 Byte — die LT8900-Praeambel ist evtl. kuerzer als 5
int  pat_cur;   // Praeambelmuster im Suchlauf: 0x55 oder 0xAA
int  csn;       // CS-Pin zur LAUFZEIT umstellbar (SNIFCS n) — fuer die Fehlersuche
int  bus_mode;  // Dauerbetrieb auf dem SPI-Bus, damit SCK/MOSI/MISO am Oszi stehen
int  sq_mode;   // Rechteck-Testsignal auf CS/CE fuer die Oszi-Messung
int  sq_n;
// ── Anzeige auf der Tasmota-Hauptseite ──
int  last_nib;   // zuletzt empfangenes Befehlsnibble, -1 = noch nichts
int  last_vv;    // Zaehler des letzten Pakets
int  last_ms;    // millis() beim letzten gueltigen Paket
int  cnt_ok;     // gueltige Pakete gesamt
int  cnt_bad;    // Pakete mit falscher Pruefsumme
int  hits[16];   // Zaehler je Befehlsnibble

// Gemessene Bitfolge: Praeambel 55 55 55 55, Syncword 8A 85 5A AA,
// dann Nutzlast E0 5A D2 E0 (= 07 5A 4B 07 bitgedreht). Die nRF24-Adresse ist
// ein 5-Byte-Fenster daraus — an welcher Bitposition es enden muss, probieren
// wir durch, statt es zu erraten.
void air_init() {
    air[0]=0x55; air[1]=0x55; air[2]=0x55; air[3]=0x55;
    air[4]=0x8A; air[5]=0x85; air[6]=0x5A; air[7]=0xAA;
    air[8]=0xE0; air[9]=0x5A; air[10]=0xD2; air[11]=0xE0;
    air[12]=0x00; air[13]=0x00;
}

// 5 Byte ab Bit-Versatz k aus air[] holen, in spi[1..5] (Registerreihenfolge
// = umgekehrte Sendereihenfolge)
void air_window(int k) {
    int tmp[5];
    int i = 0;
    while (i < 5) {
        int v = 0;
        int b = 0;
        while (b < 8) {
            int bit = k + i*8 + b;
            int by = bit >> 3;
            int sh = 7 - (bit & 7);
            int x = 0;
            if (by < 14) { x = (air[by] >> sh) & 1; }
            v = (v << 1) | x;
            b = b + 1;
        }
        if (addr_inv) { v = (~v) & 0xFF; }
        tmp[i] = v;
        i = i + 1;
    }
    spi[1] = tmp[4]; spi[2] = tmp[3]; spi[3] = tmp[2];
    spi[4] = tmp[1]; spi[5] = tmp[0];
}

// Befehlsnibble -> Klartext. Bewusst if/else statt Ternaer: String-Ternaere
// kompilieren in TinyC zwar, scheitern aber zur Laufzeit.
void btn_name(int nib, char out[]) {
    if (nib == 0x4)      { strcpy(out, "dunkler"); }
    else if (nib == 0x5) { strcpy(out, "EIN"); }
    else if (nib == 0x9) { strcpy(out, "AUS"); }
    else if (nib == 0xC) { strcpy(out, "heller"); }
    else if (nib == 0xE) { strcpy(out, "kalt"); }
    else if (nib == 0xF) { strcpy(out, "warm"); }
    else                 { strcpy(out, "unbekannt"); }
}

// ── nRF24-Grundfunktionen ─────────────────────────────────────────────────
void nrf_wr(int reg, int val) {
    spi[0] = N_W_REG | (reg & 0x1F);
    spi[1] = val & 0xFF;
    spiTransfer(SLOT, spi, 2, 1);
}

int nrf_rd(int reg) {
    spi[0] = N_R_REG | (reg & 0x1F);
    spi[1] = 0;
    spiTransfer(SLOT, spi, 2, 1);
    return spi[1] & 0xFF;
}

void nrf_cmd(int c) {
    spi[0] = c & 0xFF;
    spiTransfer(SLOT, spi, 1, 1);
}

// Bits eines Bytes spiegeln — LT8900 sendet in umgekehrter Bitfolge zum nRF24
int bitrev(int b) {
    int r = 0;
    int i = 0;
    while (i < 8) {
        r = (r << 1) | ((b >> i) & 1);
        i = i + 1;
    }
    return r & 0xFF;
}

// ── Empfänger aufsetzen: nur auf die Präambel matchen ─────────────────────
// Adresse = 5x 0x55. Die Präambel des LT8900 ist eine Folge von 0x55 (bzw.
// 0xAA, je nach erstem Syncword-Bit) — wir matchen darauf und lassen alles
// Weitere als Nutzlast durchlaufen.
// Empfaenger auf die GEMESSENEN Parameter setzen: Adresse = Praeambel+Syncword
void nrf_setup_real(int chan) {
    if (CE_PIN >= 0) { digitalWrite(CE_PIN, 0); }
    nrf_wr(N_CONFIG, 0x00);
    nrf_wr(N_EN_AA, 0x00);
    nrf_wr(N_EN_RX, 0x01);
    nrf_wr(N_AW, (real_aw - 2) & 0x03);
    nrf_wr(N_RF_CH, chan & 0x7F);
    // RF_SETUP: Bit5=RF_DR_LOW, Bit3=RF_DR_HIGH, Bits2:1=Leistung.
    //   0x06 = 1 Mbit/s   0x0E = 2 Mbit/s   0x26 = 250 kbit/s
    // 0x0E hiess NICHT 1 Mbit/s — dieser Irrtum hat mehrere Messdurchlaeufe
    // gekostet, weil Adresse und Kanal stimmten, aber die Symbolrate nicht.
    nrf_wr(N_RF_SET, 0x06);          // 1 Mbit/s, 0 dBm
    nrf_wr(N_RXPW0, 32);
    // Auf der Luft steht ... 55 | 8A 85 5A AA | Nutzlast.
    // Ins Register kommt die umgekehrte Bytefolge, ggf. verkuerzt auf die
    // hinteren Bytes (die dem Nutzlastbeginn am naechsten liegen).
    spi[0] = N_W_REG | N_RXADDR0;
    air_window(sweep_k);
    spiTransfer(SLOT, spi, real_aw + 1, 1);
    nrf_cmd(N_FLUSH_RX);
    nrf_wr(N_STATUS, 0x70);
    nrf_wr(N_CONFIG, 0x03);
    delay(2);
    if (CE_PIN >= 0) { digitalWrite(CE_PIN, 1); }
}

void nrf_setup(int chan, int pat, int nb) {
    // CE runter, solange umkonfiguriert wird — RF_CH im laufenden Empfang zu
    // aendern ist laut Datenblatt nicht zulaessig.
    if (CE_PIN >= 0) { digitalWrite(CE_PIN, 0); }
    nrf_wr(N_CONFIG, 0x00);          // Power down zum Umkonfigurieren
    nrf_wr(N_EN_AA, 0x00);           // kein Auto-Ack
    nrf_wr(N_EN_RX, 0x01);           // nur Pipe 0
    nrf_wr(N_AW, (nb - 2) & 0x03);   // nb Byte Adresse (3..5)
    nrf_wr(N_RF_CH, chan & 0x7F);
    nrf_wr(N_RF_SET, dr_cur);        // Datenrate aus dem Sweep
    nrf_wr(N_RXPW0, 32);             // feste Nutzlastlänge 32
    spi[0] = N_W_REG | N_RXADDR0;
    int z = 1;
    while (z <= nb) { spi[z] = pat; z = z + 1; }
    spiTransfer(SLOT, spi, nb + 1, 1);
    nrf_cmd(N_FLUSH_RX);
    nrf_wr(N_STATUS, 0x70);          // Statusflags löschen
    nrf_wr(N_CONFIG, 0x03);          // PWR_UP | PRIM_RX, CRC AUS
    delay(2);                        // Einschwingen (Tpd2stby)
    if (CE_PIN >= 0) { digitalWrite(CE_PIN, 1); }   // jetzt empfangen
}

// ── ein empfangenes Paket auswerten ───────────────────────────────────────
// Sucht die bekannte Signatur 5A 4B 07 01 in den bitgespiegelten Daten und
// prüft die Summenprüfsumme.
void handle(char p[]) {
    n_pkt = n_pkt + 1;
    int i = 0;
    while (i < 32) {
        hexb[i] = bitrev(p[i] & 0xFF);
        i = i + 1;
    }
    // Signatur suchen: nur die drei ID-Bytes 5A 4B 07. Byte 4 NICHT mitpruefen —
    // es war im SPI-Mitschnitt 01, in der Luftmessung 00, taugt also nicht als
    // Erkennungsmerkmal.
    int k = 0;
    int found = -1;
    while (k < 26) {
        if (hexb[k] == 0x5A) {
            if (hexb[k+1] == 0x4B) {
                if (hexb[k+2] == 0x07) { found = k; k = 99; }
            }
        }
        k = k + 1;
    }
    if (found >= 0) {
        int b4 = hexb[found+3] & 0xFF;
        int cc = hexb[found+4] & 0xFF;
        int vv = hexb[found+5] & 0xFF;
        int su = hexb[found+6] & 0xFF;
        // Pruefsumme = Summe der sieben Bytes: 07 5A 4B 07 b4 cc vv
        int soll = (0x07 + 0x5A + 0x4B + 0x07 + b4 + cc + vv) & 0xFF;
        n_hit = n_hit + 1;
        // KEIN Ternaer mit String-Literalen — das kompiliert, scheitert aber
        // zur Laufzeit (Tasmota meldet dann Command:Error bzw. es kommt nichts).
        int gut = 0;
        if (su == soll) {
            gut = 1;
            cnt_ok = cnt_ok + 1;
            last_nib = cc & 0x0F;
            last_vv = vv;
            last_ms = millis();
            hits[last_nib] = hits[last_nib] + 1;
        } else {
            cnt_bad = cnt_bad + 1;
        }
        sprintf(line, "TREFFER ch=%d off=%d b4=%02X CC=%02X VV=%02X SUM=%02X soll=%02X ok=%d",
                ch_list[cur], found, b4, cc, vv, su, soll, gut);
        addLog(line);
        return;
    }
    if (show_raw) {
        sprintf(line, "roh ch=%d: %02X %02X %02X %02X %02X %02X %02X %02X %02X %02X %02X %02X",
                ch_list[cur],
                hexb[0] & 0xFF, hexb[1] & 0xFF, hexb[2] & 0xFF, hexb[3] & 0xFF,
                hexb[4] & 0xFF, hexb[5] & 0xFF, hexb[6] & 0xFF, hexb[7] & 0xFF,
                hexb[8] & 0xFF, hexb[9] & 0xFF, hexb[10] & 0xFF, hexb[11] & 0xFF);
        addLog(line);
    }
}

void TaskLoop() {
    // Rechteck-Testsignal: CS mit ~500 Hz, CE mit ~125 Hz — unterschiedliche
    // Frequenzen, damit die beiden Leitungen am Oszi eindeutig zuzuordnen sind,
    // auch mit nur einem Tastkopf.
    // Dauer-SPI: staendig Register 0x07 lesen. SCK und MOSI zeigen dann ein
    // stehendes Muster; auf MISO muesste ein lebender Chip antworten.
    if (bus_mode) {
        int q = 0;
        while (q < 200) {
            spi[0] = 0x07;
            spi[1] = 0x00;
            spiTransfer(SLOT, spi, 2, 1);
            q = q + 1;
        }
        delay(1);
        return;
    }
    if (sq_mode) {
        sq_n = sq_n + 1;
        digitalWrite(csn, sq_n & 1);
        digitalWrite(CE_PIN, (sq_n >> 2) & 1);
        delay(1);
        return;
    }
    if (!active) {
        delay(50);
        return;
    }
    if (real_mode) {
        nrf_setup_real(ch_list[cur]);
        int seen0 = n_pkt;
        int q = 0;
        int lim = 200;
        if (sweep_on) { lim = 60; }        // beim Durchfahren kuerzer verweilen
        while (q < lim) {
            int stt = nrf_rd(N_STATUS);
            if (stt & 0x40) {
                spi[0] = N_R_RX;
                int w = 1;
                while (w <= 32) { spi[w] = 0; w = w + 1; }
                spiTransfer(SLOT, spi, 33, 1);
                char pk2[34];
                w = 0;
                while (w < 32) { pk2[w] = spi[w+1]; w = w + 1; }
                nrf_wr(N_STATUS, 0x70);
                nrf_cmd(N_FLUSH_RX);
                handle(pk2);
            }
            delay(1);
            q = q + 1;
        }
        if (sweep_on) {
            if (n_pkt > seen0) {
                sprintf(line, "SWEEP: k=%d inv=%d -> %d Pakete",
                        sweep_k, addr_inv, n_pkt - seen0);
                addLog(line);
            }
            sweep_k = sweep_k + 1;
            if (sweep_k > 44) {
                sweep_k = 8;
                addr_inv = !addr_inv;      // nach allen Versaetzen Polaritaet wechseln
                addLog("SWEEP: Polaritaet gewechselt");
            }
        }
        cur = cur + 1;
        if (cur > 2) { cur = 0; }
        return;
    }
    // Kanal wechseln und kurz lauschen. Die LT8900-Praeambel ist 0x55 ODER
    // 0xAA, je nach erstem Syncword-Bit (siehe LT8900_BuildOverhead im
    // Multiprotocol-Projekt) — welches, wissen wir nicht, also beide abwechselnd.
    nrf_setup(ch_list[cur], pat_cur, aw_cur);
    int t = 0;
    while (t < 80) {                  // ~80 ms pro Kombination
        int st = nrf_rd(N_STATUS);
        if (st & 0x40) {              // RX_DR
            spi[0] = N_R_RX;
            int i = 1;
            while (i <= 32) { spi[i] = 0; i = i + 1; }
            spiTransfer(SLOT, spi, 33, 1);
            char pk[34];
            i = 0;
            while (i < 32) { pk[i] = spi[i+1]; i = i + 1; }
            nrf_wr(N_STATUS, 0x70);
            nrf_cmd(N_FLUSH_RX);
            handle(pk);
        }
        delay(1);
        t = t + 1;
    }
    cur = cur + 1;
    if (cur > 2) {
        cur = 0;
        pat_cur = (pat_cur == 0x55) ? 0xAA : 0x55;
        if (pat_cur == 0x55) {                       // nach beiden Mustern: Breite wechseln
            aw_cur = aw_cur + 1;
            if (aw_cur > 5) {
                aw_cur = 3;
                // und nach allen Breiten: Datenrate wechseln
                if (dr_cur == 0x0E)      { dr_cur = 0x26; }   // 250 kbit/s
                else if (dr_cur == 0x26) { dr_cur = 0x0F; }   // 2 Mbit/s
                else                     { dr_cur = 0x0E; }   // 1 Mbit/s
            }
        }
    }
}

// ── Anzeige auf der Tasmota-Hauptseite ─────────────────────────────────────
void WebCall() {
    char nm[16];
    if (last_nib < 0) {
        webSend("{s}Deckenlampe{m}noch nichts empfangen{e}");
    } else {
        btn_name(last_nib, nm);
        int alt = (millis() - last_ms) / 1000;
        sprintf(line, "{s}Letzte Taste{m}<b>%s</b>  (vor %d s){e}", nm, alt);
        webSend(line);
        sprintf(line, "{s}Rahmen{m}CC=0x%02X  Zaehler=0x%02X{e}",
                0x10 | last_nib, last_vv);
        webSend(line);
    }
    sprintf(line, "{s}Empfangen{m}%d gueltig / %d fehlerhaft{e}", cnt_ok, cnt_bad);
    webSend(line);
    // Zaehler je Taste, nur die benutzten
    int nibs[6];
    nibs[0]=0x5; nibs[1]=0x9; nibs[2]=0xC; nibs[3]=0x4; nibs[4]=0xF; nibs[5]=0xE;
    int i = 0;
    while (i < 6) {
        int n = nibs[i];
        if (hits[n] > 0) {
            btn_name(n, nm);
            sprintf(line, "{s}&nbsp;&nbsp;%s{m}%d x{e}", nm, hits[n]);
            webSend(line);
        }
        i = i + 1;
    }
}

void Command(char cmd[]) {
    if (strcmp(cmd, "TEST") == 0) {
        nrf_setup(6, 0x55, aw_cur);
        int cfg = nrf_rd(N_CONFIG);
        int aw = nrf_rd(N_AW);
        int rf = nrf_rd(N_RF_SET);
        int ch = nrf_rd(N_RF_CH);
        sprintf(line, "CONFIG=%02X (soll 03) AW=%02X (soll 03) RF_SETUP=%02X (soll 0E) RF_CH=%d (soll 6)",
                cfg, aw, rf, ch);
        responseCmnd(line);
        return;
    }
    if (strcmp(cmd, "CCHI") == 0) {
        // CC1101 hart abwaehlen und sofort den nRF24 lesen. Liegt sein CS auf 0 V,
        // treibt er MISO permanent mit und kaempft gegen den nRF24 -> Zwischenpegel.
        bus_mode = 0; sq_mode = 0; active = 0;
        pinMode(CC_CS_PIN, 3);
        digitalWrite(CC_CS_PIN, 1);
        pinMode(csn, 3);
        digitalWrite(csn, 1);
        delay(5);
        int rb = digitalRead(CC_CS_PIN);
        sprintf(line, "CC-CS(GPIO%d) zurueckgelesen=%d | nRF24: 00=%02X 01=%02X 02=%02X 03=%02X 05=%02X 06=%02X",
                CC_CS_PIN, rb, nrf_rd(0), nrf_rd(1), nrf_rd(2), nrf_rd(3), nrf_rd(5), nrf_rd(6));
        responseCmnd(line);
        return;
    }
    if (strcmp(cmd, "HOLD") == 0) {
        // CS dauerhaft LOW, KEIN Takt. Entscheidet zwischen Uebersprechen und
        // schwach getriebener Leitung: Einkopplung von SCK verschwindet ohne
        // Takt, ein wirklich getriebener MISO-Pegel bleibt stehen.
        bus_mode = 0; sq_mode = 0; active = 0;
        pinMode(csn, 3);
        digitalWrite(csn, 0);            // Chip ausgewaehlt, Bus still
        digitalWrite(CE_PIN, 0);
        responseCmnd("CS liegt jetzt dauerhaft LOW, kein Takt — MISO-Gleichpegel messen. SNIFCS 7 oder SNIFBUS beendet das");
        return;
    }
    if (strcmp(cmd, "BUS") == 0) {
        bus_mode = !bus_mode;
        sq_mode = 0; active = 0;
        if (bus_mode) {
            digitalWrite(CE_PIN, 0);
            responseCmnd("Dauer-SPI AN: SCK/MOSI/MISO jetzt messbar. SNIFBUS nochmal = aus");
        } else {
            digitalWrite(csn, 1);
            responseCmnd("Dauer-SPI AUS");
        }
        return;
    }
    if (strcmp(cmd, "SWEEP") == 0) {
        sweep_on = !sweep_on;
        sweep_k = 8; addr_inv = 0; real_mode = 1;
        n_pkt = 0; n_hit = 0;
        if (sweep_on) { active = 1; }
        if (sweep_on) {
            responseCmnd("SWEEP AN: Versatz 8..44 x beide Polaritaeten, ~60 ms je Schritt");
        } else {
            responseCmnd("SWEEP AUS");
        }
        return;
    }
    if (strcmp(cmd, "INV") == 0) {
        addr_inv = !addr_inv;
        sprintf(line, "Adresse %s (Bitpolaritaet)", addr_inv ? "INVERTIERT" : "normal");
        responseCmnd(line);
        return;
    }
    if (strStartsWith(cmd, "AW")) {
        char a1[16];
        strToken(a1, cmd, ' ', 2);
        int n = strToInt(a1);
        if (n >= 3) { if (n <= 5) { real_aw = n; } }
        sprintf(line, "Adressbreite jetzt %d Byte", real_aw);
        responseCmnd(line);
        return;
    }
    if (strcmp(cmd, "SCAN") == 0) {
        real_mode = !real_mode;
        if (real_mode) { responseCmnd("Modus: GEMESSENE Parameter"); }
        else            { responseCmnd("Modus: Suchlauf"); }
        return;
    }
    if (strcmp(cmd, "SQ") == 0) {
        sq_mode = !sq_mode;
        active = 0;                      // Mithoeren aus, sonst stoert es
        if (sq_mode) {
            pinMode(csn, 3);
            pinMode(CE_PIN, 3);
            sprintf(line, "Rechteck AN: GPIO%d (CS) ~500 Hz, GPIO%d (CE) ~125 Hz — jetzt messen. SNIFSQ nochmal = aus",
                    csn, CE_PIN);
            responseCmnd(line);
        } else {
            digitalWrite(csn, 1);        // CS wieder inaktiv (high)
            digitalWrite(CE_PIN, 0);
            responseCmnd("Rechteck AUS, CS zurueck auf high");
        }
        return;
    }
    if (strStartsWith(cmd, "CS")) {
        char a1[16];
        strToken(a1, cmd, ' ', 2);
        int n = strToInt(a1);
        if (n > 0) {
            csn = n;
            pinMode(csn, 3);
            digitalWrite(csn, 1);
            spiSetCS(SLOT, csn);
        }
        sprintf(line, "CS-Pin ist jetzt GPIO %d", csn);
        responseCmnd(line);
        return;
    }
    if (strcmp(cmd, "NOP") == 0) {
        // Kanonischer nRF24-Lebendtest: JEDES Kommando gibt schon waehrend des
        // ERSTEN Bytes das Statusregister auf MISO zurueck. Bisher habe ich nur
        // Byte 1 ausgewertet. Ein lebender Chip liefert hier z. B. 0x0E, ein
        // fehlender/abgeklemmter 0xFF (Leitung haengt hoch) oder 0x00.
        spi[0] = 0xFF;                      // NOP
        spiTransfer(SLOT, spi, 1, 1);
        int st1 = spi[0] & 0xFF;
        spi[0] = 0x07;                      // R_REGISTER STATUS
        spi[1] = 0x00;
        spiTransfer(SLOT, spi, 2, 1);
        int st2 = spi[0] & 0xFF;
        int d2  = spi[1] & 0xFF;
        sprintf(line, "NOP->Status=%02X | Read07: Byte0=%02X Byte1=%02X  (lebender Chip: 0E, tot: FF)",
                st1, st2, d2);
        responseCmnd(line);
        return;
    }
    if (strcmp(cmd, "SLOW") == 0) {
        // SPI auf 1 MHz herunter. Lange ungeschirmte Leitungen versagen bei
        // 4 MHz eher als bei 1 MHz — der CC1101 sitzt evtl. naeher dran.
        spiInit(-1, -1, -1, 1);
        spiSetCS(SLOT, csn);
        delay(5);
        sprintf(line, "1 MHz: 00=%02X 01=%02X 02=%02X 03=%02X 05=%02X 06=%02X 07=%02X",
                nrf_rd(0), nrf_rd(1), nrf_rd(2), nrf_rd(3),
                nrf_rd(5), nrf_rd(6), nrf_rd(7));
        responseCmnd(line);
        return;
    }
    if (strcmp(cmd, "PINS") == 0) {
        // Schalten die CS-/CE-Pins ueberhaupt? Ausgang setzen und zuruecklesen.
        pinMode(csn, 3);
        pinMode(CE_PIN, 3);
        digitalWrite(csn, 0); digitalWrite(CE_PIN, 0);
        delay(2);
        int c0 = digitalRead(CSN_PIN);
        int e0 = digitalRead(CE_PIN);
        digitalWrite(csn, 1); digitalWrite(CE_PIN, 1);
        delay(2);
        int c1 = digitalRead(CSN_PIN);
        int e1 = digitalRead(CE_PIN);
        digitalWrite(csn, 1);
        sprintf(line, "GPIO%d (CSN): low=%d high=%d | GPIO%d (CE): low=%d high=%d  (soll 0 und 1)",
                csn, c0, c1, CE_PIN, e0, e1);
        responseCmnd(line);
        return;
    }
    if (strcmp(cmd, "CC") == 0) {
        // Bus gegen BEKANNT FUNKTIONIERENDE Hardware pruefen: Der CC1101 haengt
        // am selben SPI. Antwortet er, sind CLK/MOSI/MISO in Ordnung und das
        // Problem sitzt eindeutig beim nRF24 (Versorgung/Verdrahtung/Modul).
        // CC1101: Statusregister werden mit 0xC0|addr gelesen.
        // PARTNUM (0x30) -> meist 0x00, VERSION (0x31) -> 0x14.
        digitalWrite(csn, 1);          // nRF24 sicher abgewaehlt
        pinMode(CC_CS_PIN, 3);
        spi[0] = 0xF0; spi[1] = 0x00;      // 0xC0 | 0x30 = PARTNUM
        digitalWrite(CC_CS_PIN, 0);
        spiTransfer(0, spi, 2, 1);
        digitalWrite(CC_CS_PIN, 1);
        int part = spi[1] & 0xFF;
        spi[0] = 0xF1; spi[1] = 0x00;      // 0xC0 | 0x31 = VERSION
        digitalWrite(CC_CS_PIN, 0);
        spiTransfer(0, spi, 2, 1);
        digitalWrite(CC_CS_PIN, 1);
        int ver = spi[1] & 0xFF;
        sprintf(line, "CC1101: PARTNUM=%02X VERSION=%02X  (Version 14 oder 04 = Bus OK)",
                part, ver);
        responseCmnd(line);
        return;
    }
    if (strcmp(cmd, "MAN") == 0) {
        // Gegenprobe: CS VON HAND statt ueber spiSetCS/Slot. Trennt einen
        // Software-Fehler in der CS-Verwaltung von echtem Verdrahtungsproblem.
        // bresser_chart.tc auf diesem Geraet macht es genauso.
        pinMode(csn, 3);
        digitalWrite(csn, 1);
        delay(1);
        int i = 0;
        int vals[10];
        while (i < 10) {
            spi[0] = i;              // R_REGISTER | reg
            spi[1] = 0xFF;
            digitalWrite(csn, 0);
            spiTransfer(0, spi, 2, 1);      // cs=0 -> keine automatische CS
            digitalWrite(csn, 1);
            vals[i] = spi[1] & 0xFF;
            i = i + 1;
        }
        sprintf(line, "manuell: 00=%02X 01=%02X 02=%02X 03=%02X 04=%02X 05=%02X 06=%02X 07=%02X 08=%02X 09=%02X",
                vals[0], vals[1], vals[2], vals[3], vals[4],
                vals[5], vals[6], vals[7], vals[8], vals[9]);
        responseCmnd(line);
        return;
    }
    if (strcmp(cmd, "DUMP") == 0) {
        // Rohdump: ein antwortender nRF24 liefert NIE ueberall 0xFF.
        // Vorgabewerte nach Reset: 00=08 01=3F 02=03 03=03 04=03 05=02 06=0E 07=0E
        sprintf(line, "00=%02X 01=%02X 02=%02X 03=%02X 04=%02X 05=%02X 06=%02X 07=%02X 08=%02X 09=%02X",
                nrf_rd(0), nrf_rd(1), nrf_rd(2), nrf_rd(3), nrf_rd(4),
                nrf_rd(5), nrf_rd(6), nrf_rd(7), nrf_rd(8), nrf_rd(9));
        responseCmnd(line);
        return;
    }
    if (strcmp(cmd, "GO") == 0) {
        active = 1; cur = 0; n_pkt = 0; n_hit = 0;
        responseCmnd("hoere mit auf 6/41/76 — jetzt Taste druecken");
        return;
    }
    if (strcmp(cmd, "OFF") == 0) {
        active = 0;
        sprintf(line, "gestoppt: %d Pakete, %d Treffer", n_pkt, n_hit);
        responseCmnd(line);
        return;
    }
    if (strcmp(cmd, "RAW") == 0) {
        show_raw = !show_raw;
        if (show_raw) { responseCmnd("Rohausgabe AN"); }
        else          { responseCmnd("Rohausgabe AUS"); }
        return;
    }
    if (strStartsWith(cmd, "CH")) {
        char a1[16];
        strToken(a1, cmd, ' ', 2);
        int n = strToInt(a1);
        ch_list[0] = n; ch_list[1] = n; ch_list[2] = n;
        active = 1; cur = 0;
        sprintf(line, "nur Kanal %d", n);
        responseCmnd(line);
        return;
    }
    sprintf(line, "TEST | GO | CH n | RAW | OFF   (Pakete %d, Treffer %d)", n_pkt, n_hit);
    responseCmnd(line);
}

int main() {
    // Lampenkanaele 4/39/74 -> nRF24 +2
    // Dauerbetrieb auf Kanal 41: die Fernbedienung sendet je Druck 30 Rahmen
    // auf diesem Kanal, das reicht reichlich. Rotieren wuerde nur Pakete kosten.
    ch_list[0] = 41;
    ch_list[1] = 41;
    ch_list[2] = 41;
    sq_mode = 0; sq_n = 0; bus_mode = 0;
    active = 1; cur = 0; show_raw = 0; n_pkt = 0; n_hit = 0; pat_cur = 0x55; aw_cur = 4; dr_cur = 0x0E; real_mode = 1; real_aw = 5; addr_inv = 0; sweep_k = 24; sweep_on = 0;
    csn = CSN_PIN;

    // ZUERST den CC1101 abwaehlen — er teilt sich MISO mit dem nRF24.
    pinMode(CC_CS_PIN, 3);
    digitalWrite(CC_CS_PIN, 1);

    last_nib = -1; last_vv = 0; last_ms = 0; cnt_ok = 0; cnt_bad = 0;
    int z = 0;
    while (z < 16) { hits[z] = 0; z = z + 1; }
    air_init();
    spiInit(-1, -1, -1, 4);
    spiSetCS(SLOT, csn);
    if (CE_PIN >= 0) {
        pinMode(CE_PIN, 3);          // OUTPUT (TinyC: 3, nicht 1)
        digitalWrite(CE_PIN, 1);     // dauerhaft aktiv
    }
    delay(50);
    nrf_setup(6, 0x55, aw_cur);

    addCommand("SNIF");
    addLog("lt8900_sniff: bereit, CONFIG=0x%02X (soll 0x03)", nrf_rd(N_CONFIG));
    return 0;
}
