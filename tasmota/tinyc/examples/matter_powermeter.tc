// Matter 1.4 Power Meter — expose an SML / energy-meter reading over Matter.
//
// Matter 1.4 added the Electrical Sensor device type (0x0510) with the
// Electrical Power Measurement cluster (0x0090). This example publishes the
// live electrical values a Tasmota SML meter reads, so a Matter controller
// (e.g. Home Assistant, which supports the energy clusters) can graph them.
//
//   Endpoint 1: Electrical Sensor (0x0510)
//     -> ElectricalPowerMeasurement (0x0090):
//          ActivePower   (0x0008) int64, milliwatts (mW)   — may be negative (export)
//          Voltage       (0x0004) int64, millivolts (mV)
//          ActiveCurrent (0x0005) int64, milliamps  (mA)
//
// Values are int64 and can exceed 32 bits, so they are published with
// matterSetFloat(ep, cluster, attr, value, scale): it stores round(value*scale)
// as a 64-bit signed integer. Declare those attributes as MTR_S64.
//
// NOTE: values below are SIMULATED so it runs on any board. For a real meter,
// read the SML values with sensorGet(), e.g.
//     w = sensorGet("SML#Power_curr");      // Watts  (your SML descriptor name)
//     v = sensorGet("SML#Volt_L1");         // Volts
//     a = sensorGet("SML#Amp_L1");          // Amps
//
// Limitation: the Electrical*Measurement clusters also define struct attributes
// (Accuracy, Ranges, EnergyMeasurementStruct) the scalar data-model engine does
// not emit yet; cumulative energy (0x0091) needs that and is left for later.

int ep;          // electrical-sensor endpoint id
int tick;

void EverySecond() {
    float w; float v; float a;
    tick = tick + 1;
    // Simulated readings (swap for sensorGet(...) on a real SML meter).
    w = 800.0 - 1500.0 * sin((float)tick / 30.0);   // -700 .. +2300 W (signed: export when negative)
    v = 230.0 + 3.0  * sin((float)tick / 17.0);     // ~230 V
    a = w / v;                                       // rough current (A)
    matterSetFloat(ep, CLUSTER_POWER, ATTR_ACTIVE_POWER,   w, 1000);  // W -> mW
    matterSetFloat(ep, CLUSTER_POWER, ATTR_VOLTAGE,        v, 1000);  // V -> mV
    matterSetFloat(ep, CLUSTER_POWER, ATTR_ACTIVE_CURRENT, a, 1000);  // A -> mA
}

int main() {
    tick = 0;
    matterReset();                     // clean data model (root node only)

    ep = matterAdd(MATTER_ELEC_SENSOR);
    matterCluster(ep, CLUSTER_POWER);                       // ElectricalPowerMeasurement
    matterAttr(ep, CLUSTER_POWER, ATTR_ACTIVE_POWER,   MTR_S64);  // mW (int64, signed)
    matterAttr(ep, CLUSTER_POWER, ATTR_VOLTAGE,        MTR_S64);  // mV
    matterAttr(ep, CLUSTER_POWER, ATTR_ACTIVE_CURRENT, MTR_S64);  // mA
    matterSetFloat(ep, CLUSTER_POWER, ATTR_ACTIVE_POWER,   0.0, 1000);
    matterSetFloat(ep, CLUSTER_POWER, ATTR_VOLTAGE,      230.0, 1000);
    matterSetFloat(ep, CLUSTER_POWER, ATTR_ACTIVE_CURRENT, 0.0, 1000);

    matterStart();                     // Matter on; press Bind on /mt to pair
    return 0;
}
