// Powerwall — Tesla Powerwall API access
// Replicates the Scripter powerwall_script.tas
// Queries battery %, power flow, capacity
//
// Requires: TESLA_POWERWALL enabled in firmware build

// ─── Powerwall data (shared via UDP) ───
global float pwl  = 8.0;    // battery percentage
global float sip  = 0.0;    // site/grid import power (W)
global float sop  = 0.0;    // solar output power (W)
global float bip  = 0.0;    // battery import power (W)
global float hip  = 0.0;    // home/load power (W)
global float tcap = 0.0;    // total capacity (Wh)
global float rcap = 0.0;    // remaining capacity (Wh)
global float rper = 0.0;    // reserve percent

global float phs1 = 0.0;    // grid phase 1
global float phs2 = 0.0;    // grid phase 2
global float phs3 = 0.0;    // grid phase 3

// Solar string powers — only two strings exposed by the Powerwall;
// p_W[3] and p_W[5] are skipped intermediates (matches Scripter
// convention). UI labels "Solar Phase 1/2" map to p1w / p3w.
global float p1w = 0.0;    // solar string 1 — p_W[2]
global float p3w = 0.0;    // solar string 2 — p_W[4]

// State
char buf[128];
char scratch[256];                  // sized for sprintf into webSend (clock header)
int  lcd_initialized = 0;           // labels drawn once at boot
int  lcd_last_update = -10;         // throttle LCD value refresh (uptime sec)

// ═══════════════ BEGIN CLOCK HEADER BLOCK (from examples/clock_header.tc) ═════
// Reusable WebUI clock header — big green HH:MM:SS + German weekday/date
// + sunrise/sunset + live-tick "spinner". Codified pattern, lifted 1:1
// from the original Scripter `>W` block. See examples/clock_header.tc
// for the standalone reference + paste-ready block markers. The only
// external requirement is a `char scratch[256]` buffer in scope.
int web_clock_tick = 0;

void web_clock_header() {
    web_clock_tick = web_clock_tick + 1;

    // Indexed lookup via the built-in strToken(dst, src, delim, n) —
    // 1-based, lines up directly with tasm_wday (1=Sun..7=Sat) and
    // tasm_month (1..12). Replaces what used to be a 14-branch
    // if/else cascade.
    char wd_names[] = "So|Mo|Di|Mi|Do|Fr|Sa";
    char mo_names[] = "Jan|Feb|Mar|Apr|Mai|Jun|Jul|Aug|Sep|Okt|Nov|Dez";
    char wd_label[4];
    char mo_label[4];
    strToken(wd_label, wd_names, '|', tasm_wday);
    strToken(mo_label, mo_names, '|', tasm_month);

    // Single dark-grey rounded card spanning both columns. Two
    // sprintfs because the full card exceeds 256-byte scratch.
    sprintf(scratch, "<tr><td colspan=2 style='text-align:center;background:#333;padding:8px;border-radius:8px'><span style='color:green;font-size:40px;font-weight:bold'>%02d:%02d:%02d</span><br>%s %d. %s %d <span style='font-size:0.7em;color:#888;'>&#9679; %d</span><br>",
            tasm_hour, tasm_minute, tasm_second,
            wd_label, tasm_day, mo_label, tasm_year, web_clock_tick);
    webSend(scratch);

    int sr = tasm_sunrise;
    int ss = tasm_sunset;
    int dl = ss - sr;
    sprintf(scratch, "&#127774; %02d:%02d <--- %02d:%02d ---> %02d:%02d &#127769;</td></tr>",
            sr / 60, sr % 60,
            dl / 60, dl % 60,
            ss / 60, ss % 60);
    webSend(scratch);
}
// ═══════════════ END CLOCK HEADER BLOCK ════════════════════════════════════

// ── LCD layout (ported from Scripter labels block, lines 41-49 of the
//    original .tas). Title centered, two short horizontal rules either
//    side, then 13 labels at x=15 starting y=60, increment 20. Values
//    rendered separately in lcd_update_values(), at x=150 with p-10
//    right-padding so they line up. Anti-pattern §5 in CLAUDE.md says
//    don't split position+pad+text into multiple dsp* calls — pad
//    bleeds across labels — so each value goes out as ONE inline
//    `[Cixxxxxxx]value` dspText call.
//
//    Display target: any panel that the firmware's display driver has
//    turned on. If no display is configured (DisplayMode=0 and no LCD
//    on the I²C/SPI bus), all dspText() calls are silent no-ops. So
//    safe to leave in even on devices without a screen.
void lcd_init_labels() {
    // Wipe whatever the previous program (or boot splash) left on
    // screen. Without this, old labels/values bleed through into the
    // empty regions of our layout. Safe no-op if no display attached.
    dspClear();

    // Title bar with horizontal lines around it.
    dspText("[Ci5x0y20h70x170h70]");                  // two short rules at y=20
    dspText("[Ci16f1s1y18x90]Powerwall");             // big title at top

    // Draw the 13 row labels, color index 16 (white-ish), font 1 size 1.
    dspText("[f1s1Ci16]");
    dspText("[x15y60]Battery %:");
    dspText("[x15y80]Grid:");
    dspText("[x15y100]Solar:");
    dspText("[x15y120]Battery:");
    dspText("[x15y140]Home:");
    dspText("[x15y160]Tot Cap:");
    dspText("[x15y180]Rem Cap:");
    dspText("[x15y200]Rcap Lim:");
    dspText("[x15y220]Solar 1:");
    dspText("[x15y240]Solar 2:");
    dspText("[x15y260]Phase 1:");
    dspText("[x15y280]Phase 2:");
    dspText("[x15y300]Phase 3:");
}

void lcd_update_values() {
    // Render each value as `[Ci5x150y<row>p-10]<value> <unit>` — one
    // inline dspText per row keeps the p-10 right-padding scoped to
    // that single column write (otherwise the pad clobbers labels).
    sprintf(buf, "[Ci5x150y60p-10]%.2f %%", pwl);                 dspText(buf);
    sprintf(buf, "[Ci5x150y80p-10]%.0f W",   sip);                dspText(buf);
    sprintf(buf, "[Ci5x150y100p-10]%.0f W",  sop);                dspText(buf);
    sprintf(buf, "[Ci5x150y120p-10]%.0f W",  bip);                dspText(buf);
    sprintf(buf, "[Ci5x150y140p-10]%.0f W",  hip);                dspText(buf);
    sprintf(buf, "[Ci5x150y160p-10]%.0f W",  tcap);               dspText(buf);
    sprintf(buf, "[Ci5x150y180p-10]%.0f W",  rcap);               dspText(buf);
    sprintf(buf, "[Ci5x150y200p-10]%.0f %%", rper);               dspText(buf);
    sprintf(buf, "[Ci5x150y220p-10]%.0f W",  p1w);                dspText(buf);
    sprintf(buf, "[Ci5x150y240p-10]%.0f W",  p3w);                dspText(buf);
    sprintf(buf, "[Ci5x150y260p-10]%.0f W",  phs1);               dspText(buf);
    sprintf(buf, "[Ci5x150y280p-10]%.0f W",  phs2);               dspText(buf);
    sprintf(buf, "[Ci5x150y300p-10]%.0f W",  phs3);               dspText(buf);
}

// ── Multi-cadence dispatch ─────────────────────────────────────────
// Profile data (taken on a clean .140 with TESLA_POWERWALL enabled)
// showed each pwlRequest costs ~520-590 ms steady-state for small
// endpoints, ~1600 ms for `readings` (large body). The dominant cost
// is TLS handshake — `tc_pwl_get_request` opens a fresh SSL socket
// per call (no keep-alive). Pushing past ~1 Hz triggers Powerwall
// throttling: we observed two ~37 s timeouts after sustained 1-Hz
// polling.
//
// So we split into four cadences, each backed off enough to stay
// well under the throttle ceiling while still getting near-real-time
// updates on the four most-watched values:
//
//   FAST    every  2 s   aggregates  → sip/bip/hip/sop
//   MEDIUM  every 10 s   readings    → per-phase (phs1..3, p1w, p3w)
//   SLOW    every 60 s   soe + sysst → pwl/tcap/rcap
//   VSLOW   every  5 m   operation   → reserve %
//
// Total network busy: ~27 s per minute (45% duty cycle). Below the
// throttle threshold; ~100× faster latency on the four flow values
// vs the original 60 s round-robin.
//
// All loop bodies still log timings via prof_log() — useful while
// validating the new cadence on a fresh device. Once stable, the
// prof_log calls (and the /pwl_prof.log file) can be removed; the
// dispatch loop itself is the production code.
char prof_buf[120];

// Append a profile line to /pwl_prof.log so we can grab it via
// `curl http://<dev>/ufsd?download=/pwl_prof.log`. Tasmota's console
// log buffer isn't directly curl-able (the /cs page fetches via JS),
// so a tiny file is the simplest way to extract timing samples.
// Auto-trims at 8 KB so it can't fill the FS during long runs.
void prof_log(char msg[]) {
    if (fileSize("/pwl_prof.log") > 8192) {
        fileDelete("/pwl_prof.log");
    }
    int h = fileOpen("/pwl_prof.log", 2);    // append mode
    if (h < 0) return;
    char line[160];
    sprintf(line, "%u\t%s\n", millis(), msg);
    fileWrite(h, line, strlen(line));
    fileClose(h);
}

// ── Circuit breaker / backoff ──────────────────────────────────────
// The Powerwall web server occasionally throws a wobbler — refuses
// connections for 30-60 s, even when polled at modest cadence. When
// that happens, `tc_pwl_get_request` blocks the VM mutex inside the
// SSL connect timeout (~30 s × N retries), which cascades across all
// queued cadences and makes the device look "stuck" from the LAN
// side for 1-3 minutes.
//
// Two defenses:
//
//   1. **Cookie wipe on first failure**: a stale auth cookie often
//      survives a Powerwall restart and triggers cascading 401s.
//      `pwlRequest("@N")` clears the cookie so the next call does a
//      fresh /api/login/Basic. Cheap, no backoff cost on success.
//
//   2. **Per-cadence exponential backoff**: each cadence carries its
//      own consecutive-fail counter. On fail, the cadence interval
//      multiplies by 4 (capped at 5 minutes). On success, it resets
//      to nominal. So one bad call costs at most one extra interval
//      slot before recovery; sustained badness silently drops to
//      polling every 5 minutes per cadence until the Powerwall is
//      reachable again.
//
//   3. **Skip-remaining on wake fail**: if any cadence fails inside
//      a single TaskLoop wake, the remaining cadences in that wake
//      are skipped. Prevents the "all four queued, all four
//      timeout" cascade we observed (3× 60-s SSL timeouts → 3 min
//      device freeze).

int      pwl_fails[4];          // [0]=fast [1]=med [2]=slow [3]=vslow
uint32_t pwl_intervals[4];      // current cadence (ms), grows on fail
uint32_t pwl_nominals[4];       // nominal cadence (ms), restored on success

// Auto-recovery: ESP32's BearSSL stack occasionally gets into a stuck
// state (typically after many cookie-clear/relogin cycles) where every
// pwlRequest fails with the bounded ~6 s timeout regardless of whether
// the Powerwall is actually responsive.
//
// Two tiers of recovery, escalating:
//
//   PWL_RESET_THRESHOLD  (3 fails): pwlRequest("@R") tears down and
//     rebinds the SSL session in firmware (without rebooting the
//     chip). Clears the BSSL_TCP_Client + underlying WiFiClient
//     socket + pending auth cookie. Cheap (~50 ms), no impact on
//     other slots / Tasmota state.
//
//   PWL_REBOOT_THRESHOLD (6 fails): if @R didn't unstick the SSL
//     stack, fall back to `Restart 1`. Slot autoexec brings the
//     device back in ~30 s.
//
// Backoff curve makes each threshold a meaningful test: by fail #3
// we've waited ~2+8+32 = 42 s, ample time for a transient Powerwall
// hiccup to clear naturally. By fail #6 we've waited ~13 min total —
// enough that we're confident the SSL stack itself is the problem.
int  PWL_RESET_THRESHOLD  = 3;
int  PWL_REBOOT_THRESHOLD = 6;
char pwl_reboot_buf[64];

void pwl_init_state() {
    pwl_nominals[0] = 2000;     // fast    : aggregates
    pwl_nominals[1] = 10000;    // medium  : readings
    pwl_nominals[2] = 60000;    // slow    : soe + system_status
    pwl_nominals[3] = 300000;   // vslow   : operation
    for (int i = 0; i < 4; i = i + 1) {
        pwl_fails[i] = 0;
        pwl_intervals[i] = pwl_nominals[i];
    }
}

// Update the fail counter + interval for cadence `idx`. Called by each
// pwl_*() helper after pwlRequest returns.
void pwl_handle_result(int idx, int res, char name[]) {
    if (res == 0) {
        if (pwl_fails[idx] > 0) {
            sprintf(prof_buf, "  recovery: %s after %d fails — cadence reset to %u ms",
                    name, pwl_fails[idx], pwl_nominals[idx]);
            prof_log(prof_buf);
        }
        pwl_fails[idx] = 0;
        pwl_intervals[idx] = pwl_nominals[idx];
        return;
    }
    pwl_fails[idx] = pwl_fails[idx] + 1;

    // First failure: wipe cookie. Forces fresh /api/login/Basic on
    // next call, recovers from "stale-session" cascades. The @N
    // command (firmware-side: tc_call2pwl branch in xdrv_124_tinyc_vm.h)
    // returns immediately, no network roundtrip.
    if (pwl_fails[idx] == 1) {
        pwlRequest("@N");
        prof_log("  cookie cleared (will re-login on next call)");
    }

    // Exponential backoff: 4 ^ fail_count, capped at 256× nominal,
    // and at 5 minutes absolute. Cap of 256 prevents int32 overflow
    // for cadences of ~16 ms (none here, but defensive).
    uint32_t mult = 1;
    for (int i = 0; i < pwl_fails[idx]; i = i + 1) {
        mult = mult * 4;
        if (mult >= 256) { mult = 256; break; }
    }
    uint32_t newint = pwl_nominals[idx] * mult;
    if (newint > 300000) newint = 300000;
    pwl_intervals[idx] = newint;

    sprintf(prof_buf, "  backoff: %s fails=%d → interval=%u ms",
            name, pwl_fails[idx], newint);
    prof_log(prof_buf);

    // Escalating SSL-stack recovery, gated on FAST cadence (idx 0)
    // since that's the most-frequent canary:
    //
    //   Tier 1 — pwlRequest("@R"): firmware-level SSL reset (tears
    //   down + rebinds tc_ssl_client + tc_basic_client without a
    //   reboot). Fast (~50 ms), no impact on other slots. Fires
    //   ONCE at exactly PWL_RESET_THRESHOLD so we don't spam.
    //
    //   Tier 2 — tasmCmd("Restart 1"): chip reboot if @R didn't
    //   unstick anything. By this point we've been failing for
    //   ~13 min so a 30-s reboot window is fine.
    if (idx == 0 && pwl_fails[idx] == PWL_RESET_THRESHOLD) {
        sprintf(pwl_reboot_buf,
                "PWL: %d consecutive FAST fails — SSL reset (@R)",
                pwl_fails[idx]);
        addLog(pwl_reboot_buf);
        prof_log(pwl_reboot_buf);
        pwlRequest("@R");
    }
    if (idx == 0 && pwl_fails[idx] >= PWL_REBOOT_THRESHOLD) {
        sprintf(pwl_reboot_buf,
                "PWL: %d consecutive FAST fails — @R didn't unstick, rebooting",
                pwl_fails[idx]);
        addLog(pwl_reboot_buf);
        prof_log(pwl_reboot_buf);
        char resp[64];
        tasmCmd("Restart 1", resp);
    }
}

// FAST cadence (every 2 s): the four headline power flows. One call,
// four pwlGet extractions. Cost ~550 ms steady-state. Returns the
// pwlRequest result (0=ok, -1=fail) so TaskLoop can short-circuit.
int pwl_fast() {
    uint32_t t0 = millis();
    int res = pwlRequest("/api/meters/aggregates");
    if (res == 0) {
        sip = pwlGet("site#instant_power");
        bip = pwlGet("battery#instant_power");
        hip = pwlGet("load#instant_power");
        sop = pwlGet("solar#instant_power");
    }
    sprintf(prof_buf, "fast aggregates  %4u ms (res=%d)", millis() - t0, res);
    prof_log(prof_buf);
    pwl_handle_result(0, res, "fast");
    return res;
}

// MEDIUM cadence (every 10 s): per-CT decomposition (phases + per-string
// solar). Larger JSON, ~1600 ms. Already-aggregated values are covered
// by FAST so this is bonus detail.
int pwl_medium() {
    uint32_t t0 = millis();
    int res = pwlRequest("/api/meters/readings");
    if (res == 0) {
        // Off-by-one vs the original Scripter `gwr("p_W", N)` —
        // Scripter index N returns the substring between the (N-1)th
        // and Nth p_W, i.e. the value following the (N-1)th
        // occurrence; TinyC `pwlGet("p_W[N]")` returns the value
        // following the Nth occurrence directly. So Scripter's
        // p1w/p3w/p5w/p6w/p7w map to our p_W[1]/[3]/[5]/[6]/[7].
        // Reading p_W[2] / [4] (off-by-one) lands on slots the
        // Scripter intentionally skipped — both report 0 for solar
        // because those slots are empty on this CTS layout.
        p1w  = pwlGet("p_W[1]");    // solar string 1 (CTS1 channel 1)
        p3w  = pwlGet("p_W[3]");    // solar string 2 (CTS1 channel 3)
        phs1 = pwlGet("p_W[5]");    // grid phase 1 (CTS2 channel 1)
        phs2 = pwlGet("p_W[6]");    // grid phase 2
        phs3 = pwlGet("p_W[7]");    // grid phase 3
    }
    sprintf(prof_buf, "med  readings    %4u ms (res=%d)", millis() - t0, res);
    prof_log(prof_buf);
    pwl_handle_result(1, res, "med ");
    return res;
}

// SLOW cadence (every 60 s): battery state-of-energy + capacity totals.
// Two calls back-to-back, ~1100 ms total. Returns the WORSE of the
// two results so a single fail trips the cadence's backoff.
int pwl_slow() {
    uint32_t t0 = millis();
    int res1 = pwlRequest("/api/system_status/soe");
    if (res1 == 0) pwl = pwlGet("percentage");
    sprintf(prof_buf, "slow soe         %4u ms (res=%d)", millis() - t0, res1);
    prof_log(prof_buf);

    t0 = millis();
    int res2 = pwlRequest("/api/system_status");
    if (res2 == 0) {
        tcap = pwlGet("nominal_full_pack_energy");
        rcap = pwlGet("nominal_energy_remaining");
    }
    sprintf(prof_buf, "slow status      %4u ms (res=%d)", millis() - t0, res2);
    prof_log(prof_buf);

    int worst = (res1 != 0) ? res1 : res2;
    pwl_handle_result(2, worst, "slow");
    return worst;
}

// VSLOW cadence (every 5 min): backup reserve %. Only changes when
// the user adjusts it in the Tesla app — 5-min poll is cheap insurance.
int pwl_vslow() {
    uint32_t t0 = millis();
    int res = pwlRequest("/api/operation");
    if (res == 0) rper = pwlGet("backup_reserve_percent");
    sprintf(prof_buf, "vslow operation  %4u ms (res=%d)", millis() - t0, res);
    prof_log(prof_buf);
    pwl_handle_result(3, res, "vslow");
    return res;
}

void TaskLoop() {
    // Initial delay so Wi-Fi / network / display driver settle and
    // load_pwl_config() in main() has run.
    delay(10000);
    fileDelete("/pwl_prof.log");
    pwl_init_state();
    prof_log("multi-cadence loop starting (fast 2s / med 10s / slow 60s / vslow 300s)");
    addLog("PWL: multi-cadence loop running — see /pwl_prof.log");

    // Stagger initial fires by ~1 s each so we don't burn a 4-second
    // network burst at startup. After this initial round all four
    // cadences run on their own clocks.
    uint32_t now = millis();
    uint32_t next_fast   = now;
    uint32_t next_medium = now + 1000;
    uint32_t next_slow   = now + 3000;
    uint32_t next_vslow  = now + 5000;

    while (1) {
        now = millis();
        int wake_failed = 0;

        // Fire each cadence that's due. Setting next_* AFTER the
        // call (millis() + interval) measures gap from end-of-call,
        // and the interval comes from pwl_intervals[] (mutated by
        // pwl_handle_result on each call). When a call fails,
        // wake_failed shorts out the remaining cadences in this
        // wake — prevents the 4-call cascade observed in profiling
        // when the Powerwall briefly refuses connections.
        if (now >= next_fast) {
            int r = pwl_fast();
            next_fast = millis() + pwl_intervals[0];
            if (r != 0) wake_failed = 1;
        }
        if (!wake_failed && now >= next_medium) {
            int r = pwl_medium();
            next_medium = millis() + pwl_intervals[1];
            if (r != 0) wake_failed = 1;
        }
        if (!wake_failed && now >= next_slow) {
            int r = pwl_slow();
            next_slow = millis() + pwl_intervals[2];
            if (r != 0) wake_failed = 1;
        }
        if (!wake_failed && now >= next_vslow) {
            int r = pwl_vslow();
            next_vslow = millis() + pwl_intervals[3];
        }

        // 250 ms wake granularity. Fine for cadences ≥ 2 s — the
        // worst-case jitter on FAST is +12%, on the others negligible.
        delay(250);
    }
}

void EverySecond() {
    // First-tick: draw the static labels on the LCD. Done once,
    // because the labels never change. main() can't reliably do this
    // because the display driver isn't always ready by the time main
    // runs — EverySecond gives the driver a few seconds of grace.
    if (lcd_initialized == 0 && tasm_uptime > 3) {
        lcd_init_labels();
        lcd_initialized = 1;
    }

    // LCD clock — the `T` and `tS` format tags are interpreted by the
    // display driver at draw time (same backend the Scripter used),
    // so the values auto-refresh from Tasmota's clock. Drawn every
    // second for a smooth tick. Two short calls (~ms each), don't
    // contend with the Powerwall TaskLoop.
    //   [Ci3x50y40T]   color 3, x=50,  y=40, T = current time HH:MM
    //   [x150y40tS]    x=150, y=40, tS = small-format date
    if (lcd_initialized) {
        dspText("[Ci3x50y40T]");
        dspText("[x150y40tS]");
    }

    // Refresh LCD values every 5s — matches the Scripter cadence and
    // is plenty for a glance-able status screen. We throttle off
    // tasm_uptime instead of `% 5 == 0` so a missed second doesn't
    // skip the update for another 5s.
    if (lcd_initialized && (tasm_uptime - lcd_last_update) >= 5) {
        lcd_update_values();
        lcd_last_update = tasm_uptime;
    }

    // Console heartbeat (every 30 s) — same as before
    if (tasm_uptime % 30 == 0) {
        sprintf(buf, "PWL: Bat=%.1f%%", pwl);
        printString(buf);
        sprintf(buf, " Grid=%.0fW", sip);
        printString(buf);
        sprintf(buf, " Sol=%.0fW", sop);
        printString(buf);
        sprintf(buf, " Home=%.0fW\n", hip);
        printString(buf);
    }
}

void WebCall() {
    // Clock header (big green clock + sunrise/sunset row + live tick)
    web_clock_header();

    sprintf(buf, "{s}Battery{m}%.1f %%{e}", pwl);
    webSend(buf);
    sprintf(buf, "{s}Grid{m}%.0f W{e}", sip);
    webSend(buf);
    sprintf(buf, "{s}Solar{m}%.0f W{e}", sop);
    webSend(buf);
    sprintf(buf, "{s}Battery Power{m}%.0f W{e}", bip);
    webSend(buf);
    sprintf(buf, "{s}Home{m}%.0f W{e}", hip);
    webSend(buf);
    sprintf(buf, "{s}Total Capacity{m}%.1f kWh{e}", tcap / 1000.0);
    webSend(buf);
    sprintf(buf, "{s}Remaining{m}%.1f kWh{e}", rcap / 1000.0);
    webSend(buf);
    sprintf(buf, "{s}Reserve{m}%.0f %%{e}", rper);
    webSend(buf);
	
    sprintf(buf, "{s}Solar Phase 1{m}%.0f W{e}", p1w);
    webSend(buf);
    sprintf(buf, "{s}Solar Phase 2{m}%.0f W{e}", p3w);
    webSend(buf);
	
    sprintf(buf, "{s}Phase 1{m}%.0f W{e}", phs1);
    webSend(buf);
    sprintf(buf, "{s}Phase 2{m}%.0f W{e}", phs2);
    webSend(buf);
    sprintf(buf, "{s}Phase 3{m}%.0f W{e}", phs3);
    webSend(buf);
    sprintf(buf, "{s}Heap{m}%d kb{e}", tasm_heap / 1024);
    webSend(buf);
}

void JsonCall() {
    sprintf(buf, ",\"PWL\":{\"Battery\":%.1f", pwl);
    responseAppend(buf);
    sprintf(buf, ",\"Grid\":%.0f", sip);
    responseAppend(buf);
    sprintf(buf, ",\"Solar\":%.0f", sop);
    responseAppend(buf);
    sprintf(buf, ",\"BattPwr\":%.0f", bip);
    responseAppend(buf);
    sprintf(buf, ",\"Home\":%.0f}", hip);
    responseAppend(buf);
}

// Load Powerwall credentials from /powerwall.cfg (5 lines, in order):
//   line 1: gateway IP        (e.g. 192.168.188.60)
//   line 2: tesla email       (e.g. you@example.com)
//   line 3: tesla password
//   line 4: CTS1 serial       (hex, e.g. 0x000004714B006CCD)
//   line 5: CTS2 serial       (hex, same format)
// Returns 1 on success, 0 if file missing or malformed. Same pattern
// as examples/pool_pump.tc — keeps credentials out of source AND out
// of user_config_override.h, so the example is committable to a
// public repo and the firmware binary contains no secrets.
//
// Requires firmware ≥ 1.3.23 — earlier builds enforced a string
// literal as the first arg to pwlRequest (no runtime char[] buffer
// accepted). On older firmware this function compiles but the @D
// pwlRequest call is rejected at compile time.
int load_pwl_config() {
    char raw[256];
    int  h = fileOpen("/powerwall.cfg", 0);
    if (h < 0) return 0;
    int  n = fileRead(h, raw, 255);
    fileClose(h);
    if (n <= 0) return 0;
    raw[n] = 0;

    char ip[32];     ip[0]    = 0;
    char email[64];  email[0] = 0;
    char pw[32];     pw[0]    = 0;
    char c1[24];     c1[0]    = 0;
    char c2[24];     c2[0]    = 0;
    int line = 0;
    int j    = 0;
    for (int i = 0; i < n; i = i + 1) {
        int c = raw[i] & 0xFF;
        if (c == 13) continue;                                // skip \r
        if (c == 10) {                                        // \n → next field
            if      (line == 0) ip[j]    = 0;
            else if (line == 1) email[j] = 0;
            else if (line == 2) pw[j]    = 0;
            else if (line == 3) c1[j]    = 0;
            else if (line == 4) c2[j]    = 0;
            line = line + 1;
            j = 0;
            if (line >= 5) break;
        } else {
            if      (line == 0 && j < 31) { ip[j]    = c; j = j + 1; }
            else if (line == 1 && j < 63) { email[j] = c; j = j + 1; }
            else if (line == 2 && j < 31) { pw[j]    = c; j = j + 1; }
            else if (line == 3 && j < 23) { c1[j]    = c; j = j + 1; }
            else if (line == 4 && j < 23) { c2[j]    = c; j = j + 1; }
        }
    }
    // Files without a trailing newline: terminate the last partial field.
    if      (line == 0) ip[j]    = 0;
    else if (line == 1) email[j] = 0;
    else if (line == 2) pw[j]    = 0;
    else if (line == 3) c1[j]    = 0;
    else if (line == 4) c2[j]    = 0;

    if (strlen(ip) < 7 || strlen(email) < 3 || strlen(pw) < 1) return 0;

    // Build @D and @C config strings at runtime, hand them to
    // pwlRequest. The firmware-side handler reads via tc_ref_to_cstr
    // (≥ 1.3.23), so a stack-local char[] is accepted just as well
    // as a string literal. Comma is the field separator inside each
    // credential string.
    char cmd[160];
    sprintf(cmd, "@D%s,%s,%s", ip, email, pw);
    pwlRequest(cmd);

    if (strlen(c1) > 2 && strlen(c2) > 2) {
        sprintf(cmd, "@C%s,%s", c1, c2);
        pwlRequest(cmd);
    }
    return 1;
}

int main() {
    if (!load_pwl_config()) {
        addLog("PWL: cannot load /powerwall.cfg — upload a 5-line config (ip / email / password / cts1 / cts2) and restart slot");
    } else {
        addLog("PWL: credentials loaded from /powerwall.cfg");
    }
    return 0;
}
