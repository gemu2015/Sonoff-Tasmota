// @name: WAVE ROVER
// ONE program for the whole WAVE ROVER driver board (ESP32-WROOM-32UE, no PSRAM): motors, battery, IMU, compass, four floor
// sensors against a staircase, the touch joystick page and the display. One slot instead of several, because every TinyC
// slot costs about 9 KB of RAM on its own (measured on a classic ESP32, see docs/WAVE_ROVER.md).
//
//   http://<ip>/rover        joystick page (touch or mouse; arrow keys / WASD)
//   http://<ip>/rover_cmd?d=<-100..100>&t=<-100..100>&m=<10..100>   one drive command, answers a small JSON
//   console:  RoverEnc [0|1], RoverEncZero, RoverEncCal <mm>, RoverEncTpr <n>, RoverCalGyro, RoverYaw0, RoverCalMag 1|0, RoverCliff [0|1|<min> <max>], RoverPark [0|1], RoverTof <ch> <mm> (-1 = silent sensor), RoverVbat <mV>
//
// SAFETY, in the order it matters:
//  1. STAIRCASE: four VL53L0X floor sensors (TCA9548A channels 0..3 = front left, front right, rear left, rear right, looking
//     outward / down about 45 degrees). A sensor sees the floor when its distance is inside the window cl_min..cl_max (mm). A reading
//     outside it (nothing returned = a drop) or a sensor that is missing / silent for CLIFF_STALE_MS counts as a CLIFF. Then:
//     front cliff -> only straight reverse, rear cliff -> only straight forward, both (or a sensor fault) -> no movement at all.
//     This runs in this program, independent of anything that sends commands. RoverCliff 0 switches the protection off (log warning).
//  2. DEAD-MAN: a drive command must be renewed within WD_MS (300 ms), else the motors stop. The page sends one every 100 ms.
//  3. Battery guard: below VBAT_MIN_MV the motors are refused (3S Li-ion, INA219 at 0x42).
//  4. A slot stop (CleanUp) and the start of the program switch all motor pins off.
//  4b. MOTOR STALL (wheel encoders, off until RoverEnc 1): a side that is commanded but gives no tick for ENC_STALL_MS stops the rover until
//     the stick is released (see common/wheel_enc.tc for wiring, counters and calibration).
//  5. PARK MODE (RoverPark 1, or /rover_cmd?p=1): for a rover that stands still, on its charger or not. The motors are refused, the
//     floor sensors, IMU, compass and the display are no longer served (the chips keep running, only the I2C traffic and the display
//     stop), the loop sleeps, only the battery is read (every 5 s). A drive command wakes the rover (or RoverPark 0, /rover_cmd?p=0):
//     the floor sensors then have to answer again before any movement is allowed. PARK_AUTO_S > 0 parks it after that many seconds
//     without a command. The big consumers are not in this program: switch the lidar off on its own 5 V switch and let the S3 sleep.
//  6. SPEED CONTROL (RoverSpeed <mm/s>): with the wheel encoders the speed can be set exactly instead of a PWM share. RoverSpeed 30 means
//     a full stick deflection drives each wheel at 30 mm/s, half a stick 15 mm/s; a PI controller per wheel keeps it there by the ticks of
//     the last 200 ms (the slider "m" is not used then). RoverSpeed 0 = back to the open loop. Below SPD_PULSE_BELOW (24 mm/s) a wheel is
//     driven in bursts of 13 PWM (0.8 s period, the duty follows the measured mean speed): measured on the rover, unloaded, over 14 s: 15 mm/s
//     -> 16.6, 8 -> 9.8, 4 -> 5.4 mm/s. The motion is jerky there, only the mean is controlled. RoverSpeed shows the measured speeds.
// Motor side A = LEFT, B = RIGHT. Forward = IN1 high, IN2 low. Below PWM 23 the N20 motors do not turn.
//
// DISPLAY: the first 4 lines (21 characters, font 6x8, 128x32 pixel block) are what the Waveshare firmware shows on its OLED
// (title, IP address, state, battery); the same code works on the SSD1306 of the rover. DSP_EXTRA 1 adds a larger panel with the rest
// on a TFT.
//
// TEST WITHOUT THE ROVER: ROVER_SIM 1 does not touch the motor pins, takes the battery voltage from RoverVbat and the four distances
// from RoverTof (default 60 mm), so the display, the web page and the safety logic can be tried on any ESP32.
// NOT yet tested on the rover (the I2C drivers' decoding is covered by wave_sensors_test.tc).

#define ROVER_SIM   0            // 1 = simulated battery / floor sensors, no motor pins
#define ROVER_LIDAR 0            // 1 = LD19 lidar on LIDAR_RX (about 10 kB RAM, a fifth of the VM time); 0 = off
#define LIDAR_RX    27           // GPIO of the lidar TX line (IO27 = encoder channel B of the left wheel, so not with ENC_BOTH 1)
#define ROVER_LINK  0            // 1 = UDP link: a cam module (or any program) sends drive commands to LINK_PORT, the rover answers with its status
#define LINK_PORT   5006
#define DSP_EXTRA   1            // 1 = extra panel below the 4 OLED lines (TFT)

#if ROVER_SIM
#define ROVER_REAL  0
#else
#define ROVER_REAL  1
#endif

#include "ina219.tc"
#include "qmi8658.tc"
#include "ak09918.tc"
#include "vl53l0x_mux.tc"
#if ROVER_SIM
#define ENC_SIM 1
#endif
#include "wheel_enc.tc"
#if ROVER_LIDAR
#include "ld19.tc"
#endif

#define OUTPUT      3

#define PIN_PWMA    25
#define PIN_AIN1    21
#define PIN_AIN2    17
#define PIN_BIN1    22
#define PIN_BIN2    23
#define PIN_PWMB    26

#define DIR_L       1            // -1 turns the left side around
#define DIR_R       1
#define PWM_MIN     23
#define WD_MS       300
#define VMAX_START  40
#define INA_ADDR    0x42
#define I2C_BUS     0
#define VBAT_MIN_MV 9300
#define CLIFF_MIN   25           // floor window (mm along the beam); set to your mounting with RoverCliff <min> <max>
#define CLIFF_MAX   110
#define CLIFF_STALE_MS 600       // a sensor that did not answer for this long is a fault
#define SPD_WIN_MS  200          // speed control: the ticks of this window give the measured speed
#define SPD_PWM_LO  5            // lowest PWM the speed controller may use
#define SPD_PULSE_BELOW 24       // below this speed (mm/s) a wheel is driven in bursts (pulse mode), at or above it the PI controller
#define SPD_BURST_PWM 13         // PWM during a burst (the wheel keeps turning at about 30 mm/s with it once it runs)
#define SPD_KICK_PWM 22          // PWM of the first 50 ms of a burst: gets the wheel out of standstill
#define SPD_VON     30.0         // speed during a burst, mm/s (start value of the duty; the controller corrects it)
#define SPD_PER     16           // pulse period in 50 ms steps (16 = 0.8 s)
#define SPD_KD      0.5          // duty correction per period for a speed error equal to SPD_VON
#define SPD_KP      0.03         // PWM per mm/s of speed error change
#define SPD_KI      0.05         // PWM per mm/s of speed error per window
#define PARK_AUTO_S 0            // > 0: park after this many seconds without a drive command (0 = never)

int drive   = 0;
int turn    = 0;
int vmax    = VMAX_START;
int lastcmd = 0;
int motL    = 0;
int motR    = 0;
int stops   = 0;
int vbat_mv = 0;
int low     = 0;
int why     = 0;                 // why the motors are held: 0 free, 1 battery, 2 sensor fault, 3 front cliff, 4 rear cliff, 5 both, 6 parked, 7 motor stall
int park    = 0;                 // 1 = parked (see header)
int spd_full = 0;                // RoverSpeed: mm/s at a full stick (0 = open loop)
int spd_t0   = 0;
int spd_last[2];
int spd_pct[2];                  // signed share of each side (-100..100) as rover_apply() decided it
float spd_v[2];                  // measured speed per side, mm/s
float spd_out[2];                // controller output (PWM magnitude), 0 = side at rest
float spd_err[2];
int spd_mode[2];                 // 1 = pulse mode (bursts), 0 = PI controller
int spd_pls[2];                  // pulse mode: PWM of this 50 ms step (0 = pause)
float spd_duty[2];               // pulse mode: share of the period the wheel runs
int spd_ph = 0;                  // pulse mode: step in the period
int spd_t1 = 0;
int spd_last1[2];
int cl_on   = 1;
int cl_min  = CLIFF_MIN;
int cl_max  = CLIFF_MAX;
int cl_flag[4];                  // 1 = no floor in the window
int cl_front = 0;
int cl_rear  = 0;
int cl_fault = 1;                // 1 until all four sensors answered
int tof_ch   = 0;
int sim_tof[4];
int sim_vbat = 11800;
int ina_next = 0;
int dsp_n    = 0;
char ob[160];
char cb[24];
char ip[20];
char dl[40];

int rover_clamp(int v, int lo, int hi) {
    if (v < lo) { return lo; }
    if (v > hi) { return hi; }
    return v;
}

int rover_pwm(int pct) {
    int a = pct;
    int p = 0;
    if (a < 0) { a = 0 - a; }
    if (a == 0) { return 0; }
    p = PWM_MIN + ((255 - PWM_MIN) * a) / 100;
    if (pct < 0) { p = 0 - p; }
    return p;
}

void rover_side(int pwm, int pin_pwm, int pin_in1, int pin_in2) {
    int a = pwm;
#if ROVER_REAL
    if (a < 0) { a = 0 - a; }
    if (pwm == 0) {
        digitalWrite(pin_in1, 0);
        digitalWrite(pin_in2, 0);
        analogWrite(pin_pwm, 0);
    } else if (pwm > 0) {
        digitalWrite(pin_in1, 1);
        digitalWrite(pin_in2, 0);
        analogWrite(pin_pwm, a);
    } else {
        digitalWrite(pin_in1, 0);
        digitalWrite(pin_in2, 1);
        analogWrite(pin_pwm, a);
    }
#endif
}

// speed control: the PWM of one side for a signed share pct (-100..100); a side that starts is given the minimum PWM first
int spd_pwm(int s, int pct) {
    int p = 0;
    int a = pct;
    float tg = 0.0;
    if (a < 0) { a = 0 - a; }
    if (a == 0) {
        spd_out[s] = 0.0;
        spd_err[s] = 0.0;
        spd_pls[s] = 0;
        spd_mode[s] = 0;
        return 0;
    }
    tg = (float)a * (float)spd_full / 100.0;
    if (tg < (float)SPD_PULSE_BELOW) {
        if (spd_mode[s] == 0) {                        // enter pulse mode: start with the duty the nominal burst speed gives
            spd_mode[s] = 1;
            spd_duty[s] = tg / SPD_VON;
            spd_out[s] = 0.0;
            spd_last1[s] = enc_raw(s);
            spd_t1 = millis();
            spd_ph = 0;
            spd_pls[s] = SPD_KICK_PWM;
        }
        p = spd_pls[s];
    } else {
        if (spd_mode[s] == 1) { spd_mode[s] = 0; spd_out[s] = 0.0; spd_pls[s] = 0; }
        if (spd_out[s] == 0.0) {
            spd_out[s] = (float)PWM_MIN;
            spd_last[s] = enc_raw(s);
            spd_t0 = millis();
        }
        p = (int)spd_out[s];
    }
    if (pct < 0) { p = 0 - p; }
    return p;
}

// the one place where commands become motor values; every safety rule is applied here
void rover_apply() {
    int d = drive;
    int t = turn;
    int l = 0;
    int r = 0;
    int pl = 0;
    int pr = 0;
    why = 0;
    if (low == 1) { d = 0; t = 0; why = 1; }
    if (cl_on == 1) {
        if (cl_fault == 1) {
            d = 0; t = 0; why = 2;
        } else if (cl_front == 1 && cl_rear == 1) {
            d = 0; t = 0; why = 5;
        } else if (cl_front == 1) {
            if (d > 0) { d = 0; }
            t = 0; why = 3;
        } else if (cl_rear == 1) {
            if (d < 0) { d = 0; }
            t = 0; why = 4;
        }
    }
    if (enc_on == 1 && enc_stall != 0) { d = 0; t = 0; why = 7; }
    if (park == 1) { d = 0; t = 0; why = 6; }
    l = rover_clamp(d + t, -100, 100);
    r = rover_clamp(d - t, -100, 100);
    spd_pct[0] = l;
    spd_pct[1] = r;
    if (spd_full > 0) {
        pl = spd_pwm(0, l) * DIR_L;
        pr = spd_pwm(1, r) * DIR_R;
    } else {
        pl = rover_pwm((l * vmax) / 100) * DIR_L;
        pr = rover_pwm((r * vmax) / 100) * DIR_R;
    }
    if (pl != motL) {
        rover_side(pl, PIN_PWMA, PIN_AIN1, PIN_AIN2);
        motL = pl;
    }
    if (pr != motR) {
        rover_side(pr, PIN_PWMB, PIN_BIN1, PIN_BIN2);
        motR = pr;
    }
}

void rover_off() {
    drive = 0;
    turn = 0;
    motL = 1;
    motR = 1;
    rover_apply();
}

// speed controller, called every 50 ms: returns 1 when a PWM changed (the caller then applies it)
int spd_ctl() {
    int now = millis();
    int dt = now - spd_t0;
    int s = 0;
    int raw = 0;
    int d = 0;
    int a = 0;
    int ch = 0;
    int on = 0;
    int np = 0;
    float tg = 0.0;
    float err = 0.0;
    float v = 0.0;
    if (spd_full <= 0) { return 0; }
    // pulse mode: the phase of the period decides, the period's mean speed corrects the duty
    spd_ph = spd_ph + 1;
    if (spd_ph >= SPD_PER) {
        spd_ph = 0;
        dt = now - spd_t1;
        spd_t1 = now;
        if (dt < 1) { dt = 1; }
        s = 0;
        while (s < 2) {
            if (spd_mode[s] == 1) {
                raw = enc_raw(s);
                d = raw - spd_last1[s];
                spd_last1[s] = raw;
                if (d < 0) { d = 0; }
                v = (float)d * enc_mm_tick * 1000.0 / (float)dt;
                spd_v[s] = v;
                a = spd_pct[s];
                if (a < 0) { a = 0 - a; }
                tg = (float)a * (float)spd_full / 100.0;
                spd_duty[s] = spd_duty[s] + SPD_KD * (tg - v) / SPD_VON;
                if (spd_duty[s] < 0.03) { spd_duty[s] = 0.03; }
                if (spd_duty[s] > 1.0) { spd_duty[s] = 1.0; }
            }
            s = s + 1;
        }
    }
    s = 0;
    while (s < 2) {
        if (spd_mode[s] == 1 && spd_pct[s] != 0) {
            on = 0;
            if ((float)spd_ph < spd_duty[s] * (float)SPD_PER) { on = 1; }
            np = 0;
            if (on == 1) {
                np = SPD_BURST_PWM;
                if (spd_pls[s] == 0) { np = SPD_KICK_PWM; }
            }
            if (np != spd_pls[s]) {
                spd_pls[s] = np;
                ch = 1;
            }
        }
        s = s + 1;
    }
    // PI controller for the sides that run at 24 mm/s or more, once per window
    dt = now - spd_t0;
    if (dt < SPD_WIN_MS) { return ch; }
    spd_t0 = now;
    s = 0;
    while (s < 2) {
        if (spd_mode[s] == 0) {
            raw = enc_raw(s);
            d = raw - spd_last[s];
            spd_last[s] = raw;
            if (d < 0) { d = 0; }
            spd_v[s] = (float)d * enc_mm_tick * 1000.0 / (float)dt;
            a = spd_pct[s];
            if (a < 0) { a = 0 - a; }
            if (a > 0 && spd_out[s] > 0.0) {
                tg = (float)a * (float)spd_full / 100.0;
                err = tg - spd_v[s];
                spd_out[s] = spd_out[s] + SPD_KP * (err - spd_err[s]) + SPD_KI * err;
                spd_err[s] = err;
                if (spd_out[s] < (float)SPD_PWM_LO) { spd_out[s] = (float)SPD_PWM_LO; }
                if (spd_out[s] > 255.0) { spd_out[s] = 255.0; }
                ch = 1;
            }
        }
        s = s + 1;
    }
    return ch;
}

// evaluate the four floor sensors; returns 1 when the picture changed (then the motors must be re-evaluated)
int cliff_eval() {
    int ch = 0;
    int d = 0;
    int up = 0;
    int age = 0;
    int f = 0;
    int fr = 0;
    int re = 0;
    int fault = 0;
    int changed = 0;
    while (ch < 4) {
        up = vl_up[ch];
#if ROVER_SIM
        up = 1;
#endif
        age = millis() - vl_age[ch];
        d = vl_dist[ch];
        f = 0;
        if (up == 0 || age > CLIFF_STALE_MS || age < 0) {
            fault = 1;
            f = 1;
        } else if (d < cl_min || d > cl_max) {
            f = 1;
        }
        if (f != cl_flag[ch]) { changed = 1; }
        cl_flag[ch] = f;
        if (f == 1) {
            if (ch < 2) { fr = 1; } else { re = 1; }
        }
        ch = ch + 1;
    }
    if (fault != cl_fault || fr != cl_front || re != cl_rear) { changed = 1; }
    cl_fault = fault;
    cl_front = fr;
    cl_rear = re;
    return changed;
}

// one floor sensor per call (about 35 ms each on the real sensor)
void tof_step() {
    int ch = tof_ch;
#if ROVER_SIM
    if (sim_tof[ch] >= 0) {                  // a negative value simulates a silent sensor (RoverTof <ch> -1)
        vl_dist[ch] = sim_tof[ch];
        vl_age[ch] = millis();
    }
#else
    vl_poll(ch);
#endif
    tof_ch = (ch + 1) & 3;
}

void TaskLoop() {
    if (park == 0) {
#if ROVER_LIDAR
        lid_poll();                  // the ring holds 200 ms: poll between the slow I2C steps
#endif
        tof_step();
#if ROVER_LIDAR
        lid_poll();
#endif
        if (cliff_eval() == 1) {
            if (cl_fault == 0 && cl_on == 1) { addLog("ROVER: cliff F%d%d R%d%d", cl_flag[0], cl_flag[1], cl_flag[2], cl_flag[3]); }
            rover_apply();
        }
        qmi_poll();
        ak_poll();
#if ROVER_LIDAR
        lid_poll();
#endif
    }
    if (millis() >= ina_next) {
        if (park == 1) { ina_next = millis() + 5000; } else { ina_next = millis() + 1000; }
#if ROVER_SIM
        vbat_mv = sim_vbat;
#else
        ina_poll();
        vbat_mv = 0;
        if (ina_ok == 1) { vbat_mv = ina_mv; }
#endif
        if (vbat_mv > 0 && vbat_mv < VBAT_MIN_MV) {
            if (low == 0) { addLog("ROVER: battery low (%d mV), motors off", vbat_mv); }
            low = 1;
            rover_apply();
        } else if (vbat_mv >= VBAT_MIN_MV + 300) {
            if (low == 1) { low = 0; rover_apply(); }
        }
    }
    if (park == 1) { delay(250); } else { delay(5); }
}

// ---- display: the 4 OLED lines of the Waveshare firmware, then the extra panel -----------------------------------------

void dsp_line(int x, int y, int n, char t[]) {
    dspPos(x, y);
    dspPad(n);
    dspDraw(t);
}

void dsp_state(char t[]) {
    if (why == 1) { strcpy(t, "LOW BATTERY"); }
    else if (why == 2) { strcpy(t, "FLOOR SENSOR FAULT"); }
    else if (why == 3) { strcpy(t, "CLIFF AHEAD"); }
    else if (why == 4) { strcpy(t, "CLIFF BEHIND"); }
    else if (why == 5) { strcpy(t, "CLIFF F+R"); }
    else if (why == 6) { strcpy(t, "PARKED"); }
    else if (why == 7) { strcpy(t, "MOTOR STALL"); }
    else if (motL == 0 && motR == 0) { strcpy(t, "STOP"); }
    else { sprintf(t, "L%d R%d", motL, motR); }
}

// Colour helper: the 128x32 OLED is 1 bpp, there dspColor(0xFFFF,..) draws nothing; any colour -> 1
void dcol(int fg) {
    if (dspWidth() <= 128) { dspColor(1, 0); } else { dspColor(fg, 0x0000); }
}

// Li-ion charge in percent from the pack voltage (3S, per-cell curve, resting voltage; under motor load it reads lower).
// 3.10 V/cell = 0 % = same as VBAT_MIN_MV, where the motors are refused.
int lerp(int v, int v0, int v1, int p0, int p1) {
    return p0 + (v - v0) * (p1 - p0) / (v1 - v0);
}
int bat_pct(int mv) {
    int c = mv / 3;
    if (mv <= 0) { return -1; }
    if (c >= 4200) { return 100; }
    if (c >= 4000) { return lerp(c, 4000, 4200, 80, 100); }
    if (c >= 3800) { return lerp(c, 3800, 4000, 55, 80); }
    if (c >= 3600) { return lerp(c, 3600, 3800, 25, 55); }
    if (c >= 3400) { return lerp(c, 3400, 3600, 8, 25); }
    if (c >= 3100) { return lerp(c, 3100, 3400, 0, 8); }
    return 0;
}

int dpage = 0;   // OLED page counter: battery + IP page for 4 updates, then the state page for 2

// 128x32 OLED, big text (size 2 = 10 characters per line). Page 1: battery in percent + IP. Page 2: state.
void display_mono() {
    int ph = dpage % 6;
    dpage++;
    dspFont(0);
    dcol(0xFFFF);
    if (ph == 0 || ph == 4) { dspClear(); }          // clear on every page switch (pads differ)
    if (ph == 0) { tasmInfo(2, ip); }                // the IP is not known yet when the program starts at boot
    if (ph < 4) {
        dspSize(2);
        if (vbat_mv > 0) { sprintf(dl, "BAT %d%%", bat_pct(vbat_mv)); } else { strcpy(dl, "BAT --"); }
        dsp_line(0, 0, 10, dl);
        dspSize(1);
        sprintf(dl, "IP %s", ip);
        dsp_line(0, 20, 21, dl);
    } else {
        dsp_state(dl);
        if (strlen(dl) <= 10) {
            dspSize(2);
            dsp_line(0, 8, 10, dl);
        } else {
            dspSize(1);
            dsp_line(0, 12, 21, dl);
        }
    }
}

void display_update() {
    if (dspWidth() <= 128) { display_mono(); return; }
    dspFont(0);
    dspSize(1);
    dcol(0xFFFF);
    dsp_line(2, 1, 21, "WAVE ROVER");
    sprintf(dl, "IP:%s", ip);
    dsp_line(2, 9, 21, dl);
    dsp_state(dl);
    dsp_line(2, 17, 21, dl);
    if (vbat_mv > 0) {
        sprintf(dl, "V:%d.%02d  I:%d mA", vbat_mv / 1000, (vbat_mv % 1000) / 10, ina_ma);
    } else {
        strcpy(dl, "V:--");
    }
    dsp_line(2, 25, 21, dl);
#if DSP_EXTRA
    {
        dspFont(0);
        dspSize(2);
        dcol(0xFFFF);
        sprintf(dl, "Yaw %.0f  Hdg %.0f", qmi_yaw, ak_heading());
        dsp_line(2, 40, 20, dl);
        sprintf(dl, "Gz %.1f  T %.1f C", qmi_gz, qmi_temp);
        dsp_line(2, 58, 20, dl);
        dcol(0xFFE0);
        dsp_line(2, 82, 20, "Floor sensors (mm)");
        dcol(0xFFFF);
        sprintf(dl, "FL %d  FR %d", vl_dist[0], vl_dist[1]);
        dsp_line(2, 100, 20, dl);
        sprintf(dl, "RL %d  RR %d", vl_dist[2], vl_dist[3]);
        dsp_line(2, 118, 20, dl);
        if (cl_on == 0) {
            dcol(0xFFE0);
            dsp_line(2, 142, 20, "CLIFF GUARD OFF");
        } else if (why >= 2 && why <= 5) {
            dcol(0xF800);
            dsp_state(dl);
            dsp_line(2, 142, 20, dl);
        } else {
            dcol(0x07E0);
            dsp_line(2, 142, 20, "floor ok");
        }
    }
#endif
}

void display_first() {
    dspClear();
    display_update();
}

void park_set(int on) {
    int i = 0;
    if (on == park) { return; }
    if (on == 1) {
        rover_off();
        park = 1;
        rover_apply();
        dspOnOff(0);
        addLog("ROVER: parked (motors refused, sensors and display idle)");
    } else {
        park = 0;
        while (i < 4) { vl_age[i] = 0; i = i + 1; }   // every floor sensor has to answer again before the rover may move
        cl_fault = 1;
        dspOnOff(1);
        display_first();
        rover_apply();
        addLog("ROVER: awake, floor sensors are tested again");
    }
}

#if ROVER_LINK
// UDP LINK. Commands (text datagram to LINK_PORT, any subset of the fields):  "d=50 t=0 m=60 p=0"  (drive -100..100, turn -100..100,
// max speed 10..100, park 0/1). Same rules as /rover_cmd: every command re-arms the 300 ms watchdog, the battery / cliff / stall guards
// still win. The rover learns the sender's IP from the datagrams and sends its status there five times a second:
//   {"v":12.49,"l":0,"r":0,"wd":0,"lo":0,"cl":15,"why":2,"yaw":-0.3,"el":0,"er":0,"st":0,"age":120}   (age = ms since the last command)
// NO authentication, like /rover_cmd: anyone in the WLAN can drive the rover. Only for a trusted network.
char lk_rx[64];
char lk_tx[140];
char lk_ip[20];
char lk_tmp[12];
int  lk_open = 0;
int  lk_try  = 0;
int  lk_next = 0;
int  lk_cmds = 0;

int lk_int(char key[], int def) {
    int pos = strFind(lk_rx, key);
    if (pos < 0) { return def; }
    strSub(lk_tmp, lk_rx, pos + strlen(key), 8);
    return strToInt(lk_tmp);
}

void lk_status() {
    sprintf(lk_tx, "{\"v\":%d.%02d,\"l\":%d,\"r\":%d,\"wd\":%d,\"lo\":%d,\"cl\":%d,\"why\":%d,\"yaw\":%.1f,\"el\":%d,\"er\":%d,\"st\":%d,\"age\":%d}",
            vbat_mv / 1000, (vbat_mv % 1000) / 10, motL, motR, stops, low, cliff_mask(), why, qmi_yaw, enc_ticks[0], enc_ticks[1], enc_stall, millis() - lastcmd);
    udp(6, lk_ip, LINK_PORT, lk_tx);
}

void lk_poll() {
    int n = 0;
    if (lk_open == 0) {
        lk_try = lk_try + 1;
        if (lk_try >= 20) {
            lk_try = 0;
            if (udp(0, LINK_PORT) == 1) { lk_open = 1; addLog("ROVER: UDP link on port %d", LINK_PORT); }
        }
        return;
    }
    n = udp(1, lk_rx);
    if (n > 0) {
        udp(4, lk_ip);
        lk_cmds = lk_cmds + 1;
        drive = rover_clamp(lk_int("d=", 0), -100, 100);
        turn = rover_clamp(lk_int("t=", 0), -100, 100);
        vmax = rover_clamp(lk_int("m=", vmax), 10, 100);
        if (lk_int("p=", -1) >= 0) { park_set(lk_int("p=", 0)); }
        if (park == 1 && (drive != 0 || turn != 0)) { park_set(0); }
        lastcmd = millis();
        if (drive == 0 && turn == 0) { enc_stall = 0; }
        rover_apply();
        lk_status();
    }
    if (strlen(lk_ip) > 0 && millis() >= lk_next) {
        lk_next = millis() + 200;
        lk_status();
    }
}
#endif

void Every50ms() {
    if (millis() - lastcmd > WD_MS) {
        if (motL != 0 || motR != 0) {
            if (drive != 0 || turn != 0) { stops = stops + 1; }
        }
        drive = 0;
        turn = 0;
        rover_apply();
    }
    enc_update(motL * DIR_L, motR * DIR_R);
    if (spd_ctl() == 1) { rover_apply(); }
    if (enc_on == 1 && enc_stall != 0 && why != 7) { rover_apply(); }
    if (PARK_AUTO_S > 0 && park == 0 && millis() - lastcmd > PARK_AUTO_S * 1000) { park_set(1); }
    dsp_n = dsp_n + 1;
    if (dsp_n >= 10) {
        dsp_n = 0;
        if (park == 0) { display_update(); }
    }
#if ROVER_LINK
    lk_poll();
#endif
}

// ---- web ---------------------------------------------------------------------------------------------------------------

int cliff_mask() {
    return cl_flag[0] + cl_flag[1] * 2 + cl_flag[2] * 4 + cl_flag[3] * 8;
}

void WebCall() {
    dsp_state(dl);
    sprintf(ob, "{s}Rover{m}%s   motors L / R %d / %d  (watchdog stops %d){e}", dl, motL, motR, stops);
    webSend(ob);
    if (vbat_mv > 0) {
        sprintf(ob, "{s}Battery{m}%d.%02d V  %d %%  %d mA{e}", vbat_mv / 1000, (vbat_mv % 1000) / 10, bat_pct(vbat_mv), ina_ma);
        webSend(ob);
    } else {
        webSend("{s}Battery (INA219){m}no data{e}");
    }
    sprintf(ob, "{s}Floor sensors FL FR RL RR{m}%d  %d  %d  %d mm   window %d..%d{e}", vl_dist[0], vl_dist[1], vl_dist[2], vl_dist[3], cl_min, cl_max);
    webSend(ob);
    if (qmi_ok == 1) {
        sprintf(ob, "{s}IMU yaw / gyro z{m}%.1f deg  %.2f dps  %.1f C{e}", qmi_yaw, qmi_gz, qmi_temp);
        webSend(ob);
    }
    if (ak_addr != 0) {
        sprintf(ob, "{s}Compass{m}heading %.0f{e}", ak_heading());
        webSend(ob);
    }
    if (enc_on == 1 || enc_seen[0] == 1 || enc_seen[1] == 1 || ENC_SIM == 1) {
        sprintf(ob, "{s}Wheel encoders L / R{m}%d / %d ticks   %d / %d mm   %d / %d mm/s{e}", enc_ticks[0], enc_ticks[1], (int)enc_mm[0], (int)enc_mm[1], (int)enc_v[0], (int)enc_v[1]);
        webSend(ob);
        sprintf(ob, "{s}Odometry{m}x %d  y %d mm   heading %.1f deg   stall %d   guard %d{e}", (int)enc_x, (int)enc_y, enc_th * 57.29578, enc_stall, enc_on);
        webSend(ob);
    } else {
        webSend("{s}Wheel encoders{m}no ticks yet (RoverEnc 1 switches the stall guard on){e}");
    }
#if ROVER_LIDAR
    if (lid_ok() == 1) {
        sprintf(ob, "{s}Lidar front / left{m}%d / %d mm   back / right %d / %d mm{e}", lid_min(330, 30), lid_min(60, 120), lid_min(150, 210), lid_min(240, 300));
        webSend(ob);
        sprintf(ob, "{s}Lidar scans / speed{m}%d  %d ms per turn  packets ok / crc %d / %d{e}", lid_scans, lid_scan_ms, lid_n_ok, lid_n_crc);
        webSend(ob);
    } else {
        webSend("{s}Lidar{m}no data (LIDAR_RX wired? 5 V on?){e}");
    }
#endif
    webSend("{s}Rover page{m}<a href='/rover'>/rover</a>{e}");
}

void JsonCall() {
    sprintf(ob, ",\"Rover\":{\"Vbat\":%d.%03d,\"Cliff\":%d,\"Why\":%d,\"Park\":%d", vbat_mv / 1000, vbat_mv % 1000, cliff_mask(), why, park);
    responseAppend(ob);
    if (qmi_ok == 1) {
        sprintf(ob, ",\"Yaw\":%.1f", qmi_yaw);
        responseAppend(ob);
    }
    sprintf(ob, ",\"EncL\":%d,\"EncR\":%d,\"Stall\":%d", enc_ticks[0], enc_ticks[1], enc_stall);
    responseAppend(ob);
    responseAppend("}");
}

// the joystick page lives in the file /rover.html on the device (upload examples/rover.html): about 2 KB less bytecode in RAM
void rover_page() {
    webSendFile("/rover.html");
}

void WebOn() {
    int h = webHandler();
    if (h == 1) {
        rover_page();
    }
    if (h == 2) {
        if (webArg("d", cb) > 0) { drive = rover_clamp(strToInt(cb), -100, 100); }
        if (webArg("t", cb) > 0) { turn = rover_clamp(strToInt(cb), -100, 100); }
        if (webArg("m", cb) > 0) { vmax = rover_clamp(strToInt(cb), 10, 100); }
        if (webArg("p", cb) > 0) { park_set(strToInt(cb)); }
        if (park == 1 && (drive != 0 || turn != 0)) { park_set(0); }
        lastcmd = millis();
        if (drive == 0 && turn == 0) { enc_stall = 0; }   // the stick is released: a stall is cleared
        rover_apply();
        sprintf(ob, "{\"v\":%d.%02d,\"l\":%d,\"r\":%d,\"wd\":%d,\"lo\":%d,\"cl\":%d,\"el\":%d,\"er\":%d,\"st\":%d,\"sl\":%d,\"sr\":%d}", vbat_mv / 1000, (vbat_mv % 1000) / 10, motL, motR, stops, low, cliff_mask(), enc_ticks[0], enc_ticks[1], enc_stall, (int)spd_v[0], (int)spd_v[1]);
        webSend(ob);
    }
}

void Command(char cmd[]) {
    char a[12];
    char b[12];
    int ch = 0;
    if (strcmp(cmd, "CALGYRO") == 0) {
        qmi_cal_gyro(200);
        responseCmnd("gyro bias set");
    } else if (strcmp(cmd, "YAW0") == 0) {
        qmi_yaw_reset();
        responseCmnd("yaw 0");
    } else if (strStartsWith(cmd, "CALMAG")) {
        if (strFind(cmd, "1") > 0) {
            ak_cal_begin();
            responseCmnd("turn the rover slowly through a full circle, then RoverCalMag 0");
        } else {
            ak_cal_end();
            responseCmnd("compass offsets set");
        }
    } else if (strStartsWith(cmd, "SPEED")) {
        strToken(a, cmd, ' ', 2);
        if (strlen(a) > 0) {
            spd_full = rover_clamp(strToInt(a), 0, 600);
            spd_out[0] = 0.0;
            spd_out[1] = 0.0;
            spd_mode[0] = 0;
            spd_mode[1] = 0;
            rover_apply();
        }
        sprintf(ob, "full stick %d mm/s (0 = open loop), measured %d / %d mm/s, pwm %d / %d, pulse %d / %d duty %d / %d %%", spd_full, (int)spd_v[0], (int)spd_v[1], (int)spd_out[0], (int)spd_out[1], spd_mode[0], spd_mode[1], (int)(spd_duty[0] * 100.0), (int)(spd_duty[1] * 100.0));
        responseCmnd(ob);
    } else if (strStartsWith(cmd, "ENCSIM")) {
        strToken(a, cmd, ' ', 2);
        if (strlen(a) > 0) { enc_sim_tps = strToInt(a); }
        responseCmnd("ok");
    } else if (strStartsWith(cmd, "ENCZERO")) {
        enc_zero();
        responseCmnd("encoders zeroed");
    } else if (strStartsWith(cmd, "ENCCAL")) {
        strToken(a, cmd, ' ', 2);
        if (enc_cal(strToInt(a)) == 1) {
            sprintf(ob, "%.3f mm per tick, %.0f ticks per wheel revolution", enc_mm_tick, (2.0 * 3.14159265 * ENC_WHEEL_R_MM) / enc_mm_tick);
            responseCmnd(ob);
        } else {
            responseCmnd("need 10 ticks and 10 mm (RoverEncZero, roll, RoverEncCal <mm>)");
        }
    } else if (strStartsWith(cmd, "ENCTPR")) {
        strToken(a, cmd, ' ', 2);
        if (strlen(a) > 0) { enc_set_tpr(strToInt(a)); }
        sprintf(ob, "%.3f mm per tick", enc_mm_tick);
        responseCmnd(ob);
    } else if (strStartsWith(cmd, "ENC")) {
        strToken(a, cmd, ' ', 2);
        if (strlen(a) > 0) {
            enc_on = strToInt(a);
            if (enc_on == 0) { enc_stall = 0; }
            rover_apply();
        }
        sprintf(ob, "guard %d, ticks %d / %d, seen %d / %d, stall %d", enc_on, enc_ticks[0], enc_ticks[1], enc_seen[0], enc_seen[1], enc_stall);
        responseCmnd(ob);
    } else if (strStartsWith(cmd, "CLIFF")) {
        strToken(a, cmd, ' ', 2);
        strToken(b, cmd, ' ', 3);
        if (strlen(a) == 0) {
            sprintf(ob, "guard %d, window %d..%d mm, F%d%d R%d%d fault %d", cl_on, cl_min, cl_max, cl_flag[0], cl_flag[1], cl_flag[2], cl_flag[3], cl_fault);
            responseCmnd(ob);
        } else if (strlen(b) == 0) {
            cl_on = strToInt(a);
            if (cl_on == 0) { addLog("ROVER: CLIFF GUARD OFF - the rover can drive off an edge"); }
            rover_apply();
            responseCmnd("ok");
        } else {
            cl_min = strToInt(a);
            cl_max = strToInt(b);
            responseCmnd("window set");
        }
    } else if (strStartsWith(cmd, "PARK")) {
        strToken(a, cmd, ' ', 2);
        if (strlen(a) > 0) { park_set(strToInt(a)); }
        sprintf(ob, "park %d", park);
        responseCmnd(ob);
    } else if (strStartsWith(cmd, "TOF")) {
        strToken(a, cmd, ' ', 2);
        strToken(b, cmd, ' ', 3);
        ch = strToInt(a);
        if (ch >= 0 && ch < 4 && strlen(b) > 0) { sim_tof[ch] = strToInt(b); }
        responseCmnd("ok");
    } else if (strStartsWith(cmd, "VBAT")) {
        strToken(a, cmd, ' ', 2);
        if (strlen(a) > 0) { sim_vbat = strToInt(a); }
        responseCmnd("ok");
    } else {
        responseCmnd("unknown");
    }
}

void CleanUp() {
    if (park == 1) { dspOnOff(1); }
    rover_off();
    ina_release();
    qmi_release();
    ak_release();
    vl_release();
}

// OnExit = program stopped or replaced; CleanUp only runs at a restart. Motors off and the I2C addresses back, so a reload starts clean.
void OnExit() {
    CleanUp();
}

int main() {
    int i = 0;
    while (i < 4) { sim_tof[i] = 60; cl_flag[i] = 1; i = i + 1; }
    addCommand("Rover");
#if ROVER_REAL
    {
        pinMode(PIN_PWMA, OUTPUT);
        pinMode(PIN_AIN1, OUTPUT);
        pinMode(PIN_AIN2, OUTPUT);
        pinMode(PIN_PWMB, OUTPUT);
        pinMode(PIN_BIN1, OUTPUT);
        pinMode(PIN_BIN2, OUTPUT);
    }
#endif
    rover_off();
    enc_init();
    lastcmd = millis();
    // A reload (unload + run) leaves the I2C addresses of the previous run claimed, then every init below fails
    // silently (Vbat 0, no yaw): give them back first, through the drivers' own release functions.
    ina_addr = INA_ADDR;  ina_bus = I2C_BUS;  ina_release();
    qmi_addr = 0x6B;      qmi_bus = I2C_BUS;  qmi_release();
    ak_addr = AK_ADDR;    ak_bus = I2C_BUS;   ak_release();
    vl_bus = I2C_BUS;  vl_claimed = 1;  vl_mux_ok = 1;  vl_release();
    ina_init(INA_ADDR, I2C_BUS);
#if ROVER_LIDAR
    lid_init(LIDAR_RX);
#endif
    qmi_init(I2C_BUS, 2, 5, 3);
    ak_init(I2C_BUS, 8);
    if (qmi_ok == 1) { qmi_cal_gyro(200); }
#if ROVER_REAL
    {
        if (vl_mux_init(I2C_BUS) == 1) {
            vl_timeout = 60;
            i = 0;
            while (i < 4) {
                if (vl_start(i) == 0) { addLog("ROVER: floor sensor %d not found", i); }
                i = i + 1;
            }
        } else {
            addLog("ROVER: TCA9548A not found, the cliff guard keeps the motors off (RoverCliff 0 to override)");
        }
    }
#endif
    tasmInfo(2, ip);
    webOn(1, "/rover");
    webOn(2, "/rover_cmd");
    display_first();
    addLog("ROVER: ready (sim %d), page /rover, watchdog %d ms, cliff window %d..%d mm", ROVER_SIM, WD_MS, cl_min, cl_max);
    return 0;
}
