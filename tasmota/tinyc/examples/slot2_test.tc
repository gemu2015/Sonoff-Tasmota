// Slot 2 test — Counter C (counts down from 1000)
int counterC = 1000;

void EverySecond() {
    counterC--;
    if (counterC < 0) {
        counterC = 1000;
    }
}

void WebCall() {
    char buf[64];
    sprintfInt(buf, "{s}Slot 2 Counter C{m}%d{e}", counterC);
    webSend(buf);
}

int main() {
    return 0;
}
