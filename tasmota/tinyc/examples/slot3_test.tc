// Slot 3 test — Counter D (toggles 0/1 every second)
int counterD = 0;
int toggles = 0;

void EverySecond() {
    if (counterD == 0) {
        counterD = 1;
    } else {
        counterD = 0;
    }
    toggles++;
}

void WebCall() {
    char buf[64];
    sprintfInt(buf, "{s}Slot 3 Toggle{m}%d{e}", counterD);
    webSend(buf);
    sprintfInt(buf, "{s}Slot 3 Toggles{m}%d{e}", toggles);
    webSend(buf);
}

int main() {
    return 0;
}
