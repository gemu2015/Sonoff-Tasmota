// sml_chart_bezug.tc — SML meter WITHOUT a feed-in counter.
// Same family as sml_chart.tc (ottelo); the only difference is where the
// "energy fed back" total comes from. A Bezugszaehler reports current power
// that goes negative on export but carries no separate energy-out register,
// so the total is integrated from the negative power readings:
//
//   5 s tick:  power < 0  ->  add |power| to a Watt-sum
//   60 s tick: total += sum / 720000        (12 samples x 60 s x 1000 W -> kWh)
//
// SML_PV_TOTAL points the shared chart code at that virtual counter — see
// sml_chart_common.tc. Everything else (charts, tables, rollover, settings,
// Modbus-TCP) is inherited unchanged.
// TinyC port of ottelo's 3_SML_Chart_PV_Bezugszaehler.tas.
// Docs: https://ottelo9.github.io/tasmota-sml-script/sml/
// Needs ESP32, TinyC in slot 0 (for /pwr), USE_SML.

// Must stand BEFORE the include: it replaces smlGet(3) inside the shared code.
#define SML_PV_TOTAL sml_bezug_total

#include "sml_chart_common.tc"
#include "sml_modbus_common.tc"

char sml_vers[] = "19.08.2026";

// ─── The virtual feed-in counter ───────────────────────────────────────────
persist float sml_bezug_total;   // integrated kWh fed back to the grid
float sml_ptogrid_sum;           // running Watt-sum between two 60 s ticks

// ─── Settings ──────────────────────────────────────────────────────────────

int sml_e_pv; int sml_e_sndpwr;   // edit buffer, applied by Save

// ─── Transient WebButton flags ─────────────────────────────────────────────
int do_init;
int do_init2;
int do_reset;
int do_csv;

// ─── Callbacks ─────────────────────────────────────────────────────────────

void Every100ms() {
    mbPoll();
}

void EverySecond() {
    uiApplyBegin();
    // Reload the edit buffer from what is actually in effect on a fresh page
    // render, so unsaved typing does not linger in the widgets (ottelo, 23.8.).
    if (ui_reloading) { sml_e_pv = sml_pv; sml_e_sndpwr = sml_sndpwr; }
    if (ui_applying)  { sml_pv = sml_e_pv; sml_sndpwr = sml_e_sndpwr; }
    sml_descriptor_apply();
    mbTick();

    if (do_reset) {
        tasmCmd("Sensor53 r", sml_pv_resp);
        do_reset = 0;
    }

    // CSV export deliberately BEFORE the NTP/meter returns below: getting the
    // stored data out has to work on a device whose meter is silent, which is
    // exactly when someone wants it (mi-hol, #119).
    if (do_csv) {
        sml_chart_export_csv();
        if (sml_pv > 0) sml_chart_pv_export_csv();
        do_csv = 0;
    }

    if (tasm_year < 2020) return;
    if (smlGet(2) == 0.0) return;

    if (do_init) {
        sml_chart_init_baselines();
        sml_chart_pv_init_baselines();
        do_init = 0;
    }
    if (do_init2) {
        sml_chart_init_columns();
        sml_chart_pv_init_columns();
        do_init2 = 0;
    }
    sml_t1 = sml_t1 - 1;
    if (sml_t1 <= 0) {
        sml_t1 = 5;
        sml_chart_5s_tick();
        // Collect the export side BEFORE the shared tick smooths the power:
        // only the sign of the raw reading tells export from import.
        float p = smlGet(1);
        if (p < 0.0) sml_ptogrid_sum = sml_ptogrid_sum - p;
        sml_chart_pv_5s_tick();
    }
    sml_t2 = sml_t2 - 1;
    if (sml_t2 <= 0) {
        sml_t2 = 60;
        sml_chart_60s_tick();
        // Integrate FIRST, then let the shared tick read the new total.
        if (sml_ptogrid_sum > 0.0) {
            sml_bezug_total = sml_bezug_total + sml_ptogrid_sum / 720000.0;
            sml_ptogrid_sum = 0.0;
        }
        sml_chart_pv_60s_tick();
    }
}

// /pwr — JSON for a second battery polling over HTTP (opendtu-onbattery DPL)
void WebOn() {
    int h = webHandler();
    if (h != 1) return;
    if (sml_sndpwr > 0) {
        sprintf(sml_buf, "{\"power2\":%.0f", sml_power2);
        sprintfAppend(sml_buf, ",\"power\":%.0f", smlGet(1));
        sprintfAppend(sml_buf, ",\"in\":%.3f", smlGet(2));
        sprintfAppend(sml_buf, ",\"out\":%.3f}", sml_bezug_total);
    } else {
        strcpy(sml_buf, "{\"enabled\":0}");
    }
    webSend(sml_buf);
}

void WebCall() {
    if (!sml_activ) {
        uiText("{s}SML{m}off (Rule1){e}", "{s}SML{m}aus (Rule1){e}");
        return;
    }
    // Same place ottelo gives it in his variants (render_meter -> phase_rows ->
    // render_totals); this one has no render_meter. Inert unless sml_ph3 is on.
    sml_phase_rows();
    sml_chart_render_totals();

    if (sml_pv > 0) {
        float eout = sml_bezug_total;
        if (ui_de) {
            sprintf(sml_buf, "{s}Tageseinspeisung{m}%.2f kWh{e}",  eout - sml_dval2); webSend(sml_buf);
            sprintf(sml_buf, "{s}Monatseinspeisung{m}%.2f kWh{e}", eout - sml_mval2); webSend(sml_buf);
            sprintf(sml_buf, "{s}Jahreseinspeisung{m}%.2f kWh{e}", eout - sml_yval2); webSend(sml_buf);
        } else {
            sprintf(sml_buf, "{s}Export day{m}%.2f kWh{e}",   eout - sml_dval2); webSend(sml_buf);
            sprintf(sml_buf, "{s}Export month{m}%.2f kWh{e}", eout - sml_mval2); webSend(sml_buf);
            sprintf(sml_buf, "{s}Export year{m}%.2f kWh{e}",  eout - sml_yval2); webSend(sml_buf);
        }
    }
    mbRows();
    sml_chart_link();
}

void WebUI() {
    if (webPage() == 2) { sml_chart_page_render(); return; }
    if (webPage() == 3) { webSend("<script>location.replace('/tc')</script>"); return; }
    if (webPage() != 0) return;
    sml_render_settings_panel();

    uiHead("&#x2600;&#xFE0F;", "PV", "PV", "sml/#pv");
    if (ui_de) webCheckbox(sml_e_pv, "Einspeisung anzeigen (gerechnet)");
    else       webCheckbox(sml_e_pv, "Show feed-in (computed)");
    uiText("<div style='font-size:11px;color:#555;margin:4px 0'>This meter has no export register - the total is integrated from negative power. It starts at zero and only grows while the script is running.</div>",
           "<div style='font-size:11px;color:#555;margin:4px 0'>Dieser Zaehler hat kein Einspeise-Register - der Zaehlerstand wird aus negativer Leistung aufsummiert. Er beginnt bei null und waechst nur, solange das Skript laeuft.</div>");
    if (ui_de) sprintf(sml_buf, "<div style='font-size:12px;color:#444'>Gerechneter Einspeisezaehler: <b>%.3f kWh</b></div>", sml_bezug_total);
    else       sprintf(sml_buf, "<div style='font-size:12px;color:#444'>Computed export counter: <b>%.3f kWh</b></div>", sml_bezug_total);
    webSend(sml_buf);

    uiHead("&#x1F527;", "Telemetry", "Telemetrie", "sml/#telemetry");
    if (ui_de) webCheckbox(sml_e_sndpwr, "Gemittelte Leistung senden");
    else       webCheckbox(sml_e_sndpwr, "Publish smoothed power");
    if (ui_de) sprintf(sml_buf, "<div style='font-size:12px;color:#444'>Leistung (gefiltert): <b>%.0f W</b></div>", sml_power2);
    else       sprintf(sml_buf, "<div style='font-size:12px;color:#444'>Power (smoothed): <b>%.0f W</b></div>", sml_power2);
    webSend(sml_buf);
    if (sml_e_sndpwr > 0) {
        webSend("<div style='font-size:12px;color:#444'>MQTT: power2 &middot; HTTP: <a href='/pwr'>/pwr</a></div>");
    }
    mbPanel();

    sml_chart_data_panel(varIdx(do_init), varIdx(do_init2), varIdx(do_csv));
    webSend("<hr>");
    uiSaveButton();
    if (ui_de) webButton(do_reset, "SML neu laden|neu geladen");
    else       webButton(do_reset, "Restart SML|restarted");

    sprintf(sml_buf, "<hr><div style='text-align:center;font-size:10px;color:#555;line-height:1.5'>sml_chart_bezug.tc &middot; Version %s<br>", sml_vers);
    webSend(sml_buf);
    webSend("by <a href='https://ottelo.jimdofree.com' target='_blank'>ottelo.jimdofree.com</a> &amp; gemu2015 (TinyC <span id='tcv'>...</span>)</div></div>");
    webSend("<script>if(window.__tcv){document.getElementById('tcv').textContent=window.__tcv;}else{fetch('/tc_api?cmd=status').then(function(r){return r.json();}).then(function(j){window.__tcv=j.release;var e=document.getElementById('tcv');if(e)e.textContent=j.release;}).catch(function(){});}</script>");
}

int main() {
    if (sml_rx_pin == 0 && sml_tx_pin == 0) {
        sml_rx_pin = -1;
        sml_tx_pin = -1;
    }
    if (sml_da == 0) sml_da = 1;
    if (sml_activ != tasm_rule) tasm_rule = sml_activ;

    sml_e_pv = sml_pv;
    sml_e_sndpwr = sml_sndpwr;
    sml_chart_load();
    sml_chart_pv_load();

    mbInit();
    webPageLabel(0, "&#x2699;&#xFE0F; SML");
    webPageLabel(1, "");
    webPageLabel(2, "");                  // charts page, reached by link
    webPageLabel(3, "&#x1F4BB; TinyC");   // hands over to /tc
    webOn(1, "/pwr");
    smlScripterLoad("/sml_meter.def");

    addLog("sml_chart_bezug: %s started rx=%d meter=%d pv=%d modbus=%d virt=%.3f",
           sml_vers, sml_rx_pin, sml_meter_sel, sml_pv, mb_on, sml_bezug_total);
    return 0;
}
