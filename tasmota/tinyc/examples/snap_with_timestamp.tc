// snap_with_timestamp.tc
// Capture a camera frame and save it to the filesystem as a JPEG with a
// timestamp-suffixed filename like /snap_2026-05-14_08-30-12.jpg.
//
//   camControl(0, framesize, 0)               — init camera (CAM_VGA = 640x480)
//   camControl(10, cam_slot, 0) -> size       — capture to PSRAM cam slot (1-based)
//   camControl(11, cam_slot, fh) -> bytes     — write slot bytes to file handle
//   camControl(14, cam_slot, 0) -> size       — query slot size
//   camControl(12, cam_slot, 0)               — free slot (0 = free all)
//   camControl(13, 0, 0)                       — deinit (free everything, stop stream)
//
// NOTE: this example USED to demonstrate burning a timestamp INTO the
// pixel data via `dspImgTextBurn` + `dspLoadImageFromCam` /
// `dspImageToCam` — those JPEG-decode / re-encode bridge builtins were
// never shipped in mainline TinyC. The timestamp now goes into the
// filename instead, which is simpler and doesn't need PSRAM or JPEG
// decoding. If you want pixel-burned overlays, your options are:
//   - render the timestamp text as a separate small image via dsp* APIs
//     on the live display, screenshot it, composite client-side
//   - use a different framework (Pekko, ESPHome) that has the full
//     image-overlay pipeline ready
//
// Requires: a camera-enabled build (e.g. env "tinyc32s3-cam"). The display
// libs are NOT required by this version — only camera + file I/O.

#define CAM_VGA   8           // framesize_t: 640x480
#define CAM_SLOT  1           // PSRAM slot for the capture (1-based, 1..TC_CAM_MAX_SLOTS)

int interval;                 // seconds between snapshots (0 = one-shot)
int counter;
char path[60];

int main() {
    interval = 0;             // change to e.g. 60 for one snap/minute
    counter  = 0;
    int r = camControl(0, CAM_VGA, 0);   // init camera, VGA
    if (r < 0) {
        addLog("snap_with_timestamp: camera init failed");
        return -1;
    }
    addLog("snap_with_timestamp: ready");
    if (interval == 0) {
        take_snap();
    }
    return 0;
}

void take_snap() {
    int size = camControl(10, CAM_SLOT, 0);          // capture JPEG to PSRAM slot
    if (size <= 0) { addLog("capture failed"); return; }

    // Build filename with timestamp (filesystem-safe characters only —
    // no colons, since some FS choke on them). Format:
    //   /snap_YYYY-MM-DD_HH-MM-SS.jpg
    counter = counter + 1;
    sprintf(path, "/snap_%04d-%02d-%02d_%02d-%02d-%02d.jpg",
            tasm_year, tasm_month, tasm_day,
            tasm_hour, tasm_minute, tasm_second);

    int fh = fileOpen(path, "w");
    if (fh < 0) { addLog("file open failed"); return; }
    int n = camControl(11, CAM_SLOT, fh);            // write slot to file
    fileClose(fh);

    char msg[80];
    sprintf(msg, "saved %s (%d bytes)", path, n);
    addLog(msg);
}

void EverySecond() {
    if (interval == 0) return;
    static int tick = 0;
    tick = tick + 1;
    if (tick >= interval) {
        tick = 0;
        take_snap();
    }
}
