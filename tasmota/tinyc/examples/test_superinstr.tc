// inctest.tc — darf der Peephole das? Jede Zeile ist ein Fall, in dem
// falsches Verschmelzen ein anderes Programm ergaebe.
int g_zaehler;          // global -> darf NICHT verschmolzen werden
watch int g_beob;       // watch-global -> STORE_WATCH muss laufen
int feld[20];
#define GRENZE 6
#define WEIT 1000

int main() {
    int f = 0;

    // 1) i++ und i-- als Anweisung (VERSCHMOLZEN)
    int i = 0; int k = 0;
    while (i < 10) { i++; }
    while (k > -10) { k--; }
    if (i != 10) { f = f + 1; }
    if (k != -10) { f = f + 2; }

    // 2) x = i++ als AUSDRUCK -- muss den ALTEN Wert liefern
    int a = 5; int b = a++;
    if (b != 5 || a != 6) { f = f + 4; }
    int c = 5; int d = c--;
    if (d != 5 || c != 4) { f = f + 8; }

    // 3) Global als Anweisung -- nicht verschmolzen, muss trotzdem stimmen
    g_zaehler = 0;
    int n = 0;
    while (n < 7) { g_zaehler++; n++; }
    if (g_zaehler != 7) { f = f + 16; }

    // 4) watch-Global: written() muss weiter anschlagen
    snapshot(g_beob);
    g_beob++;
    if (written(g_beob) == 0) { f = f + 32; }

    // 5) float++ -- darf NICHT als Ganzzahl addiert werden
    float x = 1.0;
    x++;
    if (x < 1.99 || x > 2.01) { f = f + 64; }

    // 6) Arrayelement -- ⚠️ `feld[3]++` uebersetzt TinyC GAR NICHT
    // ("Cannot store to non-identifier"), das ist eine alte Grenze des
    // Compilers und unabhaengig vom Peephole. Ersatzweise die lange Form.
    feld[3] = 41;
    feld[3] = feld[3] + 1;
    if (feld[3] != 42) { f = f + 128; }

    // 7) in einer for-Schleife
    int s = 0; int j;
    for (j = 0; j < 5; j++) { s = s + j; }
    if (s != 10) { f = f + 256; }

    // ── LK_OP_ST / LL_OP_ST: x = y OP z bzw. x = y OP konst ──
    // 8) alle Operatoren gegen die unverschmolzene Erwartung
    int p = 17; int q = 5; int r;
    r = p + q;  if (r != 22)  { f = f + 512; }
    r = p - q;  if (r != 12)  { f = f + 512; }
    r = p * q;  if (r != 85)  { f = f + 512; }
    r = p / q;  if (r != 3)   { f = f + 512; }
    r = p % q;  if (r != 2)   { f = f + 512; }
    r = p & q;  if (r != 1)   { f = f + 512; }
    r = p | q;  if (r != 21)  { f = f + 512; }
    r = p ^ q;  if (r != 20)  { f = f + 512; }
    r = p << 2; if (r != 68)  { f = f + 512; }
    r = p >> 2; if (r != 4)   { f = f + 512; }

    // 9) negative Konstante -- der i8-Operand ist vorzeichenbehaftet
    r = p + -8;  if (r != 9)  { f = f + 1024; }
    r = p * -2;  if (r != -34) { f = f + 1024; }

    // 10) Ziel IST eine Quelle (darf nicht zu frueh ueberschrieben werden)
    int z = 9; z = z * 3; if (z != 27) { f = f + 2048; }
    int w = 4; w = w - w; if (w != 0)  { f = f + 2048; }

    // 11) Division durch Null muss weiterhin ein Laufzeitfehler sein, KEIN
    // stiller Nullwert -- deshalb hier nur der Nicht-Null-Fall geprueft.
    int nen = 3; r = p / nen; if (r != 5) { f = f + 4096; }

    // 12) float darf NICHT verschmolzen werden
    float fa = 7.5; float fb = 2.0; float fr = fa / fb;
    if (fr < 3.74 || fr > 3.76) { f = f + 8192; }

    // 13) Konstante ausserhalb i8 -- faellt auf die lange Form zurueck
    int big; big = p * 1000; if (big != 17000) { f = f + 16384; }

    // ── Schleifenkopf (LL_CMP_JZ / LK32_CMP_JZ) und #define-Konstanten ──
    // 14) alle sechs Vergleiche als Schleifenkopf, gegen Konstante und Variable
    int cnt = 0; int m = 0;
    while (m < 5)  { cnt = cnt + 1; m++; }        if (cnt != 5) { f = f + 32768; }
    cnt = 0; m = 0;
    while (m != 4) { cnt = cnt + 1; m++; }        if (cnt != 4) { f = f + 32768; }
    cnt = 0; m = 6;
    while (m > 2)  { cnt = cnt + 1; m--; }        if (cnt != 4) { f = f + 32768; }
    cnt = 0; m = 0;  int gr = 3;
    while (m <= gr) { cnt = cnt + 1; m++; }       if (cnt != 4) { f = f + 32768; }

    // 15) ⚠️ #define-Konstante MUSS genauso verschmelzen wie ein Literal --
    // ein #define-Name ist im Baum ein Identifier, kein IntLiteral, und der
    // erste Anlauf hat ihn deshalb stillschweigend uebergangen.
    cnt = 0; m = 0;
    while (m < GRENZE) { cnt = cnt + 1; m++; }    if (cnt != 6) { f = f + 65536; }
    int viel; viel = m * WEIT;                    if (viel != 6000) { f = f + 65536; }

    // 16) eine lokale Variable gleichen Namens ueberdeckt das #define
    int GRENZE = 2; cnt = 0; m = 0;
    while (m < GRENZE) { cnt = cnt + 1; m++; }    if (cnt != 2) { f = f + 131072; }

    // 17) if() nutzt denselben Schleifenkopf-Opcode
    int ja = 0; int w1 = 5; int w2 = 9;
    if (w1 < w2) { ja = 1; }                      if (ja != 1) { f = f + 262144; }
    if (w1 > w2) { ja = 2; }                      if (ja != 1) { f = f + 262144; }

    if (f == 0) { addLog("INCTEST: alle 17 Faelle OK"); }
    else        { addLog("INCTEST: FEHLER Maske=%d", f); }
    return 0;
}
