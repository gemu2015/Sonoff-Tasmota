// @name: VarioLab over TCP
// usb_variolab_tcp.tc — bridges a TCP port to an FTDI on the USB host.
//
// WHY: the VarioLab has its FTDI soldered in, with no way to reach the UART
// before it. The only way in is for the ESP32 to BE a USB host. uVariotest then
// opens the device as if it were a local serial port: it connects to <ip>:2000
// and speaks raw bytes — no framing, no handshake.
//
//     uVariotest26  --TCP 2000-->  ESP32-S3  --USB host-->  FT232R --> VarioLab
//
// NEEDS an S3 (or S2) built with USE_TINYC_USBSERIAL, device on the OTG socket.
// ⚠️ The host must supply VBUS. If nothing enumerates, measure that first.
//
// The pump runs in TaskLoop() — its OWN FreeRTOS task, so 23 kB/s never fights
// Tasmota's main loop for time.
//
// Console: TCUS — state and throughput.

#define PORT   2000        // what uVariotest expects by default
#define BAUD   230400      // VarioLab, 8N1

int b[1024];               // one int32 per byte, like the SPP family.
                           // 1024 and not 256: at 23 kB/s that is 90 round
                           // trips per second instead of 360, and the ring
                           // is drained in one go after any hiccup.
int offen = 0;

// ── For the status rows on Tasmota's main page ──────────────────────────
int letzter_verkehr = 0;   // millis() when bytes last moved either way
int w_rx = 0;              // counter readings at the last WebCall,
int w_tx = 0;              // so the rate is the CHANGE since then
int w_ms = 0;
int w_ein = 0;             // bytes per second, device -> PC
int w_aus = 0;             // bytes per second, PC -> device

int main() {
    usbInit();             // host up; the FTDI may be plugged in at any time
    tcpServer(PORT);
    addCommand("TCUS");
    addLog("VarioLab bridge ready — TCP 2000, waiting for the FTDI");
    return 0;
}

void TaskLoop() {
    int n;
    int etwas = 0;

    // 1) Open as soon as something is there, and again after unplugging.
    int z = usbState();
    if (z == 2 && offen == 0) {
        if (usbOpen(BAUD) == 1) {
            offen = 1;
            char m[72];
            sprintf(m, "VarioLab: %x:%x open, %d baud", usbInfo(0), usbInfo(1), BAUD);
            addLog(m);
        }
    }
    if (z < 2) { offen = 0; }

    // 2) TCP -> USB
    n = tcpAvailable();
    if (n > 0) {
        n = tcpReadArray(b);
        if (n > 0) {
            etwas = 1;
            if (offen == 1) { usbWrite(b, n); }
        }
    }

    // 3) USB -> TCP
    if (offen == 1) {
        n = usbAvailable();
        while (n > 0) {
            n = usbRead(b, 1024);
            if (n <= 0) { break; }
            tcpWriteArray(b, n, 0);   // 0 = raw bytes; 1 would be uint16!
            etwas = 1;
            n = usbAvailable();
        }
    }

    if (etwas == 1) { letzter_verkehr = millis(); }

    // Idle: give the rest of the system room. With traffic, keep spinning.
    if (etwas == 0) { delay(2); }
}

void Command(char cmd[]) {
    char m[110];
    sprintf(m, "usb state %d, open %d, rx %d, tx %d, lost %d",
            usbState(), offen, usbInfo(2), usbInfo(3), usbInfo(4));
    responseCmnd(m);
}

// ─── Status on Tasmota's main page ──────────────────────────────────────
//
// WebCall() is Tasmota's FUNC_WEB_SENSOR: it runs about once a second, but
// ONLY while somebody has the main page open. That makes it the right place
// to work out the throughput as well — the bridge keeps running totals in
// usbInfo(2) and usbInfo(3), and all we need is how much they moved since
// the last call.
//
// ⚠️ Whoever reads this page is usually asking one of two questions: "is the
// device even there?" and "is anything happening?". The rows are ordered to
// answer them in that order, and the second is the reason the throughput is
// here at all — a totals counter alone cannot tell a live link from a dead
// one that carried a lot of traffic this morning.
void WebCall() {
    char m[200];
    int z = usbState();
    int rx = usbInfo(2);
    int tx = usbInfo(3);

    // ── Throughput from the change since the last call ──────────────────
    // ⚠️ Guard both ends: a page opened after a long pause gives a huge dt
    // (and `delta * 1000` could overflow int32), and a counter that wrapped
    // gives a negative delta. Both cases just re-arm instead of printing a
    // nonsense rate.
    int dt = millis() - w_ms;
    if (dt >= 500) {
        int d_ein = rx - w_rx;
        int d_aus = tx - w_tx;
        if (dt > 5000 || d_ein < 0 || d_aus < 0) {
            w_ein = 0;
            w_aus = 0;
        } else {
            w_ein = d_ein * 1000 / dt;
            w_aus = d_aus * 1000 / dt;
        }
        w_rx = rx;
        w_tx = tx;
        w_ms = millis();
    }

    // ── 1. Is the device there? ─────────────────────────────────────────
    if (z == 3) {
        sprintf(m, "{s}VarioLab{m}<b style='color:#0a0'>offen</b>"
                   " &middot; %04x:%04x &middot; %d Bd{e}",
                usbInfo(0), usbInfo(1), BAUD);
    } else if (z == 2) {
        sprintf(m, "{s}VarioLab{m}<b style='color:#d80'>erkannt</b>"
                   " &middot; %04x:%04x &middot; noch nicht ge&ouml;ffnet{e}",
                usbInfo(0), usbInfo(1));
    } else if (z == 1) {
        // ⚠️ Feste Texte gehen direkt an webSend: sprintf will mindestens
        // einen Wert sehen, sonst uebersetzt es gar nicht.
        strcpy(m, "{s}VarioLab{m}<b style='color:#888'>kein Ger&auml;t</b> an der OTG-Buchse{e}");
    } else if (z == 4) {
        strcpy(m, "{s}VarioLab{m}<b style='color:#c00'>Fehler</b> beim &Ouml;ffnen{e}");
    } else {
        strcpy(m, "{s}VarioLab{m}<b style='color:#c00'>USB-Host nicht angemeldet</b>{e}");
    }
    webSend(m);

    // ── 2. Is anything happening? ───────────────────────────────────────
    // ⚠️ Silence is shown in SECONDS, not as "nothing". Ein Strom, der vor
    // zwei Sekunden abriss, sieht sonst aus wie einer, der nie lief.
    int still = millis() - letzter_verkehr;
    if (letzter_verkehr == 0) {
        strcpy(m, "{s}Datenstrom{m}<span style='color:#888'>noch nichts geflossen</span>{e}");
    } else if (still > 3000) {
        sprintf(m, "{s}Datenstrom{m}<span style='color:#888'>still seit %d s</span>{e}", still / 1000);
    } else {
        sprintf(m, "{s}Datenstrom{m}%d B/s &larr; Ger&auml;t"
                   " &middot; %d B/s &rarr; Ger&auml;t{e}", w_ein, w_aus);
    }
    webSend(m);

    // ── 3. What has gone through in total ───────────────────────────────
    sprintf(m, "{s}&Uuml;bertragen{m}%d B empfangen &middot; %d B gesendet{e}",
            rx, tx);
    webSend(m);

    // ── 4. Losses, and only then ────────────────────────────────────────
    // ⚠️ A row that is always there gets read as decoration. This one shows
    // up only when something IS lost -- and then it means a shifted frame,
    // not a missing value, so it is worth the red.
    if (usbInfo(4) > 0) {
        sprintf(m, "{s}Verloren{m}<b style='color:#c00'>%d B</b> &mdash; der Ring lief &uuml;ber{e}", usbInfo(4));
        webSend(m);
    }
}
