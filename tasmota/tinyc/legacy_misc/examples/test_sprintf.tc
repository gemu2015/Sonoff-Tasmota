// Variadic sprintf test

void main() {
  char buf[128];
  char name[] = "TinyC";
  int a = 42;
  int b = 100;
  float x = 3.14;
  float y = -1.5;

  // 1: two ints
  sprintf(buf, "%d + %d = %d", a, 8, a + 8);
  print(buf);

  // 2: int + float
  sprintf(buf, "int=%d float=%.2f", a, x);
  print(buf);

  // 3: two floats
  sprintf(buf, "x=%.2f y=%.2f", x, y);
  print(buf);

  // 4: int + str
  sprintf(buf, "count=%d name=%s", a, name);
  print(buf);

  // 5: three ints with trailing text
  sprintf(buf, "a=%d b=%d sum=%d ok", a, b, a + b);
  print(buf);

  // 6: float + int + str
  sprintf(buf, "%.1f degC / %d%% / %s", x, a, name);
  print(buf);
}
