; Built-in emulator profile: t510 (T510 (OBIS IEC 62056-21, 300-9600 baud auto))
; Generated from sml_emulator.html buildMeterDefContent().
; This is the same descriptor the emulator emits when "T510 (OBIS IEC 62056-21, 300-9600 baud auto)"
; is selected in built-in mode. Provided here so repo mode users
; can pick the same variant without flipping back to built-in.
>M 1
+1,4,o,0,9600,T510,5
1,0.0.0(@1,Zaehler,,Meter_number,0
1,0.9.1(@#),Zeitstempel,Uhr,Timestamp,0
1,1.8.0(@1,Zaehlerstand,kWh,Total_in,3
1,21.7.0(@0.001,Leistung L1,W,Power_L1,0
1,41.7.0(@0.001,Leistung L2,W,Power_L2,0
1,61.7.0(@0.001,Leistung L3,W,Power_L3,0
1,=m 4+5+6 @1,Leistung,W,Power_total,0
1,31.7.0(@1,Strom L1,A,Current_L1,2
1,51.7.0(@1,Strom L2,A,Current_L2,2
1,71.7.0(@1,Strom L3,A,Current_L3,2
#

>F
lnv0+=1
switch lnv0
case 6
sml(1 0 300)
sml(1 1 "2F3F210D0A")
case 18
sml(1 1 "063035300D0A")
case 20
sml(1 0 9600)
case 50
lnv0=0
ends
